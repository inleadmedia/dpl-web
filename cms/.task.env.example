# Copy to cms/.task.env (gitignored). Loaded by Taskfile.yaml and dev-scripts/composer-github-auth.sh.
#
# GitHub PAT with read access to private inleadmedia/* Composer VCS repos (e.g. easyemail).
# Staging/production: create this file ONCE on the server (rsync does not deploy it).
# Jenkins: export COMPOSER_GITHUB_TOKEN before task drupal:update, or write this file via SSH.
COMPOSER_GITHUB_TOKEN=

# Optional Go deploy overrides (see task go:deploy:plan):
# GO_DEPLOY_PORT=3001
# GO_PM2_APP_NAME=dpl-go
# SKIP_GO_DEPLOY=true
# SKIP_LANGUAGE_IMPORT=true
