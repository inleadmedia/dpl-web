{% set publication_date = node.created.value %}

{% if node.field_publication_date.value is not empty %}
  {% set publication_date = node.field_publication_date.value|date('U') %}
{% endif %}

{% if node.bundle != 'page' %}
  {% set date_tag = publication_date|format_date('date_full_month') %}
{% endif %}

{% if node.bundle == 'article' %}
  {% set category_tag = content.field_categories.0 %}
{% endif %}

{% set teaser_plain = '' %}
{% if node.field_teaser_text.value is not empty %}
  {% set teaser_plain = node.field_teaser_text.value %}
{% elseif node.field_subtitle.value is not empty %}
  {% set teaser_plain = node.field_subtitle.value %}
{% endif %}

{{ include('@eonext_kultur/components/card.html.twig', {
  attributes: attributes,
  media: content.field_teaser_image,
  variant: 'x-large',
  has_media: (content.field_teaser_image.0),
  teaser_text: teaser_plain,
  type_tag: category_tag|default(node.type.entity.label()),
  date_tag: date_tag,
  title: label,
  url: url,
  baseIconPath: baseIconPath,
}, false) }}
