{% set teaser_plain = '' %}
{% if eventseries.field_teaser_text.value is not empty %}
  {% set teaser_plain = eventseries.field_teaser_text.value %}
{% elseif eventseries.field_description.value is not empty %}
  {% set teaser_plain = eventseries.field_description.value %}
{% endif %}

{{ include('@eonext_kultur/components/card.html.twig', {
  attributes: attributes,
  media: content.field_teaser_image,
  variant: 'x-large',
  has_media: (content.field_teaser_image.0),
  teaser_text: teaser_plain,
  type_tag: 'Event'|trans,
  date_tag: formatted_date,
  title: content.title,
  url: eventseries|entity_url.toString(),
  baseIconPath: baseIconPath,
}, false) }}
