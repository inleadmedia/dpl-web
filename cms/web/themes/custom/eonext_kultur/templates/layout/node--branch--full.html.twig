<article{{ attributes.addClass('ek-branch-full') }}>
  {% set hero_items = [
    {
      label: 'Address'|trans,
      values: [content.field_address_gsearch.0 ? content.field_address_gsearch : null],
    },
    {
      label: 'Email'|trans,
      values: [content.field_email.0 ? content.field_email : null],
    },
    {
      label: 'Phone'|trans,
      values: [content.field_phone.0 ? content.field_phone : null],
    },
  ] %}

  {{ include('@novel/components/hero.html.twig', {
    attributes: create_attribute(),
    title: label,
    teaser_text: content.field_teaser_text.0,
    media: content.field_main_media.0,
    items: hero_items,
    baseIconPath: baseIconPath,
  }, false) }}

  {{ content.field_paragraphs }}

  {% if branch_has_upcoming_events %}
    <section class="ek-branch-events" aria-labelledby="ek-branch-events-heading">
      <div class="ek-branch-events__inner">
        <h2 id="ek-branch-events-heading" class="ek-branch-events__heading">
          {{ 'Kommende arrangementer'|t({}, {'context': 'eonext_kultur_branches'}) }}
        </h2>
        <div class="ek-branch-events__grid">
          {% for event in branch_upcoming_events %}
            {{ event }}
          {% endfor %}
        </div>
        {% if branch_events_calendar_url %}
          <a class="ek-branch-events__more" href="{{ branch_events_calendar_url }}">
            {{ 'Se alle arrangementer'|t({}, {'context': 'eonext_kultur_branches'}) }}
          </a>
        {% endif %}
      </div>
    </section>
  {% endif %}
</article>
