<article{{ attributes.addClass('ek-content-page') }}>
  {% set title = content.field_hero_title.0|default(label) %}
  {% if is_front_page|default(false) %}
    <h1 class="hide-visually">{{ title }}</h1>
  {% elseif show_visible_page_title|default(true) %}
    {{ include('@eonext_kultur/components/ek-page-title-band.html.twig', {
      title: title,
      intro: content.field_subtitle.0 ? content.field_subtitle : null,
    }, with_context = false) }}
  {% else %}
    {# Page hero paragraph shows the visible H1. #}
    <h1 class="hide-visually">{{ title }}</h1>
  {% endif %}

  {{ content.field_paragraphs }}
  {% if (content.field_tags.0) %}
    <div class="page__tags">
      {{ content.field_tags }}
    </div>
  {% endif %}
</article>
