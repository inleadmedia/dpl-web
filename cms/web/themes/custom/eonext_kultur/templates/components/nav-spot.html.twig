{%
  set classes = [
    'nav-spot',
    'ek-nav-spot',
    style ? 'ek-nav-spot--' ~ style,
    image_alignment|default('left') == 'right' ? 'nav-spot--image-right',
    has_media ? 'nav-spot--has-media' : 'nav-spot--has-no-media',
  ]
%}

<article{{ attributes.addClass(classes).setAttribute('data-variant', variant|default('')) }}{% if background_color|default('') %} style="background-color: {{ background_color }};"{% endif %}>
  <div class="nav-spot__content">
    <div class="nav-spot__text">
      <h2 class="nav-spot__title">{{ title }}</h2>

      {% if style == 'notification' and body %}
        <div class="nav-spot__body">{{ body }}</div>
      {% elseif subtitle %}
        <p class="nav-spot__subtitle">{{ subtitle }}</p>
      {% endif %}

      {% if button_label %}
        <div class="nav-spot__button">
          <a href="{{ url }}" class="nav-spot__button-link btn-primary btn-filled">{{ button_label }}</a>
        </div>
      {% endif %}
    </div>

    {% if has_media %}
      <figure class="nav-spot__media">
        {{ include('@novel/components/media-container.html.twig', {
          attributes: create_attribute(),
          media: media,
          has_media: has_media,
          placeholder_text: placeholder_text,
        }, false) }}
      </figure>
    {% endif %}
  </div>
</article>
