{%
  set classes = [
    'nav-spots',
    'ek-nav-spots',
    'nav-spots--count-' ~ items|length,
    'ek-nav-spots--' ~ display_mode|default('notification'),
    full_width ? 'ek-nav-spots--full-width',
  ]
%}

<div {{ attributes.addClass(classes) }}>
  <div class="nav-spots__items">
    {% for item in items %}
      <div class="nav-spots__item">
        {{- item.content|default(item) -}}
      </div>
    {% endfor %}
  </div>
</div>
