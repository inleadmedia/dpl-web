<section {{ (has_locale_listing|default(false) or has_page_hero|default(false)) ? attributes : attributes.addClass('paragraphs') }}>
  {% if page_hero %}
    {{ page_hero }}
  {% endif %}
  {% if locale_listing_hero %}
    {{ locale_listing_hero }}
  {% endif %}
  {% for item in items %}
    {% if item.page_hero|default(false) %}
    {% elseif item.locale_listing|default(false) %}
      {{ item.content }}
    {% else %}
      <div {{ item.attributes }}>
        {{ item.content }}
      </div>
    {% endif %}
  {% endfor %}
</section>
