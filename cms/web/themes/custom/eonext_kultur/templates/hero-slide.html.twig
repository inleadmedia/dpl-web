<article class="ek-hero-slide">
  <div class="ek-hero-slide__image">
    {% if image %}
      <div class="ek-hero-slide__media">
        {{ image }}
      </div>
    {% endif %}

    <div class="ek-hero-slide__overlay{% if url %} ek-hero-slide__overlay--linked arrow__hover--right-small{% endif %}">
      <div class="ek-hero-slide__content">
        <p class="ek-hero-slide__meta-line">
          {% if category %}
            <span class="ek-hero-slide__category"{% if category|length > 12 %} title="{{ category }}"{% endif %}>{{ category }}</span>
          {% endif %}
          {% if date_display %}
            <span class="ek-hero-slide__meta-schedule">
              {% if category %}
                <span class="ek-hero-slide__meta-separator" aria-hidden="true">|</span>
              {% endif %}
              <time class="ek-hero-slide__date" datetime="{{ date_iso|default(date_display) }}">{{ date_display }}</time>
            </span>
          {% endif %}
        </p>
        <div class="ek-hero-slide__body">
          <h2 class="ek-hero-slide__title text-header-h2">{{ title }}</h2>
          {% if tagline %}
            <p class="ek-hero-slide__tagline text-body-large">{{ tagline }}</p>
          {% endif %}
        </div>
      </div>

      {% if url %}
        <span class="ek-hero-slide__cta" aria-hidden="true">
          <svg width="61" height="9" viewBox="0 0 61 9" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path class="arrow__body" d="M60 4.5H0" stroke="black"></path>
            <path class="arrow__head" d="M60.3537 4.85355C60.5489 4.65829 60.5489 4.34171 60.3537 4.14645L57.1717 0.96447C56.9764 0.769208 56.6598 0.769208 56.4646 0.96447C56.2693 1.15973 56.2693 1.47631 56.4646 1.67157L59.293 4.5L56.4646 7.32843C56.2693 7.52369 56.2693 7.84027 56.4646 8.03553C56.6598 8.2308 56.9764 8.2308 57.1717 8.03553L60.3537 4.85355ZM60.0001 4H57.0001V5H60.0001V4Z" fill="black"></path>
          </svg>
        </span>
        <a class="ek-hero-slide__link swiper-no-swiping" href="{{ url }}">
          <span class="visually-hidden">{{ 'See more about @title'|t({'@title': title}, {context: 'Global'}) }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</article>
