<?php

/**
 * @file
 * EO NEXT Kultur subtheme hooks.
 */

declare(strict_types=1);

use Drupal\eonext_kultur_main\NavSpotSettings;

/**
 * Implements hook_preprocess_HOOK() for page.
 */
function eonext_kultur_preprocess_page(array &$variables): void {
  // dpl_footer only provides this for the novel theme directly.
  $variables['footer_settings'] = \Drupal::state()->get('dpl_footer_values') ?? [];
  $variables['#cache']['tags'][] = 'dpl_footer';

  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();
  $logo_title = theme_get_setting('logo_title') ?? 'Korsør Kulturhus';
  $logo_src = base_path() . $theme_path . '/assets/images/logo.png';
  $footer_logo_src = base_path() . $theme_path . '/assets/images/logo-white.png';

  $variables['logo'] = [
    '#theme' => 'novel_logo',
    '#title' => $logo_title,
    '#place' => theme_get_setting('logo_place') ?? '',
    '#logo_img_enable' => 1,
    '#image' => [
      '#type' => 'html_tag',
      '#tag' => 'img',
      '#attributes' => [
        'src' => $logo_src,
        'alt' => $logo_title,
        'class' => ['ek-logo'],
      ],
    ],
  ];

  $variables['footer_logo'] = [
    '#type' => 'html_tag',
    '#tag' => 'img',
    '#attributes' => [
      'src' => $footer_logo_src,
      'alt' => $logo_title,
      'class' => ['ek-footer__logo'],
    ],
  ];
}

/**
 * Applies nav spot settings from the parent paragraph render element.
 *
 * @param mixed[] $variables
 *   Theme variables for a nav spot entity template.
 */
function _eonext_kultur_apply_nav_spot_settings(array &$variables): void {
  $element = $variables['elements'] ?? [];
  if (!empty($element['#nav_spot_button_label'])) {
    $variables['button_label'] = $element['#nav_spot_button_label'];
  }
  if (!empty($element['#nav_spot_image_alignment'])) {
    $variables['image_alignment'] = $element['#nav_spot_image_alignment'];
  }
  if (!empty($element['#nav_spot_background_color'])) {
    $variables['background_color'] = $element['#nav_spot_background_color'];
  }

  $display_mode = (string) ($element['#nav_spot_display_mode'] ?? '');
  if ($display_mode === NavSpotSettings::DISPLAY_NOTIFICATION) {
    $variables['variant'] = 'large';
    $variables['style'] = 'notification';
  }
  elseif ($display_mode === NavSpotSettings::DISPLAY_PROMO) {
    $variables['variant'] = 'promo';
    $variables['style'] = 'promo';
  }
  else {
    $background_color = trim((string) ($variables['background_color'] ?? ''));
    if ($background_color === '') {
      $variables['variant'] = 'large';
      $variables['style'] = 'notification';
    }
    else {
      $variables['variant'] = 'promo';
      $variables['style'] = 'promo';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function eonext_kultur_preprocess_node(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'nav_spot') {
    return;
  }

  _eonext_kultur_apply_nav_spot_settings($variables);
}

/**
 * Implements hook_preprocess_HOOK() for eventinstance templates.
 */
function eonext_kultur_preprocess_eventinstance(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';

  if ($view_mode === 'nav_spot') {
    _eonext_kultur_apply_nav_spot_settings($variables);
    return;
  }

  if (in_array($view_mode, ['card', 'default'], TRUE) && eonext_kultur_events_is_events_listing_page()) {
    $variables['theme_hook_suggestions'][] = 'eventinstance__card__eonext_kultur_grid';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form.
 */
function eonext_kultur_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  if (($variables['element']['#id'] ?? '') === 'views-exposed-form-events-all') {
    $suggestions[] = 'form__views_exposed_form__events__all__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for input.
 */
function eonext_kultur_theme_suggestions_input_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  if (($element['#name'] ?? '') !== 'search_api_fulltext') {
    return;
  }

  if (function_exists('eonext_kultur_events_is_events_listing_page')
    && eonext_kultur_events_is_events_listing_page()) {
    $suggestions[] = 'input__search_api_fulltext__events';
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventseries templates.
 */
function eonext_kultur_preprocess_eventseries(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'nav_spot') {
    return;
  }

  _eonext_kultur_apply_nav_spot_settings($variables);
}

/**
 * Implements hook_preprocess_HOOK() for nav_spots_manual paragraphs.
 */
function eonext_kultur_preprocess_paragraph__nav_spots_manual(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof \Drupal\paragraphs\ParagraphInterface) {
    return;
  }

  if (!NavSpotSettings::isKulturMode($paragraph)) {
    return;
  }

  $variables['#attached']['library'][] = 'eonext_kultur/nav-spot';
}
