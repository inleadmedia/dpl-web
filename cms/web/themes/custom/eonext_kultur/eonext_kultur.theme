<?php

/**
 * @file
 * EO NEXT Kultur subtheme hooks.
 */

declare(strict_types=1);

use Drupal\eonext_kultur_main\BannerSettings;
use Drupal\eonext_kultur_main\ColorContrast;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_preprocess().
 *
 * Design system icons are bundled with the base novel theme.
 */
function eonext_kultur_preprocess(array &$variables): void {
  $novel_path = \Drupal::service('extension.list.theme')->getPath('novel');
  $variables['baseIconPath'] = '/' . $novel_path . '/assets/dpl-design-system/icons';
}

/**
 * Implements hook_form_system_theme_settings_alter().
 *
 * @param array<string, mixed> $form
 *   An associative array containing the structure of the form.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 */
function eonext_kultur_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void {
  $form['identity']['settings']['placeholder_bg_mode'] = [
    '#type' => 'radios',
    '#title' => t('Media placeholder background', [], ['context' => 'EO NEXT Kultur settings']),
    '#default_value' => _eonext_kultur_placeholder_bg_mode(),
    '#options' => [
      'default' => t('Design system default (darker identity tint)', [], ['context' => 'EO NEXT Kultur settings']),
      'identity_light' => t('Lighter identity color (auto)', [], ['context' => 'EO NEXT Kultur settings']),
      'custom' => t('Custom color', [], ['context' => 'EO NEXT Kultur settings']),
    ],
    '#description' => t('Controls the background on media containers without an image.', [], ['context' => 'EO NEXT Kultur settings']),
  ];
  $form['identity']['settings']['placeholder_bg_color'] = [
    '#type' => 'color',
    '#title' => t('Custom media placeholder background', [], ['context' => 'EO NEXT Kultur settings']),
    '#default_value' => theme_get_setting('placeholder_bg_color') ?: '#ffffff',
    '#description' => t('Background color used when custom mode is selected.', [], ['context' => 'EO NEXT Kultur settings']),
    '#states' => [
      'visible' => [
        ':input[name="placeholder_bg_mode"]' => ['value' => 'custom'],
      ],
    ],
  ];
}

/**
 * Resolves the configured media placeholder background mode.
 */
function _eonext_kultur_placeholder_bg_mode(): string {
  $mode = theme_get_setting('placeholder_bg_mode');
  if (is_string($mode) && $mode !== '') {
    return $mode;
  }

  return theme_get_setting('placeholder_bg_override') ? 'custom' : 'default';
}

/**
 * Attaches placeholder background CSS to the page head.
 *
 * @param array<mixed> $variables
 *   HTML preprocess variables.
 * @param string $background_value
 *   Raw CSS background value.
 */
function _eonext_kultur_attach_placeholder_background_css(array &$variables, string $background_value): void {
  $custom_css = "
    .media-container--placeholder {
      background-color: {$background_value} !important;
    }
  ";

  $variables['#attached']['html_head'][] = [
    [
      '#type' => 'inline_template',
      '#template' => '<style type="text/css">{{ style|safe_join("") }}</style>',
      '#context' => ['style' => [$custom_css]],
    ],
    'eonext_kultur_placeholder_background',
  ];
}

/**
 * Attaches the media placeholder background override to the page.
 *
 * @param array<mixed> $variables
 *   An associative array containing the following possible keys:
 *   - '#attached': An array of attachments for rendering.
 * @param string $color
 *   Hexadecimal color value.
 */
function _eonext_kultur_attach_placeholder_background(array &$variables, string $color): void {
  if (!preg_match('/^#[0-9a-fA-F]{6}$/', $color)) {
    return;
  }

  _eonext_kultur_attach_placeholder_background_css($variables, $color);
}

/**
 * Attaches a lighter tint derived from the configured identity color.
 *
 * @param array<mixed> $variables
 *   HTML preprocess variables.
 */
function _eonext_kultur_attach_placeholder_background_identity_light(array &$variables): void {
  $identity_color = theme_get_setting('identity_color');
  if (is_string($identity_color) && ($light = _eonext_kultur_lighten_hex_color($identity_color)) !== NULL) {
    _eonext_kultur_attach_placeholder_background($variables, $light);
    return;
  }

  // Fall back to the design-system CSS variables when no identity color is set.
  _eonext_kultur_attach_placeholder_background_css(
    $variables,
    'hsl(var(--identity-color-h), var(--identity-color-s), min(calc(var(--identity-color-l) + 32%), 90%))'
  );
}

/**
 * Returns a lighter hex color mixed toward white.
 */
function _eonext_kultur_lighten_hex_color(string $color, float $mix = 0.72): ?string {
  $rgb = ColorContrast::parseColorToRgb($color);
  if ($rgb === NULL) {
    return NULL;
  }

  $mix = max(0.0, min(1.0, $mix));
  $channel = static fn(int $value): int => (int) round($value + (255 - $value) * $mix);

  return sprintf(
    '#%02x%02x%02x',
    $channel($rgb['r']),
    $channel($rgb['g']),
    $channel($rgb['b'])
  );
}

/**
 * Implements hook_preprocess_HOOK() for html.
 */
function eonext_kultur_preprocess_html(array &$variables): void {
  switch (_eonext_kultur_placeholder_bg_mode()) {
    case 'identity_light':
      _eonext_kultur_attach_placeholder_background_identity_light($variables);
      break;

    case 'custom':
      _eonext_kultur_attach_placeholder_background($variables, (string) theme_get_setting('placeholder_bg_color'));
      break;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface) {
    return;
  }

  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  if ($alias === '/frontpage') {
    $variables['attributes']['class'][] = 'page-frontpage';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.
 */
function eonext_kultur_preprocess_page(array &$variables): void {
  // dpl_footer only provides this for the novel theme directly.
  $variables['footer_settings'] = \Drupal::state()->get('dpl_footer_values') ?? [];
  $variables['#cache']['tags'][] = 'dpl_footer';

  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();
  $logo_title = theme_get_setting('logo_title') ?? 'Korsør Kulturhus';
  $logo_src = base_path() . $theme_path . '/assets/images/logo.png';
  $footer_logo_src = base_path() . $theme_path . '/assets/images/logo-white.png';

  $variables['logo'] = [
    '#theme' => 'novel_logo',
    '#title' => $logo_title,
    '#place' => theme_get_setting('logo_place') ?? '',
    '#logo_img_enable' => 1,
    '#image' => [
      '#type' => 'html_tag',
      '#tag' => 'img',
      '#attributes' => [
        'src' => $logo_src,
        'alt' => $logo_title,
        'class' => ['ek-logo'],
      ],
    ],
  ];

  $variables['footer_logo'] = [
    '#type' => 'html_tag',
    '#tag' => 'img',
    '#attributes' => [
      'src' => $footer_logo_src,
      'alt' => $logo_title,
      'class' => ['ek-footer__logo'],
    ],
  ];
}

/**
 * Applies EONEXT-321 nav teaser variables from a referenced content entity.
 *
 * @param mixed[] $variables
 *   Theme variables for a nav teaser entity template.
 */
function _eonext_kultur_apply_nav_teaser_variables(array &$variables, EntityInterface $entity): void {
  $nav_teaser = \Drupal::service('eonext_kultur_main.nav_teaser_builder')->build($entity);
  if ($nav_teaser === []) {
    return;
  }

  $element = $variables['elements'] ?? [];

  $variables['nav_teaser_title'] = $nav_teaser['title'] ?? '';
  $variables['nav_teaser_subtitle'] = $nav_teaser['subtitle'] ?? '';
  $variables['nav_teaser_teaser_text'] = $nav_teaser['teaser_text'] ?? '';
  $variables['nav_teaser_background_image_url'] = $nav_teaser['background_image_url'] ?? '';
  if (!empty($nav_teaser['url'])) {
    $variables['nav_teaser_url'] = $nav_teaser['url'];
  }

  if (!empty($element['#nav_teaser_overlay_background_color'])) {
    $overlay_color = (string) $element['#nav_teaser_overlay_background_color'];
    $variables['nav_teaser_overlay_background_color'] = $overlay_color;
    $variables['nav_teaser_overlay_background_rgba'] = ColorContrast::toNavTeaserOverlayRgba($overlay_color);
    $variables['light_background'] = ColorContrast::isLightNavTeaserBackground($overlay_color);
  }
}

/**
 * Implements hook_preprocess_HOOK() for banner paragraphs.
 */
function eonext_kultur_preprocess_paragraph__banner(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }

  if (BannerSettings::hasBackgroundImage($paragraph)) {
    return;
  }

  $background_color = BannerSettings::getBackgroundColor($paragraph);
  if ($background_color !== '') {
    $variables['banner_background_color'] = $background_color;
  }

  $variables['banner_light_background'] = BannerSettings::isLightBackground($paragraph);
}

/**
 * Applies nav spot settings from the parent paragraph render element.
 *
 * @param mixed[] $variables
 *   Theme variables for a nav spot entity template.
 */
function _eonext_kultur_apply_nav_spot_settings(array &$variables): void {
  $element = $variables['elements'] ?? [];
  if (!empty($element['#nav_spot_button_label'])) {
    $variables['button_label'] = $element['#nav_spot_button_label'];
  }
  if (!empty($element['#nav_spot_image_alignment'])) {
    $variables['image_alignment'] = $element['#nav_spot_image_alignment'];
  }
  if (!empty($element['#nav_spot_background_color'])) {
    $background_color = (string) $element['#nav_spot_background_color'];
    $variables['background_color'] = $background_color;
    $variables['light_background'] = ColorContrast::isLightNavSpotBackground($background_color);
  }
  else {
    // Large nav spots default to white in design-system CSS when no color is set.
    $variables['light_background'] = TRUE;
  }

  $variables['variant'] = 'large';
}

/**
 * Sets plain-text subtitle for nav spot entity templates.
 *
 * @param mixed[] $variables
 *   Theme variables for a nav spot entity template.
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The referenced content entity.
 */
function _eonext_kultur_set_nav_spot_subtitle(array &$variables, \Drupal\Core\Entity\EntityInterface $entity): void {
  if ($entity->hasField('field_subtitle') && !$entity->get('field_subtitle')->isEmpty()) {
    $variables['nav_spot_subtitle'] = (string) $entity->get('field_subtitle')->value;
    return;
  }

  if ($entity->hasField('field_teaser_text') && !$entity->get('field_teaser_text')->isEmpty()) {
    $value = $entity->get('field_teaser_text')->value ?? '';
    if (is_string($value)) {
      $text = trim(strip_tags($value));
      if ($text !== '') {
        $variables['nav_spot_subtitle'] = $text;
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function eonext_kultur_preprocess_node(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';

  if ($view_mode === 'nav_teaser' && isset($variables['node'])) {
    _eonext_kultur_apply_nav_teaser_variables($variables, $variables['node']);
    return;
  }

  if ($view_mode !== 'nav_spot') {
    return;
  }

  _eonext_kultur_apply_nav_spot_settings($variables);
  if (isset($variables['node'])) {
    _eonext_kultur_set_nav_spot_subtitle($variables, $variables['node']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventinstance templates.
 */
function eonext_kultur_preprocess_eventinstance(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';

  if ($view_mode === 'nav_teaser') {
    if (isset($variables['eventinstance'])) {
      _eonext_kultur_apply_nav_teaser_variables($variables, $variables['eventinstance']);
    }
    return;
  }

  if ($view_mode === 'nav_spot') {
    _eonext_kultur_apply_nav_spot_settings($variables);
    return;
  }

  if (in_array($view_mode, ['card', 'default'], TRUE) && eonext_kultur_events_is_events_listing_page()) {
    $variables['theme_hook_suggestions'][] = 'eventinstance__card__eonext_kultur_grid';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form.
 */
function eonext_kultur_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  if (($variables['element']['#id'] ?? '') === 'views-exposed-form-events-all') {
    $suggestions[] = 'form__views_exposed_form__events__all__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for input.
 */
function eonext_kultur_theme_suggestions_input_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  if (($element['#name'] ?? '') !== 'search_api_fulltext') {
    return;
  }

  if (function_exists('eonext_kultur_events_is_events_listing_page')
    && eonext_kultur_events_is_events_listing_page()) {
    $suggestions[] = 'input__search_api_fulltext__events';
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.
 */
function eonext_kultur_preprocess_field(array &$variables): void {
  if (($variables['field_name'] ?? '') !== 'field_paragraphs') {
    return;
  }

  foreach ($variables['items'] as &$item) {
    $theme = $item['content']['#theme'] ?? '';

    if ($theme === 'eonext_kultur_page_hero') {
      $variables['page_hero'] = $item['content'];
      $variables['has_page_hero'] = TRUE;
      $item['page_hero'] = TRUE;
      $item['content'] = [
        '#paragraph' => $item['content']['#paragraph'] ?? NULL,
        '#access' => FALSE,
      ];
      continue;
    }

    if ($theme !== 'eonext_kultur_locale_listing') {
      continue;
    }

    $item['locale_listing'] = TRUE;
    $variables['has_locale_listing'] = TRUE;

    if (empty($item['content']['#hero_image'])) {
      continue;
    }

    // Render hero before other paragraphs (e.g. intro text) on the same page.
    $variables['locale_listing_hero'] = [
      '#theme' => 'eonext_kultur_locale_listing_hero',
      '#hero_image' => $item['content']['#hero_image'],
      '#heading' => $item['content']['#heading'],
      '#attached' => $item['content']['#attached'] ?? [],
    ];
    $item['content']['#hero_image'] = NULL;
    $item['content']['#heading'] = NULL;
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventseries templates.
 */
function eonext_kultur_preprocess_eventseries(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';

  if ($view_mode === 'nav_teaser' && isset($variables['eventseries'])) {
    _eonext_kultur_apply_nav_teaser_variables($variables, $variables['eventseries']);
    return;
  }

  if ($view_mode !== 'nav_spot') {
    return;
  }

  _eonext_kultur_apply_nav_spot_settings($variables);
  if (isset($variables['eventseries'])) {
    _eonext_kultur_set_nav_spot_subtitle($variables, $variables['eventseries']);
  }
}
