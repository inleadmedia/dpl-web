<?php

/**
 * @file
 * Primary module hooks for EO Next Editorial Search module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\dpl_search\DplSearchSettings;
use Drupal\node\NodeInterface;
use Drupal\recurring_events\Entity\EventSeries;
use Drupal\search_api\Plugin\views\query\SearchApiQuery;
use Drupal\eonext_editorial_search\EonextEditorialSearchTaxonomyContext;
use Drupal\views\ViewExecutable;

const EONEXT_EDITORIAL_SEARCH_SHOW_PAST_EVENTS_KEY = 'show_past_events';

function eonext_editorial_search_show_past_events(): bool {
  $value = \Drupal::request()->query->get(EONEXT_EDITORIAL_SEARCH_SHOW_PAST_EVENTS_KEY);

  return $value === '1' || $value === 1 || $value === TRUE;
}

const EONEXT_EDITORIAL_SEARCH_FACET_SOURCE_ID = 'search_api:views_page__editorial_search__page';

/**
 * Request attribute: editorial search view is executing in this request.
 */
const EONEXT_EDITORIAL_SEARCH_ACTIVE_REQUEST_ATTRIBUTE = 'eonext_editorial_search.active_view';

const EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID = 'grid';

const EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_LIST = 'list';

/**
 * Returns the configured editorial search results layout.
 */
function eonext_editorial_search_get_results_display(): string {
  $display = \Drupal::config('eonext_editorial_search.settings')->get('results_display');

  return in_array($display, [
    EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID,
    EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_LIST,
  ], TRUE) ? $display : EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID;
}

/**
 * Returns the entity view mode used for editorial search result rows.
 */
function eonext_editorial_search_get_results_view_mode(): string {
  return eonext_editorial_search_get_results_display() === EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID
    ? 'card'
    : 'list_teaser';
}

/**
 * Returns Search API row view mode mappings for editorial search.
 *
 * @return array<string, array<string, string>>
 *   View mode mappings keyed by entity type.
 */
function eonext_editorial_search_get_results_view_modes(): array {
  $view_mode = eonext_editorial_search_get_results_view_mode();

  return [
    'entity:eventseries' => [
      ':default' => $view_mode,
      'default' => $view_mode,
    ],
    'entity:node' => [
      ':default' => $view_mode,
      'article' => $view_mode,
      'go_category' => $view_mode,
      'go_page' => $view_mode,
      'page' => $view_mode,
    ],
  ];
}

/**
 * Applies the configured results layout to an editorial search view display.
 */
function eonext_editorial_search_apply_results_display_to_view(ViewExecutable $view, ?string $display_id = NULL): void {
  $handler = $display_id !== NULL
    ? $view->displayHandlers->get($display_id)
    : $view->getDisplay();
  if ($handler === NULL) {
    return;
  }

  $row = $handler->getOption('row');
  if (($row['type'] ?? '') !== 'search_api') {
    return;
  }

  $view_modes = eonext_editorial_search_get_results_view_modes();
  $row['options']['view_modes'] = $view_modes;
  $handler->setOption('row', $row);

  // Row plugins can be initialized before display options are updated.
  if ($view->display_handler !== NULL) {
    $view->initStyle();
    $row_plugin = $view->display_handler->getPlugin('row');
    if ($row_plugin !== NULL) {
      $row_plugin->options['view_modes'] = $view_modes;
    }
  }
}

function eonext_editorial_search_has_matching_past_events(): bool {
  $request = \Drupal::request();
  $cached = $request->attributes->get('editorial_search.has_matching_past_events');
  if ($cached !== NULL) {
    return (bool) $cached;
  }

  $has_matching = FALSE;
  $index = \Drupal\search_api\Entity\Index::load('content_events');
  if ($index !== NULL && $index->getField('event_has_upcoming') !== NULL) {
    $query = $index->query();
    $query->addCondition('status', TRUE);
    $query->addCondition('event_has_upcoming', FALSE);
    $query->addCondition('search_api_datasource', 'entity:eventseries');

    $search = $request->query->get(DplSearchSettings::EDITORIAL_QUERY_KEY, '');
    if (is_string($search) && trim($search) !== '') {
      $query->keys(trim($search));
    }

    /** @var \Drupal\facets\FacetManager\DefaultFacetManager $facet_manager */
    $facet_manager = \Drupal::service('facets.manager');
    $facet_manager->alterQuery($query, EONEXT_EDITORIAL_SEARCH_FACET_SOURCE_ID);

    $query->range(0, 1);
    $has_matching = $query->execute()->getResultCount() > 0;
  }

  $request->attributes->set('editorial_search.has_matching_past_events', $has_matching);

  return $has_matching;
}

function eonext_editorial_search_get_hidden_facets(): array {
  $context = EonextEditorialSearchTaxonomyContext::fromRoute();
  if ($context === NULL) {
    return [];
  }

  return match ($context->field) {
    'tags' => ['editorial_tags'],
    'categories' => ['editorial_categories'],
    default => [],
  };
}

function eonext_editorial_search_get_templates_path(): string {
  return \Drupal::service('extension.list.module')->getPath('eonext_editorial_search') . '/templates';
}

/**
 * Implements hook_entity_presave().
 */
function eonext_editorial_search_entity_presave(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'article') {
    \Drupal::service('Drupal\eonext_editorial_search\ArticleMaterialSync')->syncArticle($entity);
  }
}

/**
 * Implements hook_theme().
 */
function eonext_editorial_search_theme($existing, $type, $theme, $path) {
  $templates_path = $path . '/templates';

  return [
    'views_view__editorial_search__eonext' => [
      'base hook' => 'views_view',
      'path' => $templates_path,
      'template' => 'views-view--editorial-search--eonext',
    ],
    'views_view__editorial_search__page__eonext' => [
      'base hook' => 'views_view',
      'path' => $templates_path,
      'template' => 'views-view--editorial-search--eonext',
    ],
    'facets_item_list__editorial_search__eonext' => [
      'base hook' => 'facets_item_list',
      'path' => $templates_path,
      'template' => 'facets-item-list--editorial-search--eonext',
    ],
    'block__facet_block__editorial_search__eonext' => [
      'base hook' => 'block',
      'path' => $templates_path,
      'template' => 'block--facet-block--editorial-search--eonext',
    ],
    'form__views_exposed_form__editorial_search__page__eonext' => [
      'base hook' => 'form',
      'path' => $templates_path,
      'template' => 'form--views-exposed-form--editorial-search-page--eonext',
    ],
    'views_view_unformatted__editorial_search__eonext' => [
      'base hook' => 'views_view_unformatted',
      'path' => $templates_path,
      'template' => 'views-view-unformatted--editorial-search--eonext',
    ],
    'views_view_unformatted__editorial_search__page__eonext' => [
      'base hook' => 'views_view_unformatted',
      'path' => $templates_path,
      'template' => 'views-view-unformatted--editorial-search--eonext',
    ],
  ];
}

/**
 * Implements hook_theme_registry_alter().
 */
function eonext_editorial_search_theme_registry_alter(array &$theme_registry): void {
  $templates_path = eonext_editorial_search_get_templates_path();

  $overrides = [
    'views_view__editorial_search' => 'views-view--editorial-search--eonext',
    'views_view__editorial_search__page' => 'views-view--editorial-search--eonext',
    'views_view__editorial_search__eonext' => 'views-view--editorial-search--eonext',
    'views_view__editorial_search__page__eonext' => 'views-view--editorial-search--eonext',
    'views_view_unformatted__editorial_search' => 'views-view-unformatted--editorial-search--eonext',
    'views_view_unformatted__editorial_search__page' => 'views-view-unformatted--editorial-search--eonext',
    'facets_item_list__editorial_search__eonext' => 'facets-item-list--editorial-search--eonext',
    'block__facet_block__editorial_search__eonext' => 'block--facet-block--editorial-search--eonext',
    'form__views_exposed_form__editorial_search__page__eonext' => 'form--views-exposed-form--editorial-search-page--eonext',
    'views_view_unformatted__editorial_search__eonext' => 'views-view-unformatted--editorial-search--eonext',
    'views_view_unformatted__editorial_search__page__eonext' => 'views-view-unformatted--editorial-search--eonext',
  ];

  foreach ($overrides as $hook => $template) {
    if (!isset($theme_registry[$hook])) {
      continue;
    }

    $theme_registry[$hook]['path'] = $templates_path;
    $theme_registry[$hook]['template'] = $template;
    $theme_registry[$hook]['type'] = 'module';
  }
}

function eonext_editorial_search_get_sort_field_options(): array {
  return [
    'relevance' => t('Relevance', [], ['context' => 'eonext_editorial_search']),
    'sort_date' => t('Date', [], ['context' => 'eonext_editorial_search']),
    'sort_title' => t('Title', [], ['context' => 'eonext_editorial_search']),
  ];
}

function eonext_editorial_search_get_sort_order_options(): array {
  return [
    'ASC' => t('Ascending', [], ['context' => 'eonext_editorial_search']),
    'DESC' => t('Descending', [], ['context' => 'eonext_editorial_search']),
  ];
}

function eonext_editorial_search_get_default_sort_order(string $sort_by): string {
  return match ($sort_by) {
    'sort_date' => 'DESC',
    'sort_title' => 'ASC',
    default => 'DESC',
  };
}

function eonext_editorial_search_get_selected_sort(?string $search_query = NULL): array {
  $request = \Drupal::request();
  $sort_by = $request->query->get('sort_by');
  $sort_order = $request->query->get('sort_order');

  if (!is_string($sort_by) || $sort_by === '') {
    $sort_by = 'relevance';
  }

  $sort_order = is_string($sort_order) && $sort_order !== ''
    ? strtoupper($sort_order)
    : eonext_editorial_search_get_default_sort_order($sort_by);

  return [
    'sort_by' => $sort_by,
    'sort_order' => $sort_order,
  ];
}

/**
 * Whether the editorial search view is executing in the current request.
 */
function eonext_editorial_search_is_active_view(): bool {
  return (bool) \Drupal::request()->attributes->get(EONEXT_EDITORIAL_SEARCH_ACTIVE_REQUEST_ATTRIBUTE);
}

/**
 * Implements hook_views_pre_build().
 */
function eonext_editorial_search_views_pre_build(ViewExecutable $view): void {
  if ($view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID) {
    return;
  }

  \Drupal::request()->attributes->set(EONEXT_EDITORIAL_SEARCH_ACTIVE_REQUEST_ATTRIBUTE, TRUE);
  eonext_editorial_search_apply_results_display_to_view($view);
}

/**
 * Implements hook_views_pre_view().
 */
function eonext_editorial_search_views_pre_view(ViewExecutable $view, $display_id, array &$args): void {
  if ($view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID) {
    return;
  }

  \Drupal::request()->attributes->set(EONEXT_EDITORIAL_SEARCH_ACTIVE_REQUEST_ATTRIBUTE, TRUE);
  eonext_editorial_search_apply_results_display_to_view($view, is_string($display_id) ? $display_id : NULL);
}

/**
 * Implements hook_views_pre_render().
 */
function eonext_editorial_search_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID) {
    return;
  }

  \Drupal::request()->attributes->set(EONEXT_EDITORIAL_SEARCH_ACTIVE_REQUEST_ATTRIBUTE, TRUE);
  eonext_editorial_search_apply_results_display_to_view($view);
}

/**
 * Implements hook_views_query_alter().
 */
function eonext_editorial_search_views_query_alter(ViewExecutable $view, $query): void {
  if ($view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID || $view->current_display !== 'page') {
    return;
  }

  if (!$query instanceof SearchApiQuery) {
    return;
  }

  $search_api_query = $query->getSearchApiQuery();
  if ($search_api_query === NULL) {
    return;
  }

  $input = $view->getExposedInput();
  $search_query = $input[DplSearchSettings::EDITORIAL_QUERY_KEY] ?? '';
  $selected_sort = eonext_editorial_search_get_selected_sort(is_string($search_query) ? $search_query : '');

  $sorts = &$search_api_query->getSorts();
  $sorts = [];

  $sort_field = $selected_sort['sort_by'] === 'relevance'
    ? 'search_api_relevance'
    : $selected_sort['sort_by'];

  $search_api_query->sort($sort_field, $selected_sort['sort_order']);

  if ($sort_field === 'sort_date') {
    $search_api_query->sort('sort_title', $selected_sort['sort_order']);
    $search_api_query->sort('search_api_id', 'ASC');
  }
  elseif ($sort_field === 'sort_title') {
    $search_api_query->sort('search_api_id', 'ASC');
  }

  if (EonextEditorialSearchTaxonomyContext::fromRoute() !== NULL) {
    return;
  }

  if (eonext_editorial_search_show_past_events()) {
    return;
  }

  $index = $search_api_query->getIndex();
  if ($index->getField('event_has_upcoming') === NULL) {
    return;
  }

  $condition_group = $search_api_query->createConditionGroup('OR');
  $condition_group->addCondition('event_has_upcoming', TRUE);
  $condition_group->addCondition('search_api_datasource', 'entity:node');
  $search_api_query->addConditionGroup($condition_group);
}

/**
 * Implements hook_views_post_execute().
 */
function eonext_editorial_search_views_post_execute(ViewExecutable $view): void {
  if ($view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID || $view->current_display !== 'page') {
    return;
  }

  if (eonext_editorial_search_show_past_events()) {
    return;
  }

  /** @var \Drupal\dpl_event\ReoccurringDateFormatter $formatter */
  $formatter = \Drupal::service('dpl_event.reoccurring_date_formatter');
  $removed = 0;

  foreach ($view->result as $key => $row) {
    $entity = $row->_entity ?? NULL;
    if (!($entity instanceof EventSeries)) {
      continue;
    }

    if ($formatter->getUpcomingEventDetails($entity) === NULL) {
      unset($view->result[$key]);
      $removed++;
    }
  }

  if ($removed === 0) {
    return;
  }

  $view->result = array_values($view->result);
  $view->total_rows = max(0, (int) $view->total_rows - $removed);
}

function eonext_editorial_search_get_base_icon_path(): string {
  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();
  return '/' . $theme_path . '/assets/dpl-design-system/icons';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 */
function eonext_editorial_search_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  if (($variables['view']->id() ?? '') === 'editorial_search') {
    $suggestions[] = 'views_view__editorial_search__page__eonext';
    $suggestions[] = 'views_view__editorial_search__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_unformatted.
 */
function eonext_editorial_search_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables): void {
  if (($variables['view']->id() ?? '') !== 'editorial_search') {
    return;
  }

  $suggestions[] = 'views_view_unformatted__editorial_search__eonext';
  $suggestions[] = 'views_view_unformatted__editorial_search__' . ($variables['view']->current_display ?? '') . '__eonext';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for facets_item_list.
 */
function eonext_editorial_search_theme_suggestions_facets_item_list_alter(array &$suggestions, array $variables): void {
  $facet = $variables['facet'] ?? NULL;
  if ($facet && str_starts_with($facet->id(), 'editorial_')) {
    $suggestions[] = 'facets_item_list__editorial_search__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block.
 */
function eonext_editorial_search_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $plugin_id = $variables['plugin_id'] ?? $variables['elements']['#plugin_id'] ?? '';
  if (str_starts_with((string) $plugin_id, 'facet_block:editorial_')) {
    $suggestions[] = 'block__facet_block__editorial_search__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form.
 */
function eonext_editorial_search_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $form_id = $variables['element']['#id'] ?? '';
  if ($form_id === 'views-exposed-form-editorial-search-page') {
    $suggestions[] = 'form__views_exposed_form__editorial_search__page__eonext';
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventseries.
 */
function eonext_editorial_search_preprocess_eventseries(array &$variables): void {
  if (!in_array($variables['view_mode'] ?? '', ['list_teaser', 'card'], TRUE)) {
    return;
  }

  $content = &$variables['content'];
  if (!empty($content['field_teaser_image'][0])) {
    return;
  }

  if (!empty($content['field_event_image'][0])) {
    $content['field_teaser_image'] = $content['field_event_image'];
  }
}

/**
 * Implements hook_preprocess_HOOK() for facets_item_list.
 */
function eonext_editorial_search_preprocess_facets_item_list__editorial_search__eonext(array &$variables): void {
  $variables['baseIconPath'] = eonext_editorial_search_get_base_icon_path();

  $facet = $variables['facet'] ?? NULL;
  if ($facet && $facet->id() === 'editorial_content_type') {
    $variables['editorial_search_show_past_events'] = eonext_editorial_search_show_past_events();
    $variables['editorial_search_has_matching_past_events'] = eonext_editorial_search_has_matching_past_events();
    $variables['#cache']['contexts'][] = 'url.query_args:show_past_events';
    $variables['#cache']['contexts'][] = 'url.query_args:' . DplSearchSettings::EDITORIAL_QUERY_KEY;
    $variables['#cache']['contexts'][] = 'url.query_args';
    $variables['#cache']['tags'][] = 'search_api_list:content_events';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function eonext_editorial_search_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!($view instanceof ViewExecutable) || $view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID) {
    return;
  }

  $variables['#attached']['library'][] = 'eonext_editorial_search/editorial-search';
  $variables['editorial_search_hidden_facets'] = eonext_editorial_search_get_hidden_facets();
  $variables['editorial_search_results_display'] = eonext_editorial_search_get_results_display();
  $variables['#cache']['contexts'][] = 'route';
  $variables['#cache']['tags'][] = 'config:eonext_editorial_search.settings';

  if ($view->current_display !== 'page') {
    return;
  }

  $search_query = \Drupal::request()->query->get(DplSearchSettings::EDITORIAL_QUERY_KEY, '');
  $selected_sort = eonext_editorial_search_get_selected_sort(is_string($search_query) ? $search_query : '');
  $variables['editorial_search_sort_field_options'] = eonext_editorial_search_get_sort_field_options();
  $variables['editorial_search_sort_order_options'] = eonext_editorial_search_get_sort_order_options();
  $variables['editorial_search_sort_field_selected'] = $selected_sort['sort_by'];
  $variables['editorial_search_sort_order_selected'] = $selected_sort['sort_order'];
  $variables['editorial_search_show_past_events'] = eonext_editorial_search_show_past_events();
  $variables['baseIconPath'] = eonext_editorial_search_get_base_icon_path();
  eonext_editorial_search_attach_date_filter($variables, $view);
}

/**
 * Attach the exposed date range filter render array to the view template.
 */
function eonext_editorial_search_attach_date_filter(array &$variables, ViewExecutable $view): void {
  $exposed = $variables['exposed'] ?? $view->exposed_widgets ?? NULL;
  if (!is_array($exposed) || !isset($exposed['date_wrapper'])) {
    return;
  }

  $variables['editorial_search_date_filter'] = $exposed['date_wrapper'];
  $variables['editorial_search_date_filter_expanded'] = eonext_editorial_search_date_filter_is_expanded();
  $variables['#cache']['contexts'][] = 'url.query_args:date';
}

/**
 * Whether the editorial search date filter group should start expanded.
 */
function eonext_editorial_search_date_filter_is_expanded(): bool {
  $date = \Drupal::request()->query->all()['date'] ?? NULL;

  if (!is_array($date)) {
    return FALSE;
  }

  return !empty($date['min']) || !empty($date['max']);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_unformatted.
 */
function eonext_editorial_search_preprocess_views_view_unformatted(array &$variables): void {
  if (($variables['view']->id() ?? '') !== DplSearchSettings::EDITORIAL_VIEW_ID) {
    return;
  }

  $variables['editorial_search_results_display'] = eonext_editorial_search_get_results_display();
  $variables['#cache']['tags'][] = 'config:eonext_editorial_search.settings';
}

/**
 * Implements hook_form_views_exposed_form_alter().
 */
function eonext_editorial_search_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (($form['#id'] ?? '') !== 'views-exposed-form-editorial-search-page') {
    return;
  }

  eonext_editorial_search_alter_exposed_date_fields($form);
}

/**
 * Applies editorial labels and styling to exposed date min/max fields.
 */
function eonext_editorial_search_alter_exposed_date_fields(array &$form): void {
  if (isset($form['date_wrapper']) && is_array($form['date_wrapper'])) {
    $form['date_wrapper']['#attributes']['class'][] = 'eonext-editorial-search__date-filter-wrapper';
    eonext_editorial_search_flatten_date_fieldsets($form['date_wrapper']);
  }

  if (isset($form['date_wrapper']['date_wrapper']['date'])) {
    $date_fields = &$form['date_wrapper']['date_wrapper']['date'];
  }
  elseif (isset($form['date_wrapper']['date'])) {
    $date_fields = &$form['date_wrapper']['date'];
  }
  elseif (isset($form['date'])) {
    $date_fields = &$form['date'];
  }
  else {
    return;
  }

  $date_fields['#attributes']['class'][] = 'eonext-editorial-search__date-fields';

  foreach (['min' => 'Fra', 'max' => 'Til'] as $key => $label) {
    if (!isset($date_fields[$key])) {
      continue;
    }

    $date_fields[$key]['#title'] = t($label, [], ['context' => 'eonext_editorial_search']);
    $date_fields[$key]['#title_display'] = 'before';
    $date_fields[$key]['#attributes']['class'][] = 'eonext-editorial-search__date-input';
    $date_fields[$key]['#label_attributes']['class'][] = 'eonext-editorial-search__date-label';
    unset(
      $date_fields[$key]['#size'],
      $date_fields[$key]['#maxlength'],
      $date_fields[$key]['#attributes']['placeholder'],
    );
  }
}

/**
 * Flattens nested fieldsets on the exposed date filter.
 */
function eonext_editorial_search_flatten_date_fieldsets(array &$element): void {
  if (($element['#type'] ?? '') === 'fieldset') {
    $element['#type'] = 'container';
    unset($element['#title'], $element['#title_display']);
    $element['#attributes']['class'][] = 'eonext-editorial-search__date-fieldset';
  }

  foreach (array_keys($element) as $key) {
    if (!is_array($element[$key] ?? NULL) || str_starts_with((string) $key, '#')) {
      continue;
    }

    eonext_editorial_search_flatten_date_fieldsets($element[$key]);
  }
}

/**
 * Hides nested fieldset legends on the exposed date filter.
 */
function eonext_editorial_search_hide_date_fieldset_legends(array &$element): void {
  if (($element['#type'] ?? '') === 'fieldset') {
    $element['#title_display'] = 'invisible';
    $element['#attributes']['class'][] = 'eonext-editorial-search__date-fieldset';
  }

  foreach (array_keys($element) as $key) {
    if (!is_array($element[$key] ?? NULL) || str_starts_with((string) $key, '#')) {
      continue;
    }

    eonext_editorial_search_hide_date_fieldset_legends($element[$key]);
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function eonext_editorial_search_form_dpl_library_agency_general_settings_alter(&$form, FormStateInterface $form_state, $form_id) {

  $config = \Drupal::config('eonext_editorial_search.settings');

  $form['editorial_search']['enable_editorial_search'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable Editorial Search'),
    '#default_value' => $config->get('enable_editorial_search') ?? TRUE,
    '#description' => t('If enabled, the editorial search will be available.'),
  ];

  $form['editorial_search']['results_display'] = [
    '#type' => 'select',
    '#title' => t('Search results layout'),
    '#options' => [
      EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID => t('Grid (cards)', [], ['context' => 'eonext_editorial_search']),
      EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_LIST => t('Rows (list)', [], ['context' => 'eonext_editorial_search']),
    ],
    '#default_value' => $config->get('results_display') ?? EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID,
    '#description' => t('How editorial search results are displayed on /search/web and related pages.'),
    '#states' => [
      'visible' => [
        ':input[name="enable_editorial_search"]' => ['checked' => TRUE],
      ],
    ],
  ];

  $form['#submit'][] = 'eonext_editorial_search_general_settings_form_submit';
}

function eonext_editorial_search_general_settings_form_submit(array &$form, FormStateInterface $form_state): void {

  $enable_editorial_search = (bool) $form_state->getValue('enable_editorial_search');
  $results_display = $form_state->getValue('results_display');
  if (!in_array($results_display, [
    EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID,
    EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_LIST,
  ], TRUE)) {
    $results_display = EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID;
  }

  \Drupal::configFactory()
    ->getEditable('eonext_editorial_search.settings')
    ->set('enable_editorial_search', $enable_editorial_search)
    ->set('results_display', $results_display)
    ->save();

  if ($enable_editorial_search) {
    try {
      \Drupal::moduleHandler()->loadInclude('eonext_editorial_search', 'install');
      $messages = [
        eonext_editorial_search_ensure_facet_index_fields(),
        eonext_editorial_search_ensure_sort_index_fields(),
        eonext_editorial_search_ensure_editorial_event_date_processor(),
        eonext_editorial_search_ensure_editorial_content_indexing(),
      ];
      \Drupal::messenger()->addStatus(t('Editorial search index checked: @info', [
        '@info' => implode(' ', array_filter($messages)),
      ]));
    }
    catch (\Throwable $exception) {
      \Drupal::logger('eonext_editorial_search')->error('Failed to ensure editorial search index fields: @message', [
        '@message' => $exception->getMessage(),
      ]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function eonext_editorial_search_preprocess_dpl_react_app(array &$variables): void {

  $enabled = (bool) (\Drupal::config('eonext_editorial_search.settings')
    ->get('enable_editorial_search') ?? TRUE);

  $variables['attributes']['data-editorial-search'] = json_encode($enabled);
  // Only enable the module overlay — do not trigger legacy editorial code in
  // patched dpl-react builds that read data-autosuggest-editorial.
  $variables['attributes']['data-eonext-editorial-overlay'] = json_encode($enabled);
  $variables['#cache']['tags'][] = 'config:eonext_editorial_search.settings';

  if ($enabled) {
    $variables['#attached']['library'][] = 'eonext_editorial_search/react-integration';
    $variables['#attached']['drupalSettings']['eonextEditorialSearch'] = [
      'enabled' => TRUE,
      'relatedPageSize' => 20,
      'autosuggestLimit' => 7,
      'searchResultLimit' => 5,
      'searchResultFilters' => [
        'content_type:article',
        'content_type:page',
        'content_type:default',
      ],
      'materialRelatedFilters' => [
        'content_type:article',
      ],
      'dateLocale' => 'da-DK',
      'icons' => [
        'base' => eonext_editorial_search_get_base_icon_path(),
      ],
      'translations' => [
        'Artikel' => (string) t('Artikel', [], ['context' => 'eonext_editorial_search']),
        'Event' => (string) t('Event', [], ['context' => 'eonext_editorial_search']),
        'E-Resource' => (string) t('E-Resource', [], ['context' => 'eonext_editorial_search']),
        'relatedContentText' => (string) t('Related content', [], ['context' => 'DPL related content']),
      ],
    ];
  }
}
