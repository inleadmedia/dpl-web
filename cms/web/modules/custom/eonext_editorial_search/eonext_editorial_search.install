<?php

/**
 * @file
 * Install hooks for EO Next Editorial Search.
 */

use Drupal\eonext_editorial_search\ArticleMaterialSync;
use Drupal\search_api\Entity\Index;
use Drupal\search_api\IndexInterface;
use Drupal\user\Entity\Role;

function _eonext_editorial_search_grant_rest_permissions(): void {
  $permission = 'restful get eonext_editorial_search:editorial_search';

  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = Role::load($role_id);
    if ($role === NULL || $role->hasPermission($permission)) {
      continue;
    }

    $role->grantPermission($permission);
    $role->save();
  }
}

function _eonext_editorial_search_revoke_rest_permissions(): void {
  $permission = 'restful get eonext_editorial_search:editorial_search';

  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = Role::load($role_id);
    if ($role === NULL || !$role->hasPermission($permission)) {
      continue;
    }

    $role->revokePermission($permission);
    $role->save();
  }
}

function _eonext_editorial_search_ensure_settings(): void {
  $config = \Drupal::configFactory()->getEditable('eonext_editorial_search.settings');
  if ($config->get('enable_editorial_search') === NULL) {
    $config->set('enable_editorial_search', TRUE)->save();
  }
}

/**
 * Queues field_material sync for all articles when the field is available.
 *
 * @return int
 *   Number of articles queued.
 */
function _eonext_editorial_search_enqueue_article_material_sync(): int {
  if (!\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.field_material')) {
    return 0;
  }

  /** @var \Drupal\eonext_editorial_search\ArticleMaterialSync $sync */
  $sync = \Drupal::service(ArticleMaterialSync::class);
  $count = $sync->enqueueAllArticles();

  if ($count > 0) {
    \Drupal::logger('eonext_editorial_search')->notice(
      'Queued field_material sync for @count article(s). Process with cron or: drush queue:run @queue',
      [
        '@count' => $count,
        '@queue' => ArticleMaterialSync::QUEUE_NAME,
      ],
    );
  }

  return $count;
}

/**
 * Implements hook_install().
 */
function eonext_editorial_search_install(): void {
  _eonext_editorial_search_ensure_settings();
  eonext_editorial_search_ensure_facet_index_fields();
  eonext_editorial_search_ensure_sort_index_fields();
  eonext_editorial_search_ensure_editorial_event_date_processor();
  eonext_editorial_search_ensure_editorial_content_indexing();
  eonext_editorial_search_ensure_event_has_upcoming_indexing();
  eonext_editorial_search_exclude_go_articles_from_index();
  eonext_editorial_search_ensure_published_content_indexing();
  _eonext_editorial_search_grant_rest_permissions();
  _eonext_editorial_search_enqueue_article_material_sync();
}

/**
 * Implements hook_uninstall().
 */
function eonext_editorial_search_uninstall(): void {
  _eonext_editorial_search_revoke_rest_permissions();

  foreach (['editorial_categories', 'editorial_content_type', 'editorial_tags'] as $facet_id) {
    $facet = \Drupal::entityTypeManager()->getStorage('facets_facet')->load($facet_id);
    $facet?->delete();
  }

  $facet_source = \Drupal::entityTypeManager()
    ->getStorage('facets_facet_source')
    ->load('search_api:views_page__editorial_search__page');
  $facet_source?->delete();

  \Drupal::configFactory()->getEditable('eonext_editorial_search.settings')->delete();
}

function eonext_editorial_search_ensure_facet_index_fields(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial facet fields were not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $field_definitions = [
    'content_type' => [
      'label' => 'Content type',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/type',
          'entity:eventseries/type',
        ],
      ],
    ],
    'categories' => [
      'label' => 'Categories (Aggregrated)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_categories',
          'entity:node/field_categories',
        ],
      ],
    ],
    'tags' => [
      'label' => 'Tags (Aggregrated)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_tags',
          'entity:node/field_tags',
        ],
      ],
    ],
  ];

  $added_fields = [];
  foreach ($field_definitions as $field_id => $field_info) {
    if ($index->getField($field_id)) {
      continue;
    }

    $field = $fields_helper->createField($index, $field_id, $field_info);
    $index->addField($field);
    $added_fields[] = $field_id;
  }

  if ($added_fields === []) {
    return 'Editorial search facet fields already exist on index content_events.';
  }

  $ignorecase = $index->getProcessorIfAvailable('ignorecase');
  if ($ignorecase) {
    $configuration = $ignorecase->getConfiguration();
    $ignorecase_fields = $configuration['fields'] ?? [];
    foreach ($added_fields as $field_id) {
      if (!in_array($field_id, $ignorecase_fields, TRUE)) {
        $ignorecase_fields[] = $field_id;
      }
    }
    $configuration['fields'] = $ignorecase_fields;
    $ignorecase->setConfiguration($configuration);
  }

  $index->save();

  return sprintf(
    'Added Search API fields (%s) to index content_events. Re-index with: drush search-api:index content_events',
    implode(', ', $added_fields),
  );
}

function eonext_editorial_search_ensure_sort_index_fields(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial sort fields were not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $field_definitions = [
    'sort_date' => [
      'label' => 'Sort date',
      'property_path' => 'aggregated_field',
      'type' => 'date',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/created',
        ],
      ],
    ],
    'sort_title' => [
      'label' => 'Sort title',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/title',
          'entity:eventseries/title',
        ],
      ],
    ],
  ];

  $added_fields = [];
  foreach ($field_definitions as $field_id => $field_info) {
    if ($index->getField($field_id)) {
      continue;
    }

    $field = $fields_helper->createField($index, $field_id, $field_info);
    $index->addField($field);
    $added_fields[] = $field_id;
  }

  if ($added_fields === []) {
    return 'Editorial search sort fields already exist on index content_events.';
  }

  $index->save();

  return sprintf(
    'Added Search API sort fields (%s) to index content_events. Re-index with: drush search-api:index content_events',
    implode(', ', $added_fields),
  );
}

function eonext_editorial_search_remove_expired_event_series_from_index(): string {
  return 'Past events are indexed for editorial search; expired event cleanup is no longer performed.';
}

function eonext_editorial_search_ensure_editorial_content_indexing(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial content indexing was not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $messages = [];
  $added_fields = [];

  if (!$index->getField('editorial_content')) {
    $field = $fields_helper->createField($index, 'editorial_content', [
      'label' => 'Editorial content',
      'property_path' => 'aggregated_field',
      'type' => 'text',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [],
      ],
    ]);
    $index->addField($field);
    $added_fields[] = 'editorial_content';
  }

  $processors = $index->getProcessors();
  if (!isset($processors['editorial_content'])) {
    $processor = \Drupal::service('search_api.plugin_helper')
      ->createProcessorPlugin($index, 'editorial_content');
    $index->addProcessor($processor);
    $messages[] = 'Enabled editorial content processor on index content_events.';
  }

  if ($added_fields !== [] || $messages !== []) {
    $ignorecase = $index->getProcessorIfAvailable('ignorecase');
    if ($ignorecase) {
      $configuration = $ignorecase->getConfiguration();
      $ignorecase_fields = $configuration['fields'] ?? [];
      foreach ($added_fields as $field_id) {
        if (!in_array($field_id, $ignorecase_fields, TRUE)) {
          $ignorecase_fields[] = $field_id;
        }
      }
      $configuration['fields'] = $ignorecase_fields;
      $ignorecase->setConfiguration($configuration);
    }

    $index->save();
    $index->reindex();
  }

  if ($added_fields !== []) {
    $messages[] = sprintf(
      'Added Search API fields (%s) to index content_events.',
      implode(', ', $added_fields),
    );
  }

  if ($messages === []) {
    return 'Editorial content indexing is already configured on index content_events.';
  }

  $messages[] = 'Marked index content_events for re-indexing. Run: drush search-api:index content_events';

  return implode(' ', $messages);
}

function eonext_editorial_search_ensure_editorial_event_date_processor(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial event date processor was not added.';
  }

  $processors = $index->getProcessors();
  if (isset($processors['editorial_event_date'])) {
    return 'Editorial event date processor is already enabled on index content_events.';
  }

  $processor = \Drupal::service('search_api.plugin_helper')
    ->createProcessorPlugin($index, 'editorial_event_date');
  $index->addProcessor($processor);
  $index->save();

  return 'Enabled editorial event date processor on index content_events. Re-index with: drush search-api:index content_events';
}

function eonext_editorial_search_ensure_event_has_upcoming_indexing(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; event_has_upcoming was not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $messages = [];

  if (!$index->getField('event_has_upcoming')) {
    $field = $fields_helper->createField($index, 'event_has_upcoming', [
      'label' => 'Event has upcoming instances',
      'property_path' => 'aggregated_field',
      'type' => 'boolean',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [],
      ],
    ]);
    $index->addField($field);
    $messages[] = 'Added event_has_upcoming field to index content_events.';
  }

  if ($messages !== []) {
    $index->save();
    $index->reindex();
    $messages[] = 'Marked index content_events for re-indexing. Run: drush search-api:index content_events';
  }

  if ($messages === []) {
    return 'Event upcoming indexing is already configured on index content_events.';
  }

  return implode(' ', $messages);
}

function eonext_editorial_search_exclude_go_articles_from_index(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; GO articles were not excluded.';
  }

  $messages = [];
  $datasource_settings = $index->get('datasource_settings');
  $node_settings = $datasource_settings['entity:node'] ?? [];
  $bundles = $node_settings['bundles'] ?? [];
  $excluded_bundles = $bundles['selected'] ?? [];

  if (!in_array('go_article', $excluded_bundles, TRUE)) {
    $excluded_bundles[] = 'go_article';
    sort($excluded_bundles);
    $bundles['selected'] = $excluded_bundles;
    $bundles['default'] = $bundles['default'] ?? TRUE;
    $datasource_settings['entity:node'] = $bundles;
    $index->set('datasource_settings', $datasource_settings);
    $index->save();
    $messages[] = 'Excluded go_article from index content_events.';
  }

  if (!$index->getField('content_type')) {
    $messages[] = eonext_editorial_search_ensure_facet_index_fields();
    $index = Index::load('content_events');
    if (!$index instanceof IndexInterface || !$index->getField('content_type')) {
      $messages[] = 'Skipped removing indexed GO articles because content_type is not configured on index content_events.';
    }
  }

  if ($index instanceof IndexInterface && $index->getField('content_type')) {
    $query = $index->query();
    $query->addCondition('content_type', 'go_article');
    $query->range(0, 10000);
    $results = $query->execute();

    $item_ids = [];
    foreach ($results->getResultItems() as $item) {
      $item_ids[] = $item->getId();
    }

    if ($item_ids !== []) {
      $index->getServerInstance()->deleteItems($index, $item_ids);
      $messages[] = sprintf(
        'Removed %d GO article(s) from index content_events.',
        count($item_ids),
      );
    }
  }

  $facet = \Drupal::entityTypeManager()
    ->getStorage('facets_facet')
    ->load('editorial_content_type');

  if ($facet) {
    $processors = $facet->get('processor_configs');
    $replacements = $processors['replace']['settings']['replacements'] ?? '';
    if (str_contains($replacements, 'go_article|GO Article')) {
      $processors['replace']['settings']['replacements'] = str_replace(
        "go_article|GO Article\r\n",
        '',
        $replacements,
      );
      $facet->set('processor_configs', $processors);
      $facet->save();
      $messages[] = 'Removed GO Article from editorial_content_type facet labels.';
    }
  }

  if ($messages === []) {
    return 'GO articles are already excluded from index content_events.';
  }

  return implode(' ', $messages);
}
function eonext_editorial_search_ensure_published_content_indexing(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; unpublished content was not excluded.';
  }

  $messages = [];
  $processors = $index->getProcessors();
  if (!isset($processors['editorial_published_content'])) {
    $processor = \Drupal::service('search_api.plugin_helper')
      ->createProcessorPlugin($index, 'editorial_published_content');
    $index->addProcessor($processor);
    $index->save();
    $messages[] = 'Enabled editorial published content processor on index content_events.';
  }

  if ($index->getField('status') === NULL) {
    if ($messages === []) {
      return 'Editorial published content indexing is already configured on index content_events.';
    }

    return implode(' ', $messages);
  }

  $query = $index->query();
  $query->addCondition('status', FALSE);
  $query->range(0, 10000);
  $results = $query->execute();

  $item_ids = [];
  foreach ($results->getResultItems() as $item) {
    $item_ids[] = $item->getId();
  }

  if ($item_ids !== []) {
    $index->getServerInstance()->deleteItems($index, $item_ids);
    $messages[] = sprintf(
      'Removed %d unpublished item(s) from index content_events.',
      count($item_ids),
    );
  }

  if ($messages === []) {
    return 'Editorial published content indexing is already configured on index content_events.';
  }

  return implode(' ', $messages);
}

/**
 * Renames the content type facet label shown in the editorial search sidebar.
