<?php

/**
 * @file
 * Install hooks for EO Next Editorial Search.
 */

use Drupal\eonext_editorial_search\ArticleMaterialSync;
use Drupal\search_api\Entity\Index;
use Drupal\search_api\IndexInterface;
use Drupal\user\Entity\Role;

function _eonext_editorial_search_grant_rest_permissions(): void {
  $permission = 'restful get eonext_editorial_search:editorial_search';

  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = Role::load($role_id);
    if ($role === NULL || $role->hasPermission($permission)) {
      continue;
    }

    $role->grantPermission($permission);
    $role->save();
  }
}

function _eonext_editorial_search_revoke_rest_permissions(): void {
  $permission = 'restful get eonext_editorial_search:editorial_search';

  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = Role::load($role_id);
    if ($role === NULL || !$role->hasPermission($permission)) {
      continue;
    }

    $role->revokePermission($permission);
    $role->save();
  }
}

function _eonext_editorial_search_ensure_settings(): void {
  $config = \Drupal::configFactory()->getEditable('eonext_editorial_search.settings');
  if ($config->get('enable_editorial_search') === NULL) {
    $config->set('enable_editorial_search', TRUE);
  }
  if ($config->get('results_display') === NULL) {
    $config->set('results_display', EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID);
  }
  $config->save();
}

/**
 * Queues field_material sync for all articles when the field is available.
 *
 * @return int
 *   Number of articles queued.
 */
function _eonext_editorial_search_enqueue_article_material_sync(): int {
  if (!\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.field_material')) {
    return 0;
  }

  /** @var \Drupal\eonext_editorial_search\ArticleMaterialSync $sync */
  $sync = \Drupal::service(ArticleMaterialSync::class);
  $count = $sync->enqueueAllArticles();

  if ($count > 0) {
    \Drupal::logger('eonext_editorial_search')->notice(
      'Queued field_material sync for @count article(s). Process with cron or: drush queue:run @queue',
      [
        '@count' => $count,
        '@queue' => ArticleMaterialSync::QUEUE_NAME,
      ],
    );
  }

  return $count;
}

/**
 * Implements hook_install().
 */
function eonext_editorial_search_install(): void {
  _eonext_editorial_search_ensure_settings();
  eonext_editorial_search_ensure_facet_index_fields();
  eonext_editorial_search_ensure_editorial_is_free_processor();
  eonext_editorial_search_ensure_sort_index_fields();
  eonext_editorial_search_ensure_editorial_event_date_processor();
  eonext_editorial_search_ensure_editorial_content_indexing();
  eonext_editorial_search_ensure_event_has_upcoming_indexing();
  eonext_editorial_search_exclude_go_articles_from_index();
  eonext_editorial_search_ensure_published_content_indexing();
  eonext_editorial_search_configure_editorial_search_view();
  eonext_editorial_search_configure_facet_weights();
  _eonext_editorial_search_grant_rest_permissions();
  _eonext_editorial_search_enqueue_article_material_sync();
}

/**
 * Implements hook_uninstall().
 */
function eonext_editorial_search_uninstall(): void {
  _eonext_editorial_search_revoke_rest_permissions();

  foreach ([
    'editorial_categories',
    'editorial_content_type',
    'editorial_is_free',
    'editorial_screen_names',
    'editorial_tags',
  ] as $facet_id) {
    $facet = \Drupal::entityTypeManager()->getStorage('facets_facet')->load($facet_id);
    $facet?->delete();
  }

  $facet_source = \Drupal::entityTypeManager()
    ->getStorage('facets_facet_source')
    ->load('search_api:views_page__editorial_search__page');
  $facet_source?->delete();

  \Drupal::configFactory()->getEditable('eonext_editorial_search.settings')->delete();
}

function eonext_editorial_search_ensure_facet_index_fields(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial facet fields were not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $field_definitions = [
    'content_type' => [
      'label' => 'Content type',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/type',
          'entity:eventseries/type',
        ],
      ],
    ],
    'categories' => [
      'label' => 'Categories (Aggregrated)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_categories',
          'entity:node/field_categories',
        ],
      ],
    ],
    'tags' => [
      'label' => 'Tags (Aggregrated)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_tags',
          'entity:node/field_tags',
        ],
      ],
    ],
    'editorial_screen_names' => [
      'label' => 'Target group (events)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_screen_names',
        ],
      ],
    ],
    'editorial_is_free' => [
      'label' => 'Free events',
      'property_path' => 'aggregated_field',
      'type' => 'boolean',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [],
      ],
    ],
  ];

  $added_fields = [];
  foreach ($field_definitions as $field_id => $field_info) {
    if ($index->getField($field_id)) {
      continue;
    }

    $field = $fields_helper->createField($index, $field_id, $field_info);
    $index->addField($field);
    $added_fields[] = $field_id;
  }

  if ($added_fields === []) {
    return 'Editorial search facet fields already exist on index content_events.';
  }

  $ignorecase = $index->getProcessorIfAvailable('ignorecase');
  if ($ignorecase) {
    $configuration = $ignorecase->getConfiguration();
    $ignorecase_fields = $configuration['fields'] ?? [];
    foreach ($added_fields as $field_id) {
      if (!in_array($field_id, $ignorecase_fields, TRUE)) {
        $ignorecase_fields[] = $field_id;
      }
    }
    $configuration['fields'] = $ignorecase_fields;
    $ignorecase->setConfiguration($configuration);
  }

  $index->save();

  return sprintf(
    'Added Search API fields (%s) to index content_events. Re-index with: drush search-api:index content_events',
    implode(', ', $added_fields),
  );
}

function eonext_editorial_search_ensure_sort_index_fields(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial sort fields were not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $field_definitions = [
    'sort_date' => [
      'label' => 'Sort date',
      'property_path' => 'aggregated_field',
      'type' => 'date',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/created',
        ],
      ],
    ],
    'sort_title' => [
      'label' => 'Sort title',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/title',
          'entity:eventseries/title',
        ],
      ],
    ],
  ];

  $added_fields = [];
  foreach ($field_definitions as $field_id => $field_info) {
    if ($index->getField($field_id)) {
      continue;
    }

    $field = $fields_helper->createField($index, $field_id, $field_info);
    $index->addField($field);
    $added_fields[] = $field_id;
  }

  if ($added_fields === []) {
    return 'Editorial search sort fields already exist on index content_events.';
  }

  $index->save();

  return sprintf(
    'Added Search API sort fields (%s) to index content_events. Re-index with: drush search-api:index content_events',
    implode(', ', $added_fields),
  );
}

function eonext_editorial_search_remove_expired_event_series_from_index(): string {
  return 'Past events are indexed for editorial search; expired event cleanup is no longer performed.';
}

function eonext_editorial_search_ensure_editorial_content_indexing(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial content indexing was not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $messages = [];
  $added_fields = [];

  if (!$index->getField('editorial_content')) {
    $field = $fields_helper->createField($index, 'editorial_content', [
      'label' => 'Editorial content',
      'property_path' => 'aggregated_field',
      'type' => 'text',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [],
      ],
    ]);
    $index->addField($field);
    $added_fields[] = 'editorial_content';
  }

  $processors = $index->getProcessors();
  if (!isset($processors['editorial_content'])) {
    $processor = \Drupal::service('search_api.plugin_helper')
      ->createProcessorPlugin($index, 'editorial_content');
    $index->addProcessor($processor);
    $messages[] = 'Enabled editorial content processor on index content_events.';
  }

  if ($added_fields !== [] || $messages !== []) {
    $ignorecase = $index->getProcessorIfAvailable('ignorecase');
    if ($ignorecase) {
      $configuration = $ignorecase->getConfiguration();
      $ignorecase_fields = $configuration['fields'] ?? [];
      foreach ($added_fields as $field_id) {
        if (!in_array($field_id, $ignorecase_fields, TRUE)) {
          $ignorecase_fields[] = $field_id;
        }
      }
      $configuration['fields'] = $ignorecase_fields;
      $ignorecase->setConfiguration($configuration);
    }

    $index->save();
    $index->reindex();
  }

  if ($added_fields !== []) {
    $messages[] = sprintf(
      'Added Search API fields (%s) to index content_events.',
      implode(', ', $added_fields),
    );
  }

  if ($messages === []) {
    return 'Editorial content indexing is already configured on index content_events.';
  }

  $messages[] = 'Marked index content_events for re-indexing. Run: drush search-api:index content_events';

  return implode(' ', $messages);
}

function eonext_editorial_search_ensure_editorial_event_date_processor(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial event date processor was not added.';
  }

  $processors = $index->getProcessors();
  if (isset($processors['editorial_event_date'])) {
    return 'Editorial event date processor is already enabled on index content_events.';
  }

  $processor = \Drupal::service('search_api.plugin_helper')
    ->createProcessorPlugin($index, 'editorial_event_date');
  $index->addProcessor($processor);
  $index->save();

  return 'Enabled editorial event date processor on index content_events. Re-index with: drush search-api:index content_events';
}

function eonext_editorial_search_ensure_event_has_upcoming_indexing(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; event_has_upcoming was not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $messages = [];

  if (!$index->getField('event_has_upcoming')) {
    $field = $fields_helper->createField($index, 'event_has_upcoming', [
      'label' => 'Event has upcoming instances',
      'property_path' => 'aggregated_field',
      'type' => 'boolean',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [],
      ],
    ]);
    $index->addField($field);
    $messages[] = 'Added event_has_upcoming field to index content_events.';
  }

  if ($messages !== []) {
    $index->save();
    $index->reindex();
    $messages[] = 'Marked index content_events for re-indexing. Run: drush search-api:index content_events';
  }

  if ($messages === []) {
    return 'Event upcoming indexing is already configured on index content_events.';
  }

  return implode(' ', $messages);
}

function eonext_editorial_search_exclude_go_articles_from_index(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; GO articles were not excluded.';
  }

  $messages = [];
  $datasource_settings = $index->get('datasource_settings');
  $node_settings = $datasource_settings['entity:node'] ?? [];
  $bundles = $node_settings['bundles'] ?? [];
  $excluded_bundles = $bundles['selected'] ?? [];

  if (!in_array('go_article', $excluded_bundles, TRUE)) {
    $excluded_bundles[] = 'go_article';
    sort($excluded_bundles);
    $bundles['selected'] = $excluded_bundles;
    $bundles['default'] = $bundles['default'] ?? TRUE;
    $datasource_settings['entity:node'] = $bundles;
    $index->set('datasource_settings', $datasource_settings);
    $index->save();
    $messages[] = 'Excluded go_article from index content_events.';
  }

  if (!$index->getField('content_type')) {
    $messages[] = eonext_editorial_search_ensure_facet_index_fields();
    $index = Index::load('content_events');
    if (!$index instanceof IndexInterface || !$index->getField('content_type')) {
      $messages[] = 'Skipped removing indexed GO articles because content_type is not configured on index content_events.';
    }
  }

  if ($index instanceof IndexInterface && $index->getField('content_type')) {
    $query = $index->query();
    $query->addCondition('content_type', 'go_article');
    $query->range(0, 10000);
    $results = $query->execute();

    $item_ids = [];
    foreach ($results->getResultItems() as $item) {
      $item_ids[] = $item->getId();
    }

    if ($item_ids !== []) {
      $index->getServerInstance()->deleteItems($index, $item_ids);
      $messages[] = sprintf(
        'Removed %d GO article(s) from index content_events.',
        count($item_ids),
      );
    }
  }

  $facet = \Drupal::entityTypeManager()
    ->getStorage('facets_facet')
    ->load('editorial_content_type');

  if ($facet) {
    $processors = $facet->get('processor_configs');
    $replacements = $processors['replace']['settings']['replacements'] ?? '';
    if (str_contains($replacements, 'go_article|GO Article')) {
      $processors['replace']['settings']['replacements'] = str_replace(
        "go_article|GO Article\r\n",
        '',
        $replacements,
      );
      $facet->set('processor_configs', $processors);
      $facet->save();
      $messages[] = 'Removed GO Article from editorial_content_type facet labels.';
    }
  }

  if ($messages === []) {
    return 'GO articles are already excluded from index content_events.';
  }

  return implode(' ', $messages);
}
function eonext_editorial_search_ensure_published_content_indexing(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; unpublished content was not excluded.';
  }

  $messages = [];
  $processors = $index->getProcessors();
  if (!isset($processors['editorial_published_content'])) {
    $processor = \Drupal::service('search_api.plugin_helper')
      ->createProcessorPlugin($index, 'editorial_published_content');
    $index->addProcessor($processor);
    $index->save();
    $messages[] = 'Enabled editorial published content processor on index content_events.';
  }

  if ($index->getField('status') === NULL) {
    if ($messages === []) {
      return 'Editorial published content indexing is already configured on index content_events.';
    }

    return implode(' ', $messages);
  }

  $query = $index->query();
  $query->addCondition('status', FALSE);
  $query->range(0, 10000);
  $results = $query->execute();

  $item_ids = [];
  foreach ($results->getResultItems() as $item) {
    $item_ids[] = $item->getId();
  }

  if ($item_ids !== []) {
    $index->getServerInstance()->deleteItems($index, $item_ids);
    $messages[] = sprintf(
      'Removed %d unpublished item(s) from index content_events.',
      count($item_ids),
    );
  }

  if ($messages === []) {
    return 'Editorial published content indexing is already configured on index content_events.';
  }

  return implode(' ', $messages);
}

/**
 * Switches editorial search results to card view mode for grid display.
 */
function eonext_editorial_search_configure_card_grid_view(): string {
  $config = \Drupal::configFactory()->getEditable('eonext_editorial_search.settings');
  if ($config->isNew()) {
    return 'Editorial search settings were not found; results display was not configured.';
  }

  $config->set('results_display', EONEXT_EDITORIAL_SEARCH_RESULTS_DISPLAY_GRID)->save();

  return 'Set editorial search results display to grid.';
}

/**
 * Ensure editorial search layout setting exists for existing sites.
 */
function eonext_editorial_search_update_9010(): void {
  _eonext_editorial_search_ensure_settings();
}

/**
 * Adds event target group, free events facets, and date range filter.
 */
function eonext_editorial_search_update_9011(): string {
  $messages = [
    eonext_editorial_search_ensure_facet_index_fields(),
    eonext_editorial_search_ensure_editorial_is_free_processor(),
    eonext_editorial_search_ensure_event_facets(),
    eonext_editorial_search_configure_editorial_search_view(),
    eonext_editorial_search_configure_facet_weights(),
  ];

  $index = Index::load('content_events');
  if ($index instanceof IndexInterface) {
    $index->reindex();
    $messages[] = 'Marked index content_events for re-indexing. Run: drush search-api:index content_events';
  }

  return implode(' ', array_filter($messages));
}

/**
 * Ensures the editorial_is_free processor is enabled on the content_events index.
 */
function eonext_editorial_search_ensure_editorial_is_free_processor(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial_is_free processor was not added.';
  }

  $processor_settings = $index->get('processor_settings') ?? [];
  unset($processor_settings['editorial_event_is_free']);
  $index->set('processor_settings', $processor_settings);

  if ($index->getProcessorIfAvailable('editorial_event_is_free') !== NULL) {
    return 'Editorial event is free processor already exists on index content_events.';
  }

  \Drupal::service('plugin.manager.search_api.processor')->clearCachedDefinitions();

  $processor = \Drupal::getContainer()
    ->get('search_api.plugin_helper')
    ->createProcessorPlugin($index, 'editorial_event_is_free');
  $index->addProcessor($processor);
  $index->save();

  return 'Enabled editorial event is free processor on index content_events.';
}

/**
 * Creates event facet config entities when missing on existing sites.
 */
function eonext_editorial_search_ensure_event_facets(): string {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_editorial_search');
  $storage = \Drupal::entityTypeManager()->getStorage('facets_facet');
  $created = [];

  foreach (['editorial_is_free', 'editorial_screen_names'] as $facet_id) {
    if ($storage->load($facet_id) !== NULL) {
      continue;
    }

    $file = $module_path . '/config/install/facets.facet.' . $facet_id . '.yml';
    if (!is_readable($file)) {
      continue;
    }

    $data = \Drupal\Component\Serialization\Yaml::decode((string) file_get_contents($file));
    if (!is_array($data)) {
      continue;
    }

    $storage->create($data)->save();
    $created[] = $facet_id;
  }

  if ($created === []) {
    return 'Editorial event facets already exist.';
  }

  return sprintf('Created editorial facets: %s.', implode(', ', $created));
}

/**
 * Configures the editorial search view for event filters and AJAX facets.
 */
function eonext_editorial_search_configure_editorial_search_view(): string {
  $config = \Drupal::configFactory()->getEditable('views.view.editorial_search');
  if ($config->isNew()) {
    return 'Editorial search view was not found; event filters were not configured.';
  }

  $display = $config->get('display');
  if (!is_array($display)) {
    return 'Editorial search view display options were not found; event filters were not configured.';
  }

  $display['default']['display_options']['use_ajax'] = TRUE;
  $display['default']['display_options']['query']['options']['preserve_facet_query_args'] = TRUE;

  $display['default']['display_options']['exposed_form']['type'] = 'bef';
  $display['default']['display_options']['exposed_form']['options']['bef']['general'] = [
    'autosubmit' => FALSE,
    'autosubmit_exclude_textfield' => FALSE,
    'autosubmit_textfield_delay' => 500,
    'autosubmit_textfield_minimum_length' => 3,
    'autosubmit_hide' => TRUE,
    'input_required' => FALSE,
    'allow_secondary' => FALSE,
    'secondary_label' => 'Advanced options',
    'secondary_open' => FALSE,
    'reset_button_always_show' => FALSE,
  ];

  $bef = $display['default']['display_options']['exposed_form']['options']['bef']['filter'] ?? [];
  $bef['search_api_fulltext'] = [
    'plugin_id' => 'default',
    'advanced' => [
      'placeholder_text' => '',
      'rewrite' => [
        'filter_rewrite_values' => '',
        'filter_rewrite_values_key' => FALSE,
      ],
      'collapsible' => FALSE,
      'collapsible_disable_automatic_open' => FALSE,
      'is_secondary' => FALSE,
      'hide_label' => FALSE,
    ],
    'options_show_only_used' => FALSE,
    'options_show_only_used_filtered' => FALSE,
    'options_hide_when_empty' => FALSE,
    'options_show_items_count' => FALSE,
  ];
  $bef['date'] = [
    'plugin_id' => 'bef_datepicker',
    'advanced' => [
      'placeholder_text' => '',
      'rewrite' => [
        'filter_rewrite_values' => '',
        'filter_rewrite_values_key' => FALSE,
      ],
      'collapsible' => FALSE,
      'collapsible_disable_automatic_open' => FALSE,
      'is_secondary' => FALSE,
      'hide_label' => TRUE,
    ],
    'options_show_only_used' => FALSE,
    'options_show_only_used_filtered' => FALSE,
    'options_hide_when_empty' => FALSE,
    'options_show_items_count' => FALSE,
  ];
  $display['default']['display_options']['exposed_form']['options']['bef']['filter'] = $bef;

  $filters = $display['default']['display_options']['filters'] ?? [];
  $filters['date'] = [
    'id' => 'date',
    'table' => 'search_api_index_content_events',
    'field' => 'sort_date',
    'relationship' => 'none',
    'group_type' => 'group',
    'admin_label' => '',
    'plugin_id' => 'search_api_date',
    'operator' => 'between',
    'value' => [
      'min' => '',
      'max' => '',
      'value' => '',
      'type' => 'date',
    ],
    'group' => 1,
    'exposed' => TRUE,
    'expose' => [
      'operator_id' => 'date_op',
      'label' => 'Date',
      'description' => '',
      'use_operator' => FALSE,
      'operator' => 'date_op',
      'operator_limit_selection' => FALSE,
      'operator_list' => [],
      'identifier' => 'date',
      'required' => FALSE,
      'remember' => FALSE,
      'multiple' => FALSE,
      'remember_roles' => [
        'authenticated' => 'authenticated',
        'anonymous' => '0',
      ],
      'min_placeholder' => 'From',
      'max_placeholder' => 'To',
      'placeholder' => '',
    ],
    'is_grouped' => FALSE,
    'group_info' => [
      'label' => '',
      'description' => '',
      'identifier' => '',
      'optional' => TRUE,
      'widget' => 'select',
      'multiple' => FALSE,
      'remember' => FALSE,
      'default_group' => 'All',
      'default_group_multiple' => [],
      'group_items' => [],
    ],
  ];
  $display['default']['display_options']['filters'] = $filters;

  $page_display_id = 'page';
  $cache_tags = $display[$page_display_id]['cache_metadata']['tags'] ?? [];
  foreach ([
    'config:facets.facet.editorial_categories',
    'config:facets.facet.editorial_content_type',
    'config:facets.facet.editorial_is_free',
    'config:facets.facet.editorial_screen_names',
    'config:facets.facet.editorial_tags',
  ] as $tag) {
    if (!in_array($tag, $cache_tags, TRUE)) {
      $cache_tags[] = $tag;
    }
  }
  $display[$page_display_id]['cache_metadata']['tags'] = $cache_tags;

  // Older versions mistakenly wrote cache tags to a non-existent "all" display.
  if (isset($display['all']) && empty($display['all']['display_plugin'])) {
    unset($display['all']);
  }

  $config->set('display', $display)->save();

  return 'Configured editorial search view with event date filter and AJAX facet settings.';
}

/**
 * Updates facet weights for the editorial search sidebar layout.
 */
function eonext_editorial_search_configure_facet_weights(): string {
  $weights = [
    'editorial_content_type' => 0,
    'editorial_is_free' => 1,
    'editorial_screen_names' => 2,
    'editorial_categories' => 3,
    'editorial_tags' => 4,
  ];

  $updated = [];
  foreach ($weights as $facet_id => $weight) {
    $facet = \Drupal::entityTypeManager()->getStorage('facets_facet')->load($facet_id);
    if ($facet === NULL) {
      continue;
    }

    $changed = FALSE;
    if ((int) $facet->get('weight') !== $weight) {
      $facet->set('weight', $weight);
      $changed = TRUE;
    }

    if ($facet_id === 'editorial_is_free' && (int) $facet->get('min_count') !== 0) {
      $facet->set('min_count', 0);
      $changed = TRUE;
    }

    if (!$changed) {
      continue;
    }

    $facet->save();
    $updated[] = $facet_id;
  }

  if ($updated === []) {
    return 'Editorial search facet weights are already configured.';
  }

  return sprintf('Updated editorial facet weights: %s.', implode(', ', $updated));
}

/**
 * Fixes editorial search view cache tags on the page display.
 */
function eonext_editorial_search_update_9012(): string {
  return eonext_editorial_search_configure_editorial_search_view();
}
