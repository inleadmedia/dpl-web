<?php

/**
 * @file
 * Install and update hooks for EO Next Editorial Search.
 */

use Drupal\search_api\Entity\Index;
use Drupal\search_api\IndexInterface;

/**
 * Implements hook_install().
 */
function eonext_editorial_search_install(): void {
  eonext_editorial_search_ensure_facet_index_fields();
  eonext_editorial_search_ensure_sort_index_fields();
  eonext_editorial_search_ensure_editorial_event_date_processor();
}

/**
 * Adds missing Search API fields required by editorial search facets.
 *
 * Facets fail with InvalidQueryTypeException when the index is missing the
 * configured field_identifier (e.g. content_type).
 */
function eonext_editorial_search_ensure_facet_index_fields(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial facet fields were not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $field_definitions = [
    'content_type' => [
      'label' => 'Content type',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/type',
          'entity:eventseries/type',
        ],
      ],
    ],
    'categories' => [
      'label' => 'Categories (Aggregrated)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_categories',
          'entity:node/field_categories',
        ],
      ],
    ],
    'tags' => [
      'label' => 'Tags (Aggregrated)',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:eventseries/field_tags',
          'entity:node/field_tags',
        ],
      ],
    ],
  ];

  $added_fields = [];
  foreach ($field_definitions as $field_id => $field_info) {
    if ($index->getField($field_id)) {
      continue;
    }

    $field = $fields_helper->createField($index, $field_id, $field_info);
    $index->addField($field);
    $added_fields[] = $field_id;
  }

  if ($added_fields === []) {
    return 'Editorial search facet fields already exist on index content_events.';
  }

  $ignorecase = $index->getProcessorIfAvailable('ignorecase');
  if ($ignorecase) {
    $configuration = $ignorecase->getConfiguration();
    $ignorecase_fields = $configuration['fields'] ?? [];
    foreach ($added_fields as $field_id) {
      if (!in_array($field_id, $ignorecase_fields, TRUE)) {
        $ignorecase_fields[] = $field_id;
      }
    }
    $configuration['fields'] = $ignorecase_fields;
    $ignorecase->setConfiguration($configuration);
  }

  $index->save();

  return sprintf(
    'Added Search API fields (%s) to index content_events. Re-index with: drush search-api:index content_events',
    implode(', ', $added_fields),
  );
}

/**
 * Adds missing Search API fields required for editorial search sorting.
 */
function eonext_editorial_search_ensure_sort_index_fields(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial sort fields were not added.';
  }

  /** @var \Drupal\search_api\Utility\FieldsHelperInterface $fields_helper */
  $fields_helper = \Drupal::service('search_api.fields_helper');

  $field_definitions = [
    'sort_date' => [
      'label' => 'Sort date',
      'property_path' => 'aggregated_field',
      'type' => 'date',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/created',
        ],
      ],
    ],
    'sort_title' => [
      'label' => 'Sort title',
      'property_path' => 'aggregated_field',
      'type' => 'string',
      'configuration' => [
        'type' => 'union',
        'separator' => '-not used-',
        'fields' => [
          'entity:node/title',
          'entity:eventseries/title',
        ],
      ],
    ],
  ];

  $added_fields = [];
  foreach ($field_definitions as $field_id => $field_info) {
    if ($index->getField($field_id)) {
      continue;
    }

    $field = $fields_helper->createField($index, $field_id, $field_info);
    $index->addField($field);
    $added_fields[] = $field_id;
  }

  if ($added_fields === []) {
    return 'Editorial search sort fields already exist on index content_events.';
  }

  $index->save();

  return sprintf(
    'Added Search API sort fields (%s) to index content_events. Re-index with: drush search-api:index content_events',
    implode(', ', $added_fields),
  );
}

/**
 * Ensures the editorial event date processor is enabled on the search index.
 */
function eonext_editorial_search_ensure_editorial_event_date_processor(): string {
  $index = Index::load('content_events');
  if (!$index instanceof IndexInterface) {
    return 'Search API index content_events was not found; editorial event date processor was not added.';
  }

  $processors = $index->getProcessors();
  if (isset($processors['editorial_event_date'])) {
    return 'Editorial event date processor is already enabled on index content_events.';
  }

  $processor = \Drupal::service('search_api.plugin_helper')
    ->createProcessorPlugin($index, 'editorial_event_date');
  $index->addProcessor($processor);
  $index->save();

  return 'Enabled editorial event date processor on index content_events. Re-index with: drush search-api:index content_events';
}

/**
 * Updates sort_date configuration and enables editorial event date indexing.
 */
function eonext_editorial_search_update_9002(): string {
  $messages = [
    eonext_editorial_search_ensure_editorial_event_date_processor(),
  ];

  $index = Index::load('content_events');
  if ($index instanceof IndexInterface) {
    $sort_date = $index->getField('sort_date');
    if ($sort_date) {
      $configuration = $sort_date->getConfiguration();
      $configuration['fields'] = ['entity:node/created'];
      $sort_date->setConfiguration($configuration);
      $index->save();
      $messages[] = 'Updated sort_date on index content_events to use node created dates and upcoming event dates for events.';
    }
    else {
      $messages[] = eonext_editorial_search_ensure_sort_index_fields();
    }
  }

  return implode(' ', $messages);
}

/**
 * Ensures editorial event date processor is enabled after skipped update hooks.
 */
function eonext_editorial_search_update_9004(): string {
  return eonext_editorial_search_update_9002();
}

/**
 * Renames the content type facet label shown in the editorial search sidebar.
 */
function eonext_editorial_search_update_9001(): string {
  $facet = \Drupal::entityTypeManager()
    ->getStorage('facets_facet')
    ->load('editorial_content_type');

  if (!$facet) {
    return 'Facet editorial_content_type was not found.';
  }

  if ($facet->getName() === 'Type') {
    return 'Facet editorial_content_type label is already Type.';
  }

  $facet->set('name', 'Type');
  $facet->save();

  return 'Renamed editorial_content_type facet label to Type.';
}
