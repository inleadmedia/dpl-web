{%
  set classes = [
  dom_id ? 'js-view-dom-id-' ~ dom_id,
  'content-list-page',
  'editorial-search',
]
%}
<div{{ attributes.addClass(classes) }}>
  {% if view.getTitle() %}
    {{ title_prefix }}
    <h1 class="content-list-page__heading">{{ view.getTitle() }}</h1>
    {{ title_suffix }}
  {% endif %}

  {{ header }}

  {% if exposed %}
    <div class="editorial-search__search-form">
      {{ exposed }}
    </div>
  {% endif %}

  {{ attachment_before }}

  <div class="search editorial-search__layout">
    <div class="search__results">
      <div class="search__grid editorial-search__grid">
        <aside class="search-facets editorial-search__facets">
          <div class="search-facets__container">
            <ul class="search-facets__groups">
              {{ drupal_block('facet_block:editorial_content_type') }}
              {{ drupal_block('facet_block:editorial_categories') }}
              {{ drupal_block('facet_block:editorial_tags') }}
            </ul>
          </div>
        </aside>

        <section class="editorial-search__results">
          {% if editorial_search_sort_options %}
            <div class="search__sort-select editorial-search__sort">
              <label class="search__sort-select__label" for="editorial-search-sort">
                {{ 'Sort by'|t({}, {'context': 'eonext_editorial_search'}) }}
              </label>
              <div class="search__sort-select__select-wrapper">
                <select
                  class="search__sort-select__select"
                  id="editorial-search-sort"
                  data-editorial-search-sort
                >
                  {% for value, label in editorial_search_sort_options %}
                    <option value="{{ value }}"{{ value == editorial_search_sort_selected ? ' selected' : '' }}>
                      {{ label }}
                    </option>
                  {% endfor %}
                </select>
                <div class="search__dropdown__arrows">
                  <img
                    class="search__dropdown__arrow"
                    alt=""
                    src="{{ baseIconPath }}/collection/ExpandMore.svg"
                  >
                </div>
              </div>
            </div>
          {% endif %}

          {% if rows -%}
            {{ rows }}
          {% elseif empty -%}
            <div class="empty-view">
              {{ empty }}
            </div>
          {% endif %}

          {{ pager }}
        </section>
      </div>
    </div>
  </div>

  {{ attachment_after }}
  {{ more }}
  {{ footer }}
  {{ feed_icons }}
</div>
