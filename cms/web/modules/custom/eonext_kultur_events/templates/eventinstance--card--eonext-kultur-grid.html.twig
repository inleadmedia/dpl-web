{#
/**
 * @file
 * Event grid card – image on top, text panel below.
 */
#}
{% if hero_slide %}
  <article{{ attributes.addClass('eonext-kultur-event-card') }}>
    <a href="{{ hero_slide.url }}" class="eonext-kultur-event-card__link">
      {% if hero_slide.image %}
        <div class="eonext-kultur-event-card__media">
          {{ hero_slide.image }}
        </div>
      {% endif %}

      <div class="eonext-kultur-event-card__body">
        <h3 class="eonext-kultur-event-card__title">{{ hero_slide.title }}</h3>
        {% if hero_slide.tagline %}
          <p class="eonext-kultur-event-card__tagline">{{ hero_slide.tagline }}</p>
        {% endif %}

        <div class="eonext-kultur-event-card__footer">
          {% if hero_slide.date_display %}
            <time class="eonext-kultur-event-card__date" datetime="{{ hero_slide.date_display }}">{{ hero_slide.date_display }}</time>
          {% endif %}
          <span class="eonext-kultur-event-card__cta">{{ 'LÆS MERE'|t }}</span>
        </div>
      </div>
    </a>
  </article>
{% endif %}
