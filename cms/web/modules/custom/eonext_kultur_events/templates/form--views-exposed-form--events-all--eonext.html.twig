{#
/**
 * @file
 * Exposed filters toolbar for kultur events listing.
 */
#}
<form{{ attributes.addClass('eonext-kultur-events__toolbar-form') }}>
  <div class="eonext-kultur-events__toolbar">
    {% if element.search_api_fulltext %}
      <div class="js-form-item form-item form-type-textfield js-form-type-textfield form-item-search-api-fulltext js-form-item-search-api-fulltext">
        <label for="{{ element.search_api_fulltext['#id'] }}" class="input-label">{{ 'Søg'|t({}, {'context': 'eonext_kultur_events'}) }}</label>
        {{ element.search_api_fulltext }}
      </div>
    {% endif %}
    {% if element.date_wrapper %}
      {{ element.date_wrapper }}
    {% endif %}
    {% if element.actions.submit %}
      <div class="form-actions js-form-wrapper form-wrapper">
        {% set submit_label = 'Apply'|t({}, {'context': 'eonext_kultur_events'}) %}
        <button
          type="submit"
          id="{{ element.actions.submit['#id'] }}"
          name="{{ element.actions.submit['#name'] }}"
          value="{{ submit_label }}"
          class="button js-form-submit form-submit eonext-kultur-events__submit"
          aria-label="{{ submit_label }}"
        >{{ submit_label }}</button>
      </div>
    {% endif %}
  </div>
</form>
