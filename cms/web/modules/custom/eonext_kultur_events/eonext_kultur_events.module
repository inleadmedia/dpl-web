<?php

/**
 * @file
 * EO Next Kultur Events module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\dpl_search\DplSearchSettings;
use Drupal\eonext_kultur_events\EventsConstants;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\recurring_events\Entity\EventInstance;
use Drupal\recurring_events\Entity\EventSeries;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function eonext_kultur_events_theme($existing, $type, $theme, $path): array {
  $templates_path = $path . '/templates';

  return [
    'views_view__events__eonext' => [
      'base hook' => 'views_view',
      'path' => $templates_path,
      'template' => 'views-view--events--eonext',
    ],
    'views_view__events__all__eonext' => [
      'base hook' => 'views_view',
      'path' => $templates_path,
      'template' => 'views-view--events--eonext',
    ],
    'views_view_unformatted__events__eonext' => [
      'base hook' => 'views_view_unformatted',
      'path' => $templates_path,
      'template' => 'views-view-unformatted--events--eonext',
    ],
    'views_view_unformatted__events__all__eonext' => [
      'base hook' => 'views_view_unformatted',
      'path' => $templates_path,
      'template' => 'views-view-unformatted--events--eonext',
    ],
    'facets_item_list__events__eonext' => [
      'base hook' => 'facets_item_list',
      'path' => $templates_path,
      'template' => 'facets-item-list--events--eonext',
    ],
    'block__facet_block__events__eonext' => [
      'base hook' => 'block',
      'path' => $templates_path,
      'template' => 'block--facet-block--events--eonext',
    ],
    'form__views_exposed_form__events__all__eonext' => [
      'base hook' => 'form',
      'path' => $templates_path,
      'template' => 'form--views-exposed-form--events-all--eonext',
    ],
    'input__search_api_fulltext__events' => [
      'base hook' => 'input',
      'path' => $templates_path,
      'template' => 'input--search-api-fulltext--events',
    ],
    'eventinstance__card__eonext_kultur_grid' => [
      'base hook' => 'eventinstance',
      'path' => $templates_path,
      'template' => 'eventinstance--card--eonext-kultur-grid',
    ],
    'eventinstance__full' => [
      'base hook' => 'eventinstance',
      'path' => $templates_path,
      'template' => 'eventinstance--full',
    ],
    'eventseries__full' => [
      'base hook' => 'eventseries',
      'path' => $templates_path,
      'template' => 'eventseries--full',
    ],
    'eonext_kultur_event_detail' => [
      'variables' => [
        'attributes' => NULL,
        'detail' => [],
        'baseIconPath' => '',
        'tags' => NULL,
        'categories' => NULL,
        'target_group' => NULL,
        'branch' => NULL,
        'partners' => NULL,
        'paragraphs' => NULL,
        'event_instances' => NULL,
      ],
      'path' => $templates_path,
      'template' => 'eonext-kultur-event-detail',
    ],
  ];
}

/**
 * Returns the module templates directory.
 */
function eonext_kultur_events_get_templates_path(): string {
  return \Drupal::service('extension.list.module')->getPath('eonext_kultur_events') . '/templates';
}

/**
 * Implements hook_theme_registry_alter().
 */
function eonext_kultur_events_theme_registry_alter(array &$theme_registry): void {
  $templates_path = eonext_kultur_events_get_templates_path();

  $overrides = [
    'views_view__events__eonext' => 'views-view--events--eonext',
    'views_view__events__all__eonext' => 'views-view--events--eonext',
    'views_view_unformatted__events__eonext' => 'views-view-unformatted--events--eonext',
    'views_view_unformatted__events__all__eonext' => 'views-view-unformatted--events--eonext',
    'facets_item_list__events__eonext' => 'facets-item-list--events--eonext',
    'block__facet_block__events__eonext' => 'block--facet-block--events--eonext',
    'form__views_exposed_form__events__all__eonext' => 'form--views-exposed-form--events-all--eonext',
    'input__search_api_fulltext__events' => 'input--search-api-fulltext--events',
    'eventinstance__card__eonext_kultur_grid' => 'eventinstance--card--eonext-kultur-grid',
    'eventinstance__full' => 'eventinstance--full',
    'eventseries__full' => 'eventseries--full',
  ];

  foreach ($overrides as $hook => $template) {
    if (!isset($theme_registry[$hook])) {
      continue;
    }

    $theme_registry[$hook]['path'] = $templates_path;
    $theme_registry[$hook]['template'] = $template;
    $theme_registry[$hook]['type'] = 'module';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 */
function eonext_kultur_events_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  if (($variables['view']->id() ?? '') !== EventsConstants::VIEW_ID) {
    return;
  }

  $suggestions[] = 'views_view__events__eonext';
  $suggestions[] = 'views_view__events__' . ($variables['view']->current_display ?? '') . '__eonext';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_unformatted.
 */
function eonext_kultur_events_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables): void {
  if (($variables['view']->id() ?? '') !== EventsConstants::VIEW_ID) {
    return;
  }

  $suggestions[] = 'views_view_unformatted__events__eonext';
  $suggestions[] = 'views_view_unformatted__events__' . ($variables['view']->current_display ?? '') . '__eonext';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for facets_item_list.
 */
function eonext_kultur_events_theme_suggestions_facets_item_list_alter(array &$suggestions, array $variables): void {
  $facet = $variables['facet'] ?? NULL;
  if ($facet && str_starts_with((string) $facet->id(), 'event_')) {
    $suggestions[] = 'facets_item_list__events__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block.
 */
function eonext_kultur_events_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $plugin_id = $variables['plugin_id'] ?? $variables['elements']['#plugin_id'] ?? '';
  if (str_starts_with((string) $plugin_id, 'facet_block:event_')) {
    $suggestions[] = 'block__facet_block__events__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form.
 */
function eonext_kultur_events_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $form_id = $variables['element']['#id'] ?? '';
  if ($form_id === 'views-exposed-form-events-all') {
    $suggestions[] = 'form__views_exposed_form__events__all__eonext';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for input.
 */
function eonext_kultur_events_theme_suggestions_input_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  if (($element['#name'] ?? '') !== 'search_api_fulltext') {
    return;
  }

  if (eonext_kultur_events_is_events_listing_page()) {
    $suggestions[] = 'input__search_api_fulltext__events';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for eventinstance.
 */
function eonext_kultur_events_theme_suggestions_eventinstance_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? $variables['view_mode'] ?? '';

  if ($view_mode === 'full' && eonext_kultur_events_is_event_detail_page()) {
    $suggestions[] = 'eventinstance__full';
  }

  if (!in_array($view_mode, [EventsConstants::CARD_VIEW_MODE, 'default'], TRUE)) {
    return;
  }

  if (eonext_kultur_events_is_events_listing_page()) {
    $suggestions[] = 'eventinstance__card__eonext_kultur_grid';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for eventseries.
 */
function eonext_kultur_events_theme_suggestions_eventseries_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? $variables['view_mode'] ?? '';

  if ($view_mode === 'full' && eonext_kultur_events_is_event_detail_page()) {
    $suggestions[] = 'eventseries__full';
  }
}

/**
 * Returns TRUE on the kultur events listing page.
 */
function eonext_kultur_events_is_events_listing_page(): bool {
  if (\Drupal::request()->attributes->get('eonext_kultur_events_listing')) {
    return TRUE;
  }

  $route = \Drupal::routeMatch()->getRouteName();
  if (in_array($route, ['view.events.all', 'entity.eventinstance.collection'], TRUE)) {
    return TRUE;
  }

  if ($route === 'views.ajax') {
    $request = \Drupal::request();
    $view_name = $request->request->get('view_name') ?? $request->query->get('view_name');
    $display_id = $request->request->get('view_display_id') ?? $request->query->get('view_display_id');
    if ($view_name === EventsConstants::VIEW_ID && $display_id === EventsConstants::VIEW_DISPLAY) {
      return TRUE;
    }
  }

  $current = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current);
  $candidates = [trim($current, '/'), trim($alias, '/')];
  return in_array('arrangementer', $candidates, TRUE) || in_array('events', $candidates, TRUE);
}

/**
 * Returns the path of the page that embeds the events listing.
 *
 * Views AJAX strips view_path from the request before the view renders, but
 * sets the current path from that value first.
 */
function eonext_kultur_events_listing_page_path(): ?string {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'view.events.all') {
    return NULL;
  }

  $path = \Drupal::service('path.current')->getPath();
  if ($path === '' || $path === '/views/ajax') {
    return NULL;
  }

  return $path;
}

/**
 * Implements hook_form_views_exposed_form_alter().
 */
function eonext_kultur_events_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (($form['#id'] ?? '') !== 'views-exposed-form-events-all') {
    return;
  }

  $form['#after_build'][] = 'eonext_kultur_events_events_exposed_form_after_build';

  if (isset($form['search_api_fulltext'])) {
    $form['search_api_fulltext']['#attributes']['placeholder'] = '';
  }

  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'eonext-kultur-events__submit';
  }

  // Keep filters on the content page that embeds the view. The page display
  // otherwise posts back to /events.
  $listing_path = eonext_kultur_events_listing_page_path();
  if ($listing_path !== NULL) {
    $form['#action'] = Url::fromUserInput($listing_path)->toString();
  }
}

/**
 * After-build callback for the events exposed form.
 */
function eonext_kultur_events_events_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-events-all') {
    return $form;
  }

  if (isset($form['search_api_fulltext'])) {
    $form['search_api_fulltext']['#attributes']['class'][] = 'search-full-text__input';
    unset(
      $form['search_api_fulltext']['#size'],
      $form['search_api_fulltext']['#maxlength'],
      $form['search_api_fulltext']['#attributes']['placeholder']
    );
  }

  eonext_kultur_events_alter_exposed_date_fields($form);

  return $form;
}

/**
 * Applies kultur labels and styling to exposed date min/max fields.
 */
function eonext_kultur_events_alter_exposed_date_fields(array &$form): void {
  if (isset($form['date_wrapper']['date_wrapper']['date'])) {
    $date_fields = &$form['date_wrapper']['date_wrapper']['date'];
  }
  elseif (isset($form['date_wrapper']['date'])) {
    $date_fields = &$form['date_wrapper']['date'];
  }
  elseif (isset($form['date'])) {
    $date_fields = &$form['date'];
  }
  else {
    return;
  }

  foreach (['min' => 'Fra', 'max' => 'Til'] as $key => $label) {
    if (!isset($date_fields[$key])) {
      continue;
    }

    $date_fields[$key]['#title'] = t($label, [], ['context' => 'eonext_kultur_events']);
    $date_fields[$key]['#title_display'] = 'before';
    $date_fields[$key]['#attributes']['class'][] = 'eonext-kultur-events__date-input';
    unset(
      $date_fields[$key]['#size'],
      $date_fields[$key]['#maxlength'],
      $date_fields[$key]['#attributes']['placeholder']
    );
  }
}

/**
 * Returns TRUE on kultur event detail pages.
 */
function eonext_kultur_events_is_event_detail_page(): bool {
  return in_array(\Drupal::routeMatch()->getRouteName(), [
    'entity.eventinstance.canonical',
    'entity.eventseries.canonical',
  ], TRUE);
}

/**
 * Implements hook_preprocess_HOOK() for eventinstance.
 */
function eonext_kultur_events_preprocess_eventinstance(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';

  if ($view_mode === 'full' && eonext_kultur_events_is_event_detail_page()) {
    eonext_kultur_events_preprocess_event_detail($variables, $variables['eventinstance'] ?? NULL);
    return;
  }

  if (!in_array($view_mode, [EventsConstants::CARD_VIEW_MODE, 'default'], TRUE)) {
    return;
  }

  if (!eonext_kultur_events_is_events_listing_page()) {
    return;
  }

  $variables['theme_hook_suggestions'][] = 'eventinstance__card__eonext_kultur_grid';

  $eventinstance = $variables['eventinstance'] ?? NULL;
  if (!$eventinstance instanceof EventInstance) {
    return;
  }

  $slide = \Drupal::service('eonext_kultur_main.hero_slide_builder')->build($eventinstance);
  if ($slide !== NULL) {
    $variables['hero_slide'] = $slide;
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventseries.
 */
function eonext_kultur_events_preprocess_eventseries(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';

  if ($view_mode !== 'full' || !eonext_kultur_events_is_event_detail_page()) {
    return;
  }

  eonext_kultur_events_preprocess_event_detail($variables, $variables['eventseries'] ?? NULL);
}

/**
 * Implements hook_preprocess_HOOK() for page.
 */
function eonext_kultur_events_preprocess_page(array &$variables): void {
  if (!eonext_kultur_events_is_event_detail_page()) {
    return;
  }

  unset($variables['related_content']);
}

/**
 * Adds shared variables for kultur event detail templates.
 */
function eonext_kultur_events_preprocess_event_detail(array &$variables, mixed $entity): void {
  if (!$entity instanceof \Drupal\Core\Entity\EntityInterface) {
    return;
  }

  $detail = \Drupal::service('eonext_kultur_events.event_detail_builder')->build($entity);
  if ($detail === NULL) {
    return;
  }

  $variables['event_detail'] = $detail;
  $variables['baseIconPath'] = eonext_kultur_events_get_base_icon_path();
  $variables['#attached']['library'][] = 'eonext_kultur_events/event-detail';
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function eonext_kultur_events_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!($view instanceof ViewExecutable)) {
    return;
  }

  if ($view->id() === EventsConstants::VIEW_ID) {
    $variables['#attached']['library'][] = 'eonext_kultur_events/events-listing';
    $variables['baseIconPath'] = eonext_kultur_events_get_base_icon_path();

    if (eonext_kultur_events_is_events_listing_page()) {
      $default_heading = $view->getTitle() ?: (string) t('Kalender', [], ['context' => 'eonext_kultur_events']);
      $hero = \Drupal::service('eonext_kultur_events.listing_hero_builder')->build($default_heading);
      if ($hero !== NULL) {
        $variables['events_listing_hero'] = $hero;
        $variables['#attached']['library'][] = 'eonext_kultur_locale/lokale';
        $variables['#cache']['tags'][] = 'config:eonext_kultur_events.settings';
      }
    }
    return;
  }

  if ($view->id() !== DplSearchSettings::EDITORIAL_VIEW_ID) {
    return;
  }

  $variables['#attached']['library'][] = 'eonext_kultur_events/editorial-search';

  if ($view->current_display === 'page') {
    // Kultur web search does not link back to the material catalogue.
    unset($variables['header']['description']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for facets_item_list.
 */
function eonext_kultur_events_preprocess_facets_item_list(array &$variables): void {
  $facet = $variables['facet'] ?? NULL;
  if (!$facet || !str_starts_with((string) $facet->id(), 'event_')) {
    return;
  }

  $variables['baseIconPath'] = eonext_kultur_events_get_base_icon_path();
}

/**
 * Returns the active theme icon base path.
 */
function eonext_kultur_events_get_base_icon_path(): string {
  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();

  return '/' . $theme_path . '/assets/dpl-design-system/icons';
}

/**
 * Implements hook_views_pre_view().
 */
function eonext_kultur_events_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== EventsConstants::VIEW_ID || $display_id !== EventsConstants::VIEW_DISPLAY) {
    return;
  }

  $request = \Drupal::request();
  $request->attributes->set('eonext_kultur_events_listing', TRUE);

  if (\Drupal::routeMatch()->getRouteName() === 'view.events.all') {
    return;
  }

  if ($request->attributes->get('_route') === 'views.ajax') {
    $listing_path = eonext_kultur_events_listing_page_path();
    if ($listing_path !== NULL) {
      $view->override_url = Url::fromUserInput($listing_path);
    }
    return;
  }

  if (!empty($view->override_path)) {
    return;
  }

  $current = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current);
  $view->override_path = ltrim($alias !== $current ? $alias : $current, '/');
  $view->override_url = Url::fromRoute('<current>');
}

/**
 * Implements hook_preprocess_HOOK() for field.
 */
function eonext_kultur_events_preprocess_field(array &$variables): void {
  if (($variables['field_name'] ?? '') !== 'field_paragraphs') {
    return;
  }

  foreach ($variables['items'] as &$item) {
    $paragraph = _eonext_kultur_events_item_paragraph($item);
    if (!$paragraph instanceof ParagraphInterface || $paragraph->bundle() !== EventsConstants::PARAGRAPH_BUNDLE) {
      continue;
    }

    $item['content'] = views_embed_view(EventsConstants::VIEW_ID, EventsConstants::VIEW_DISPLAY);
    $item['content']['#paragraph'] = $paragraph;
  }
}

/**
 * Resolve the paragraph entity from a field item render array.
 */
function _eonext_kultur_events_item_paragraph(array $item): ?ParagraphInterface {
  $content = $item['content'] ?? [];
  $candidates = [
    $content['#paragraph'] ?? NULL,
    $content['#entity'] ?? NULL,
    $content[0]['#paragraph'] ?? NULL,
    $content[0]['#entity'] ?? NULL,
  ];

  foreach ($candidates as $candidate) {
    if ($candidate instanceof ParagraphInterface) {
      return $candidate;
    }
  }

  if (!is_array($content)) {
    return NULL;
  }

  foreach (Element::children($content, TRUE) as $child) {
    if (isset($content[$child]['#paragraph']) && $content[$child]['#paragraph'] instanceof ParagraphInterface) {
      return $content[$child]['#paragraph'];
    }
  }

  return NULL;
}

/**
 * Implements hook_views_pre_render().
 */
function eonext_kultur_events_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== EventsConstants::VIEW_ID || $view->current_display !== EventsConstants::VIEW_DISPLAY) {
    return;
  }

  $view->element['#attached']['library'][] = 'eonext_kultur_events/events-listing';
}

/**
 * Implements hook_ENTITY_TYPE_presave() for eventseries.
 *
 * Sets publication date when an event series is published, mirroring articles.
 */
function eonext_kultur_events_eventseries_presave(EventSeries $event_series): void {
  if (!$event_series->hasField('field_publication_date')) {
    return;
  }

  $original = $event_series->original ?? NULL;
  if (!$original instanceof EventSeries) {
    return;
  }

  if ($event_series->get('field_publication_date')->isEmpty()
    || ($event_series->isPublished() && !$original->isPublished())) {
    $event_series->set('field_publication_date', (new DrupalDateTime('now'))->format('Y-m-d'));
  }
}
