<?php

/**
 * @file
 * Library staff logic.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\drupal_typed\DrupalTyped;
use Drupal\eonext_staff\Hook\StaffHooks;
use Drupal\user\UserInterface;

/*
 * The following LegacyHooks can be removed when upgrading to Drupal 11.2,
 * together with the hook class service definitions.
 */

/**
 * Registers theme implementations.
 */
#[LegacyHook]
function eonext_staff_theme(mixed $existing, string $type, string $theme, string $path): array {
  return DrupalTyped::service(StaffHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * The staff paragraph is an empty shell, so set its contents here.
 */
#[LegacyHook]
function eonext_staff_preprocess_paragraph__eonext_library_staff(array &$variables): void {
  DrupalTyped::service(StaffHooks::class)->preprocessParagraphEonextLibraryStaff($variables);
}

/**
 * Combines forename and surname into one profile link.
 */
#[LegacyHook]
function eonext_staff_preprocess_views_view_field(array &$variables): void {
  DrupalTyped::service(StaffHooks::class)->preprocessViewsViewField($variables);
}

/**
 * Deletes staff entities that belong to a user being deleted.
 */
#[LegacyHook]
function eonext_staff_user_predelete(UserInterface $account): void {
  DrupalTyped::service(StaffHooks::class)->userPredelete($account);
}
