{#
/**
 * @file
 * Shared lokale image carousel.
 *
 * Variables: images[], name, url (optional link target for the gallery)
 */
#}
<div class="ek-lokale-carousel" data-lokale-carousel>
  {% if url %}
    <a href="{{ url }}" class="ek-lokale-carousel__link" aria-label="{{ name }}">
  {% endif %}
  <div class="ek-lokale-carousel__track" data-lokale-track>
    {% for image in images %}
      <div class="ek-lokale-carousel__slide">
        <img class="ek-lokale-carousel__img" src="{{ image.src }}" alt="{{ image.alt|default(name) }}" loading="lazy">
      </div>
    {% endfor %}
  </div>
  {% if url %}
    </a>
  {% endif %}
  {% if images|length > 1 %}
    <button type="button" class="ek-lokale-carousel__nav ek-lokale-carousel__nav--prev" data-lokale-prev aria-label="{{ 'Previous image'|t }}">
      <svg class="ek-lokale-carousel__nav-icon" viewBox="7 4 9 16" aria-hidden="true" focusable="false">
        <path d="M16 20 7 12l9-8" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button type="button" class="ek-lokale-carousel__nav ek-lokale-carousel__nav--next" data-lokale-next aria-label="{{ 'Next image'|t }}">
      <svg class="ek-lokale-carousel__nav-icon" viewBox="8 4 9 16" aria-hidden="true" focusable="false">
        <path d="M8 4l9 8-9 8" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  {% endif %}
</div>
