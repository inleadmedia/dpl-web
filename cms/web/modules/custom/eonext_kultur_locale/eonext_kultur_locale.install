<?php

/**
 * @file
 * Install, update and uninstall functions for EO Next Kultur Locale.
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;
use Drupal\eonext_kultur_locale\LokaleConstants;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_install().
 */
function eonext_kultur_locale_install(): void {
  _eonext_kultur_locale_enable_paragraph_on_page(LokaleConstants::PARAGRAPH_BUNDLE);
  _eonext_kultur_locale_enable_paragraph_on_page(LokaleConstants::PAGE_HERO_BUNDLE);
}

/**
 * Add the Bookingbetingelser content field to existing sites.
 */
function eonext_kultur_locale_update_9001(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_locale');
  $storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'field.storage.node.field_booking_betingelser',
    'field.field.node.lokale.field_booking_betingelser',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
      }
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }

  foreach ([
    'core.entity_form_display.node.lokale.default',
    'core.entity_view_display.node.lokale.default',
    'core.entity_view_display.node.lokale.row',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if ($data) {
      \Drupal::configFactory()->getEditable($config_name)->setData($data)->save(TRUE);
    }
  }
}

/**
 * Enable a kultur locale paragraph bundle on page nodes.
 */
function _eonext_kultur_locale_enable_paragraph_on_page(string $bundle): void {
  $field = FieldConfig::loadByName('node', 'page', 'field_paragraphs');
  if (!$field instanceof FieldConfig) {
    return;
  }

  $settings = $field->getSetting('handler_settings');
  $settings['target_bundles'][$bundle] = $bundle;
  $settings['target_bundles_drag_drop'][$bundle] = [
    'weight' => $bundle === LokaleConstants::PAGE_HERO_BUNDLE ? 82 : 81,
    'enabled' => TRUE,
  ];
  $field->setSetting('handler_settings', $settings);
  $field->save();
}

/**
 * Add hero image field to the lokaler listing paragraph.
 */
function eonext_kultur_locale_update_9002(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_locale');
  $storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'field.storage.paragraph.field_locale_hero_image',
    'field.field.paragraph.eonext_kultur_locale_listing.field_locale_hero_image',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
      }
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }

  foreach ([
    'core.entity_form_display.paragraph.eonext_kultur_locale_listing.default',
    'core.entity_view_display.paragraph.eonext_kultur_locale_listing.default',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if ($data) {
      \Drupal::configFactory()->getEditable($config_name)->setData($data)->save(TRUE);
    }
  }
}

/**
 * Switch lokaler listing hero image field from file upload to media.
 */
function eonext_kultur_locale_update_9003(): void {
  $field = FieldConfig::loadByName('paragraph', 'eonext_kultur_locale_listing', 'field_locale_hero_image');
  if ($field instanceof FieldConfig) {
    $field->delete();
  }

  $storage = FieldStorageConfig::loadByName('paragraph', 'field_locale_hero_image');
  if ($storage instanceof FieldStorageConfig) {
    $storage->delete();
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_locale');
  $config_storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'field.storage.paragraph.field_locale_hero_image',
    'field.field.paragraph.eonext_kultur_locale_listing.field_locale_hero_image',
  ] as $config_name) {
    $data = $config_storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
      }
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }

  foreach ([
    'core.entity_form_display.paragraph.eonext_kultur_locale_listing.default',
    'core.entity_view_display.paragraph.eonext_kultur_locale_listing.default',
  ] as $config_name) {
    $data = $config_storage->read($config_name);
    if ($data) {
      \Drupal::configFactory()->getEditable($config_name)->setData($data)->save(TRUE);
    }
  }
}

/**
 * Add the page hero paragraph for kultur content pages.
 */
function eonext_kultur_locale_update_9004(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_locale');
  $storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'paragraphs.paragraphs_type.eonext_kultur_page_hero',
    'field.field.paragraph.eonext_kultur_page_hero.field_locale_hero_image',
    'field.field.paragraph.eonext_kultur_page_hero.field_locale_heading',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'paragraphs.paragraphs_type.')) {
      \Drupal::configFactory()->getEditable($config_name)->setData($data)->save(TRUE);
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }

  foreach ([
    'core.entity_form_display.paragraph.eonext_kultur_page_hero.default',
    'core.entity_view_display.paragraph.eonext_kultur_page_hero.default',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if ($data) {
      \Drupal::configFactory()->getEditable($config_name)->setData($data)->save(TRUE);
    }
  }

  _eonext_kultur_locale_enable_paragraph_on_page(LokaleConstants::PAGE_HERO_BUNDLE);
}
