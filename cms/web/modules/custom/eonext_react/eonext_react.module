<?php

/**
 * @file
 * EO NEXT React module.
 */

use Drupal\eonext_react\InjectedJavascript;

/**
 * Implements hook_library_info_build().
 */
function eonext_react_library_info_build(): array {
  /** @var \Drupal\eonext_react\InjectedJavascript $injected */
  $injected = \Drupal::service('eonext_react.injected_javascript');
  $path = $injected->getPath();

  if (!$path) {
    return [];
  }

  return [
    'injected_javascript' => [
      'js' => [
        $path => [
          'preprocess' => FALSE,
          'weight' => $injected->getWeight(),
        ],
      ],
      'dependencies' => $injected->getLibraryDependencies(),
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function eonext_react_page_attachments(array &$attachments): void {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  $attachments['#cache']['tags'][] = 'config:' . InjectedJavascript::CONFIG_ID;

  if (\Drupal::service('eonext_react.injected_javascript')->exists()) {
    $attachments['#attached']['library'][] = InjectedJavascript::LIBRARY;
  }
}
