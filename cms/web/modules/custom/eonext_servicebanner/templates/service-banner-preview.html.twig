{#
/**
 * @file
 * Admin preview of the service banner.
 *
 * Available variables:
 * - title: The banner title.
 * - body: The banner body text.
 * - url: Optional link URL.
 */
#}
{% if url %}
  <a href="{{ url }}" class="service-banner-preview service-banner-preview--linked">
{% else %}
  <div class="service-banner-preview">
{% endif %}

  <svg class="service-banner-preview__fold" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M24 24V0L0 24H24Z" fill="#DBDBDB"/>
    <path d="M0 0L0 24L24 0L0 0Z" fill="#F6F5F0"/>
  </svg>

  <div class="service-banner-preview__icon">
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M19.9995 5C25.5223 5 29.9995 9.47707 29.9995 14.9999C29.9995 18.1885 29.9995 21.3902 29.9995 23.3333C29.9995 28.3333 33.3328 30 33.3328 30L6.66615 30C6.66615 30 9.99949 28.3333 9.99949 23.3333C9.99949 21.3902 9.99949 18.1885 9.99949 14.9999C9.99949 9.47707 14.4766 5 19.9995 5Z" stroke="black" stroke-width="2" stroke-linejoin="round"/>
      <path d="M16.6666 30C16.6666 31.8409 18.159 33.3333 20 33.3333C21.8409 33.3333 23.3333 31.8409 23.3333 30" stroke="black" stroke-width="2"/>
    </svg>
  </div>

  <div class="service-banner-preview__content">
    <span class="service-banner-preview__title">{{ title }}</span>
    <p class="service-banner-preview__body">{{ body }}</p>
  </div>

  {% if url %}
    <span class="service-banner-preview__arrow" aria-hidden="true">
      <svg width="61" height="9" viewBox="0 0 61 9" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M60.3536 4.85355C60.5488 4.65829 60.5488 4.34171 60.3536 4.14645L57.1716 0.964466C56.9763 0.769204 56.6597 0.769204 56.4645 0.964466C56.2692 1.15973 56.2692 1.47631 56.4645 1.67157L59.2929 4.5L56.4645 7.32843C56.2692 7.52369 56.2692 7.84027 56.4645 8.03553C56.6597 8.2308 56.9763 8.2308 57.1716 8.03553L60.3536 4.85355ZM0 5H60V4H0V5Z" fill="black"/>
      </svg>
    </span>
  {% endif %}

{% if url %}
  </a>
{% else %}
  </div>
{% endif %}
