function eonext_kultur_main_update_9032(): string {
  $messages = _eonext_kultur_main_reapply_eonext_437_site_policy();

  if (\Drupal::moduleHandler()->moduleExists('eonext_kultur_event_submissions')
    && function_exists('eonext_kultur_event_submissions_reapply_eonext_437_fixes')) {
    $messages[] = eonext_kultur_event_submissions_reapply_eonext_437_fixes();
  }

  if (\Drupal::moduleHandler()->moduleExists('eonext_kultur_events')
    && function_exists('eonext_kultur_events_reapply_eonext_437_fixes')) {
    $messages[] = eonext_kultur_events_reapply_eonext_437_fixes();
  }

  return implode(' ', $messages) ?: 'Kulturnat QA site policy was already applied.';
}
