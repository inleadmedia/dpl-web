}

/**
 * Replace per-window nav grid fields with one shared overlay color (EONEXT-321).
 */
function eonext_kultur_main_update_9023(): string {
  return _eonext_kultur_main_migrate_nav_grid_overlay_color_field();
}

/**
 * Creates nav grid per-window override fields from module install config.
 */
function _eonext_kultur_main_ensure_nav_grid_teaser_override_fields(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_main');
  $storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'field.storage.paragraph.field_nav_teaser_title',
    'field.storage.paragraph.field_nav_teaser_teaser_text',
    'field.storage.paragraph.field_nav_teaser_overlay_color',
    'field.field.paragraph.nav_grid_manual.field_nav_teaser_title',
    'field.field.paragraph.nav_grid_manual.field_nav_teaser_teaser_text',
    'field.field.paragraph.nav_grid_manual.field_nav_teaser_overlay_color',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
      }
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }
}

/**
 * Migrates legacy per-window nav grid fields to one shared overlay color field.
 */
function _eonext_kultur_main_migrate_nav_grid_overlay_color_field(): string {
  $messages = [];
  $saved_colors = [];

  if (FieldConfig::loadByName('paragraph', 'nav_grid_manual', 'field_nav_teaser_overlay_color')) {
    $paragraphs = \Drupal::entityTypeManager()
      ->getStorage('paragraph')
      ->loadByProperties(['type' => 'nav_grid_manual']);
    foreach ($paragraphs as $paragraph) {
      if (!$paragraph instanceof ParagraphInterface || $paragraph->get('field_nav_teaser_overlay_color')->isEmpty()) {
        continue;
      }
      $color = $paragraph->get('field_nav_teaser_overlay_color')->first()->color ?? '';
      if (is_string($color) && $color !== '') {
        $saved_colors[$paragraph->id()] = $color;
      }
    }
  }

  _eonext_kultur_main_ensure_nav_grid_overlay_color_field();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  if ($saved_colors !== [] && FieldConfig::loadByName('paragraph', 'nav_grid_manual', 'field_nav_grid_overlay_color')) {
    $paragraphs = \Drupal::entityTypeManager()->getStorage('paragraph')->loadMultiple(array_keys($saved_colors));
    foreach ($paragraphs as $paragraph) {
      if (!$paragraph instanceof ParagraphInterface) {
        continue;
      }
      $paragraph->set('field_nav_grid_overlay_color', ['color' => $saved_colors[$paragraph->id()]]);
      $paragraph->save();
    }
    $messages[] = 'Migrated overlay colors from legacy per-window fields.';
  }

  foreach ([
    'field_nav_teaser_title',
    'field_nav_teaser_teaser_text',
    'field_nav_teaser_overlay_color',
  ] as $field_name) {
    $field = FieldConfig::loadByName('paragraph', 'nav_grid_manual', $field_name);
    if ($field instanceof FieldConfig) {
      $field->delete();
      $messages[] = "Deleted {$field_name}.";
    }

    $storage = FieldStorageConfig::loadByName('paragraph', $field_name);
    if ($storage instanceof FieldStorageConfig) {
      $storage->delete();
    }
  }

  _eonext_kultur_main_configure_nav_grid_form_display();
  $messages[] = 'Nav grid now uses one shared overlay color field for all windows.';

  return implode(' ', $messages);
}

/**
 * Creates the shared nav grid overlay color field from module install config.
 */
function _eonext_kultur_main_ensure_nav_grid_overlay_color_field(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_main');
  $storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'field.storage.paragraph.field_nav_grid_overlay_color',
    'field.field.paragraph.nav_grid_manual.field_nav_grid_overlay_color',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
      }
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }
}

