  return 'Content slider logo field now uses the small_preview image style in the edit form.';
}

/**
 * Creates nav spot paragraph fields from sync config when missing locally.
 */
function _eonext_kultur_main_ensure_nav_spot_fields(): void {
  $sync = \Drupal::service('config.storage.sync');

  foreach ([
    'field.storage.paragraph.field_nav_spot_button_label',
    'field.storage.paragraph.field_nav_spot_image_alignment',
    'field.storage.paragraph.field_nav_spot_background_color',
  ] as $config_name) {
    $data = $sync->read($config_name);
    if (!$data || FieldStorageConfig::load($data['id'])) {
      continue;
    }

    if (($data['type'] ?? '') === 'list_string' && !empty($data['settings']['allowed_values'])) {
      $allowed_values = [];
      foreach ($data['settings']['allowed_values'] as $item) {
        if (!is_array($item) || !isset($item['value'], $item['label'])) {
          continue;
        }
        $allowed_values[$item['value']] = $item['label'];
      }
      $data['settings']['allowed_values'] = $allowed_values;
    }

    FieldStorageConfig::create($data)->save();
  }

  foreach ([
    'field.field.paragraph.nav_spots_manual.field_nav_spot_button_label',
    'field.field.paragraph.nav_spots_manual.field_nav_spot_image_alignment',
    'field.field.paragraph.nav_spots_manual.field_nav_spot_background_color',
  ] as $config_name) {
    $data = $sync->read($config_name);
    if (!$data || FieldConfig::load($data['id'])) {
      continue;
    }

    FieldConfig::create($data)->save();
  }
}

/**
 * Enable per-language text body paragraphs and repair wrong default languages.
 */
function eonext_kultur_main_update_9027(): string {
  return _eonext_kultur_main_enable_text_body_translation();
}

/**
 * Makes text body translatable and fixes paragraphs saved in the wrong language.
 */
function _eonext_kultur_main_enable_text_body_translation(): string {
  $messages = [];

  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return 'Content translation is not enabled; skipped text body translation setup.';
  }

  $manager = \Drupal::service('content_translation.manager');
  if (!$manager->isEnabled('paragraph', 'text_body')) {
    $manager->setEnabled('paragraph', 'text_body', TRUE);
    $messages[] = 'Enabled content translation for text body paragraphs.';
  }

  $language_settings = ContentLanguageSettings::load('paragraph.text_body');
  if (!$language_settings instanceof ContentLanguageSettings) {
    $language_settings = ContentLanguageSettings::create([
      'target_entity_type_id' => 'paragraph',
      'target_bundle' => 'text_body',
    ]);
  }
  $changed = FALSE;
  if ($language_settings->getDefaultLangcode() !== 'da') {
    $language_settings->setDefaultLangcode('da');
    $changed = TRUE;
    $messages[] = 'Set text body paragraph default language to Danish.';
  }
  if (!$language_settings->isLanguageAlterable()) {
    $language_settings->setLanguageAlterable(TRUE);
    $changed = TRUE;
    $messages[] = 'Made text body paragraph language alterable for content translation.';
  }
  if ($changed) {
    $language_settings->save();
  }

  $field = FieldConfig::loadByName('paragraph', 'text_body', 'field_body');
  if ($field instanceof FieldConfig && !$field->isTranslatable()) {
    $field->setTranslatable(TRUE);
    $field->save();
    $messages[] = 'Made text body field translatable.';
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  $repaired = _eonext_kultur_main_repair_text_body_paragraph_languages();
  if ($repaired > 0) {
    $messages[] = "Repaired {$repaired} text body paragraph(s) with a non-Danish default language.";
  }

  return implode(' ', $messages) ?: 'Text body translation is already configured.';
}

/**
 * Moves mis-labeled paragraph defaults to Danish and preserves body as translation.
 */
function _eonext_kultur_main_repair_text_body_paragraph_languages(): int {
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'text_body')
    ->execute();

  if ($ids === []) {
    return 0;
  }

  $repaired = 0;
  foreach ($storage->loadMultiple($ids) as $paragraph) {
    if (!$paragraph instanceof ParagraphInterface) {
      continue;
    }

    $parent = $paragraph->getParentEntity();
    if (!$parent instanceof NodeInterface || !in_array($parent->bundle(), ['page', 'article'], TRUE)) {
      continue;
    }

    $target_langcode = 'da';
    $settings = ContentLanguageSettings::load('node.' . $parent->bundle());
    if ($settings instanceof ContentLanguageSettings) {
      $configured_default = $settings->getDefaultLangcode();
      if (is_string($configured_default) && $configured_default !== '') {
        $target_langcode = $configured_default;
      }
    }

    if (_eonext_kultur_main_repair_single_text_body_paragraph($paragraph, $target_langcode)) {
      $repaired++;
    }
  }

  return $repaired;
}

/**
 * Reassigns a single-language text body paragraph default langcode on its host node.
 */
function _eonext_kultur_main_repair_single_text_body_paragraph(ParagraphInterface $paragraph, string $target_langcode): bool {
  if ($paragraph->bundle() !== 'text_body') {
    return FALSE;
  }

  if (count($paragraph->getTranslationLanguages()) > 1) {
    return FALSE;
  }

  $source_langcode = $paragraph->language()->getId();
  if ($source_langcode === $target_langcode) {
    return FALSE;
  }

  $body = $paragraph->get('field_body')->getValue();
  $id = (int) $paragraph->id();
  if ($id === 0) {
    return FALSE;
  }

  $connection = \Drupal::database();
  foreach (['paragraphs_item_field_data', 'paragraphs_item_revision_field_data'] as $table) {
    $connection->update($table)
      ->fields(['langcode' => $target_langcode])
      ->condition('id', $id)
      ->condition('default_langcode', 1)
      ->execute();
  }

  \Drupal::entityTypeManager()->getStorage('paragraph')->resetCache([$id]);
  $paragraph = Paragraph::load($id);
  if (!$paragraph instanceof ParagraphInterface) {
    return FALSE;
  }

  $paragraph->set('field_body', []);
  $paragraph->save();

  if ($body !== []) {
    $paragraph->addTranslation($source_langcode, ['field_body' => $body]);
    $paragraph->save();
  }

  return TRUE;
}

/**
 * Enables translations for event category taxonomy terms (Kulturnat).
 */
function eonext_kultur_main_update_9028(): string {
  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return 'Content translation is not enabled; skipped category translation setup.';
  }

  $messages = [];
  $manager = \Drupal::service('content_translation.manager');
  if (!$manager->isEnabled('taxonomy_term', 'categories')) {
    $manager->setEnabled('taxonomy_term', 'categories', TRUE);
    $messages[] = 'Enabled content translation for categories taxonomy terms.';
  }

  $language_settings = ContentLanguageSettings::load('taxonomy_term.categories');
  if (!$language_settings instanceof ContentLanguageSettings) {
    $language_settings = ContentLanguageSettings::create([
      'target_entity_type_id' => 'taxonomy_term',
      'target_bundle' => 'categories',
    ]);
  }
  if ($language_settings->getDefaultLangcode() !== 'da') {
    $language_settings->setDefaultLangcode('da');
  }
  $language_settings->setLanguageAlterable(TRUE);
  $language_settings->save();
  $messages[] = 'Categories can now be translated (da/kl).';

  $messages = array_merge($messages, _eonext_kultur_main_grant_kulturnat_translation_permissions());

  return implode(' ', $messages) ?: 'Category translation is already configured.';
}

/**
 * QA follow-ups (EONEXT-437): login, mail, footer translation, theme favicon access.
 */
function eonext_kultur_main_update_9029(): string {
  $messages = [];

  if (\Drupal::moduleHandler()->moduleExists('openid_connect')) {
    $openid = \Drupal::configFactory()->getEditable('openid_connect.settings');
    if ($openid->get('user_login_display') !== 'hidden') {
      $openid->set('user_login_display', 'hidden')->save();
      $messages[] = 'Hid OpenID Connect / library login on the user login form.';
    }
  }

  $messages = array_merge($messages, _eonext_kultur_main_configure_kulturnat_mail_transport());

  if (\Drupal::moduleHandler()->moduleExists('content_translation')) {
    $manager = \Drupal::service('content_translation.manager');
    $bundle = FooterSocialLoader::PARAGRAPH_BUNDLE;
    if (!$manager->isEnabled('paragraph', $bundle)) {
      $manager->setEnabled('paragraph', $bundle, TRUE);
      $messages[] = 'Enabled translation for Kultur footer social paragraph.';
    }

    $language_settings = ContentLanguageSettings::load("paragraph.{$bundle}");
    if (!$language_settings instanceof ContentLanguageSettings) {
      $language_settings = ContentLanguageSettings::create([
        'target_entity_type_id' => 'paragraph',
        'target_bundle' => $bundle,
      ]);
    }
    $language_settings->setDefaultLangcode('da');
    $language_settings->setLanguageAlterable(TRUE);
    $language_settings->save();

    foreach ([
      'field_kultur_footer_title',
      'field_kultur_footer_text',
      'field_kultur_footer_cta',
      'field_kultur_footer_hashtag',
    ] as $field_name) {
      $field = FieldConfig::loadByName('paragraph', $bundle, $field_name);
      if ($field instanceof FieldConfig && !$field->isTranslatable()) {
        $field->setTranslatable(TRUE);
        $field->save();
        $messages[] = "Made {$field_name} translatable on footer social paragraph.";
      }
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('eonext_kultur_events')) {
    eonext_kultur_events_ensure_text_body_paragraph_reference_allowed();
    $messages[] = 'Ensured text_body paragraphs can be referenced on event fields (content lock save fix).';
  }

  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('local_administrator');
  if ($role !== NULL && \Drupal::moduleHandler()->moduleExists('theme_permission')) {
    $permission = 'administer theme global settings';
    if (!$role->hasPermission($permission)) {
      $role->grantPermission($permission);
      $role->save();
      $messages[] = 'Granted theme global settings to local administrators (favicon/branding).';
    }
  }

  return implode(' ', $messages) ?: 'QA site configuration was already applied.';
}

/**
 * Switches submission mail away from Azure when symfony_mailer is available.
 */
function eonext_kultur_main_update_9030(): string {
  if (!\Drupal::moduleHandler()->moduleExists('mailsystem') || !\Drupal::moduleHandler()->moduleExists('symfony_mailer')) {
    return 'symfony_mailer is not available; skipped mail transport update.';
  }

  $mail_config = \Drupal::configFactory()->getEditable('mailsystem.settings');
  $mail_config->set('defaults', [
    'formatter' => 'symfony_mailer',
    'sender' => 'symfony_mailer',
  ]);
  $mail_config->set('modules.eonext_kultur_event_submissions', [
    'formatter' => 'symfony_mailer',
    'sender' => 'symfony_mailer',
  ]);
  $mail_config->save();

  return 'Configured mailsystem to use symfony_mailer (Mailpit on DDEV).';
}

/**
 * Points the active theme favicon at the bundled Kulturnat icon (theme settings).
 */
function eonext_kultur_main_update_9031(): string {
  $theme = 'eonext_kultur';
  if (!\Drupal::service('theme_handler')->themeExists($theme)) {
    return 'eonext_kultur theme is not installed; skipped favicon configuration.';
  }

  $config = \Drupal::configFactory()->getEditable("{$theme}.settings");
  if (!$config->get('features.favicon')) {
    $config->set('features.favicon', TRUE);
  }

  $custom_path = $config->get('favicon.path');
  $use_default = (bool) $config->get('favicon.use_default');
  if (!$use_default && is_string($custom_path) && $custom_path !== '') {
    return 'Kulturnat favicon is already set in theme settings.';
  }

  $path = \Drupal::service('extension.list.theme')->getPath($theme);
  $config->set('favicon.use_default', FALSE);
  $config->set('favicon.path', $path . '/images/logo.png');
  $config->set('favicon.mimetype', 'image/png');
  $config->save();

  return 'Set Kulturnat favicon via theme settings (bundled images/logo.png).';
}

/**
 * Grants translation permissions to Kulturnat editorial roles.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_grant_kulturnat_translation_permissions(): array {
  $messages = [];
  $permissions = [
    'translate any entity',
    'translate configuration',
    'create content translations',
    'update content translations',
    'delete content translations',
  ];

  foreach (['administrator', 'editor', 'local_administrator'] as $role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    if ($role === NULL) {
      continue;
    }

    $changed = FALSE;
    foreach ($permissions as $permission) {
      if (!$role->hasPermission($permission)) {
        $role->grantPermission($permission);
        $changed = TRUE;
      }
    }

    if ($changed) {
      $role->save();
      $messages[] = "Granted translation permissions to {$role_id}.";
    }
  }

  return $messages;
}

/**
 * Configures mailsystem for Kulturnat submission mail (idempotent).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_configure_kulturnat_mail_transport(): array {
  if (!\Drupal::moduleHandler()->moduleExists('mailsystem')) {
    return [];
  }

  $mail_config = \Drupal::configFactory()->getEditable('mailsystem.settings');
  $handler = \Drupal::moduleHandler();
  if ($handler->moduleExists('sparkpost')) {
    $transport = 'sparkpost_mail';
  }
  elseif ($handler->moduleExists('symfony_mailer')) {
    $transport = 'symfony_mailer';
  }
  else {
    $transport = 'php_mail';
  }
  $changed = FALSE;

  $defaults = $mail_config->get('defaults') ?? [];
  if (($defaults['sender'] ?? '') !== $transport || ($defaults['formatter'] ?? '') !== $transport) {
    $mail_config->set('defaults', [
      'formatter' => $transport,
      'sender' => $transport,
    ]);
    $changed = TRUE;
  }

  $module_mail = $mail_config->get('modules.eonext_kultur_event_submissions') ?? [];
  if (($module_mail['sender'] ?? '') !== $transport || ($module_mail['formatter'] ?? '') !== $transport) {
    $mail_config->set('modules.eonext_kultur_event_submissions', [
      'formatter' => $transport,
      'sender' => $transport,
    ]);
    $changed = TRUE;
  }

  if ($changed) {
    $mail_config->save();
    return ["Configured mailsystem to use {$transport} for submission emails."];
  }

  return [];
}

/**
 * Ensures Kulturnat editorial languages exist (Kalaallisut for translations).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_apply_kulturnat_config_ignore(): array {
  $dir = dirname(DRUPAL_ROOT) . '/scripts';
  $merge = $dir . '/kulturnat-config-ignore-merge.php';
  $patterns_file = $dir . '/kulturnat-config-ignore-patterns.php';
  if (!is_file($merge) || !is_file($patterns_file)) {
    return ['Kulturnat config ignore scripts not found; skipped.'];
  }

  require_once $merge;
  /** @var array{patterns: string[], remove_from_auto: string[]} $data */
  $data = require $patterns_file;
  kulturnat_config_ignore_merge_patterns($data['patterns'], $data['remove_from_auto']);

  return ['Merged Kulturnat config_ignore patterns (' . count($data['patterns']) . ').'];
}

/**
 * Enables content translation (runtime only — not exported in DPL sync).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_ensure_content_translation_module(): array {
  if (\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return [];
  }

  try {
    \Drupal::service('module_installer')->install(['content_translation']);
    return ['Enabled content_translation module.'];
  }
  catch (\Throwable $exception) {
    return ['Could not enable content_translation: ' . $exception->getMessage()];
  }
}

/**
 * Ensures Kulturnat editorial languages exist (Kalaallisut for translations).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_ensure_kulturnat_languages(): array {
  $messages = [];

  if (ConfigurableLanguage::load('kl') === NULL) {
    ConfigurableLanguage::createFromLangcode('kl')->save();
    $messages[] = 'Created Kalaallisut (kl) language.';
  }

  return $messages;
}

/**
 * Kulturnat URL prefixes: unprefixed default (da) and /kl for Kalaallisut.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_configure_kulturnat_url_prefixes(): array {
  $messages = [];

  $negotiation = \Drupal::configFactory()->getEditable('language.negotiation');
  $prefixes = $negotiation->get('url.prefixes') ?? [];
  $domains = $negotiation->get('url.domains') ?? [];
  $default_langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();

  $changed = FALSE;

  // DPL sync sometimes ships '' => null alongside da/en — breaks prefix detection.
  if (array_key_exists('', $prefixes)) {
    unset($prefixes['']);
    $changed = TRUE;
    $messages[] = 'Removed invalid empty langcode key from language.negotiation prefixes.';
  }

  foreach (\Drupal::languageManager()->getLanguages() as $langcode => $language) {
    if (!array_key_exists($langcode, $domains)) {
      $domains[$langcode] = '';
      $changed = TRUE;
    }
  }

  $target_default_prefix = '';
  if (($prefixes[$default_langcode] ?? NULL) !== $target_default_prefix) {
    $prefixes[$default_langcode] = $target_default_prefix;
    $changed = TRUE;
    $messages[] = "Default language ($default_langcode) uses unprefixed URLs.";
  }

  if (\Drupal::languageManager()->getLanguage('kl') !== NULL && ($prefixes['kl'] ?? NULL) !== 'kl') {
    $prefixes['kl'] = 'kl';
    $changed = TRUE;
    $messages[] = 'Configured /kl URL prefix.';
  }

  if ($changed) {
    $negotiation
      ->set('url.prefixes', $prefixes)
      ->set('url.domains', $domains)
      ->save();
  }

  return $messages;
}

/**
 * Enables URL path negotiation so switcher links differ (/ vs /kl).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_configure_kulturnat_language_url_negotiation(): array {
  $messages = [];

  $config = \Drupal::configFactory()->getEditable('language.types');
  $enabled = $config->get('negotiation.language_interface.enabled') ?? [];
  $weights = $config->get('negotiation.language_interface.method_weights') ?? [];

  $changed = FALSE;
  if (!isset($enabled['language-url'])) {
    $enabled['language-url'] = -8;
    $changed = TRUE;
    $messages[] = 'Enabled language-url negotiation for interface language.';
  }
  elseif ((int) $enabled['language-url'] !== -8) {
    $enabled['language-url'] = -8;
    $changed = TRUE;
  }

  if (($weights['language-url'] ?? NULL) !== -8) {
    $weights['language-url'] = -8;
    $changed = TRUE;
  }

  if ($changed) {
    asort($enabled, SORT_NUMERIC);
    $config
      ->set('negotiation.language_interface.enabled', $enabled)
      ->set('negotiation.language_interface.method_weights', $weights)
      ->save();
  }

  return $messages;
}

/**
 * Header language switcher: Drupal da/kl (not Google Translate).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_configure_eonext_translation_switcher(): array {
  if (!\Drupal::moduleHandler()->moduleExists('eonext_translation')) {
    return [];
  }

  $messages = array_merge(
    _eonext_kultur_main_ensure_kulturnat_languages(),
    _eonext_kultur_main_configure_kulturnat_url_prefixes(),
    _eonext_kultur_main_configure_kulturnat_language_url_negotiation(),
  );
  $editable = \Drupal::configFactory()->getEditable('eonext_translation.settings');
  $changed = FALSE;

  if (($editable->get('translation_type') ?? '') !== 'drupal_translate') {
    $editable->set('translation_type', 'drupal_translate');
    $changed = TRUE;
    $messages[] = 'Header: use Drupal language switcher (not Google Translate).';
  }

  $wanted = [];
  foreach (['da', 'kl'] as $langcode) {
    if (\Drupal::languageManager()->getLanguage($langcode) !== NULL) {
      $wanted[] = $langcode;
    }
  }
  $current = array_values($editable->get('drupal_translation_available_languages') ?: []);
  sort($current);
  sort($wanted);
  if ($wanted !== [] && $current !== $wanted) {
    $editable->set('drupal_translation_available_languages', $wanted);
    $changed = TRUE;
    $messages[] = 'Header languages: ' . implode(', ', $wanted) . '.';
  }

  if ($changed) {
    $editable->save();
  }

  return $messages;
}

/**
 * Applies Kulturnat translation + kl policy (update hooks / post-cim reapply).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_apply_kulturnat_translation_runtime(): array {
  return array_merge(
    _eonext_kultur_main_apply_kulturnat_config_ignore(),
    _eonext_kultur_main_ensure_content_translation_module(),
    _eonext_kultur_main_ensure_kulturnat_languages(),
    _eonext_kultur_main_configure_eonext_translation_switcher(),
    _eonext_kultur_main_ensure_footer_translation_config(),
    _eonext_kultur_main_enable_kulturnat_content_translation_bundles(),
    _eonext_kultur_main_enable_kulturnat_editorial_translation_fields(),
    _eonext_kultur_main_grant_kulturnat_translation_permissions(),
  );
}

/**
 * Kulturnat editorial translation: per-language node fields + shared paragraphs.
 *
 * Paragraph lists (field_paragraphs / field_event_paragraphs) stay shared across
 * node translations; editors translate text on each paragraph entity (e.g.
 * text_body.field_body). Matches event publisher behaviour and editor expectation.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_enable_kulturnat_editorial_translation_fields(): array {
  $messages = [];

  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return ['Content translation module is not enabled.'];
  }

  $node_fields = [
    'field_subtitle',
    'field_teaser_text',
    'field_teaser_image',
    'field_hero_title',
  ];
  foreach (['page', 'article'] as $bundle) {
    foreach ($node_fields as $field_name) {
      if (_eonext_kultur_main_set_field_translatable('node', $bundle, $field_name)) {
        $messages[] = "Made node.{$bundle}.{$field_name} translatable.";
      }
    }
    if (_eonext_kultur_main_set_field_non_translatable('node', $bundle, 'field_paragraphs')) {
      $messages[] = "Made node.{$bundle}.field_paragraphs shared (non-translatable).";
    }
    $messages = array_merge($messages, _eonext_kultur_main_enable_paragraph_bundles_for_field('node', $bundle, 'field_paragraphs'));
  }

  $event_fields = [
    'field_teaser_text',
    'field_teaser_image',
  ];
  foreach (['eventseries', 'eventinstance'] as $entity_type) {
    if (!\Drupal::moduleHandler()->moduleExists('recurring_events')) {
      break;
    }
    foreach ($event_fields as $field_name) {
      if (_eonext_kultur_main_set_field_translatable($entity_type, 'default', $field_name)) {
        $messages[] = "Made {$entity_type}.default.{$field_name} translatable.";
      }
    }
    if (_eonext_kultur_main_set_field_non_translatable($entity_type, 'default', 'field_event_paragraphs')) {
      $messages[] = "Made {$entity_type}.default.field_event_paragraphs shared (non-translatable).";
    }
    $messages = array_merge(
      $messages,
      _eonext_kultur_main_enable_paragraph_bundles_for_field($entity_type, 'default', 'field_event_paragraphs'),
    );
  }

  $text_body_message = _eonext_kultur_main_enable_text_body_translation();
  if ($text_body_message !== 'Text body translation is already configured.') {
    $messages[] = $text_body_message;
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  return $messages;
}

/**
 * Sets a field configurable as translatable when it exists and is off.
 */
function _eonext_kultur_main_set_field_translatable(string $entity_type, string $bundle, string $field_name): bool {
  $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
  if (!$field instanceof FieldConfig || $field->isTranslatable()) {
    return FALSE;
  }
  $field->setTranslatable(TRUE);
  $field->save();
  return TRUE;
}

/**
 * Sets a field as non-translatable when it exists and is currently translatable.
 */
function _eonext_kultur_main_set_field_non_translatable(string $entity_type, string $bundle, string $field_name): bool {
  $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
  if (!$field instanceof FieldConfig || !$field->isTranslatable()) {
    return FALSE;
  }
  $field->setTranslatable(FALSE);
  $field->save();
  return TRUE;
}

/**
 * Enables content translation on paragraph bundles allowed in a paragraphs field.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_enable_paragraph_bundles_for_field(string $entity_type, string $bundle, string $field_name): array {
  $messages = [];
  $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
  if (!$field instanceof FieldConfig) {
    return $messages;
  }

  $target_bundles = $field->getSetting('handler_settings')['target_bundles'] ?? [];
  if (!is_array($target_bundles)) {
    return $messages;
  }

  $manager = \Drupal::service('content_translation.manager');
  foreach (array_keys($target_bundles) as $paragraph_bundle) {
    if (!$manager->isEnabled('paragraph', $paragraph_bundle)) {
      try {
        $manager->setEnabled('paragraph', $paragraph_bundle, TRUE);
        $messages[] = "Enabled content translation for paragraph.{$paragraph_bundle}.";
      }
      catch (\Throwable) {
        continue;
      }
    }

    $config_name = "paragraph.{$paragraph_bundle}";
    $language_settings = ContentLanguageSettings::load($config_name);
    if (!$language_settings instanceof ContentLanguageSettings) {
      $language_settings = ContentLanguageSettings::create([
        'target_entity_type_id' => 'paragraph',
        'target_bundle' => $paragraph_bundle,
      ]);
      $language_settings->setDefaultLangcode('da');
      $language_settings->setLanguageAlterable(TRUE);
      $language_settings->save();
      $messages[] = "Created language settings for {$config_name}.";
    }
    elseif (!$language_settings->isLanguageAlterable()) {
      $language_settings->setLanguageAlterable(TRUE);
      $language_settings->save();
      $messages[] = "Made {$config_name} language alterable.";
    }
  }

  return $messages;
}

/**
 * Ensures translatable footer config exists (dpl_footer → eonext_translation.footer).
 *
 * Without this object, /admin/structure/footer/translate fails config validation.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_ensure_footer_translation_config(): array {
  if (!\Drupal::moduleHandler()->moduleExists('eonext_translation')) {
    return [];
  }

  \Drupal::moduleHandler()->loadInclude('eonext_translation', 'install');
  if (!function_exists('_eonext_translation_ensure_footer_config')) {
    return [];
  }

  $message = _eonext_translation_ensure_footer_config();
  if ($message === 'eonext_translation.footer already present.') {
    return [];
  }

  return [$message];
}

/**
 * Enables Kulturnat content translation on editorial bundles (da/kl UI).
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_enable_kulturnat_content_translation_bundles(): array {
  $messages = [];

  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return ['Content translation module is not enabled.'];
  }

  $manager = \Drupal::service('content_translation.manager');
  $bundles = [
    ['node', 'page'],
    ['node', 'article'],
    ['node', 'lokale'],
    ['taxonomy_term', 'categories'],
    ['taxonomy_term', 'tags'],
    ['eventinstance', 'default'],
    ['eventseries', 'default'],
    ['paragraph', 'text_body'],
    ['paragraph', FooterSocialLoader::PARAGRAPH_BUNDLE],
  ];

  foreach ($bundles as [$entity_type, $bundle]) {
    $handler = \Drupal::moduleHandler();
    if (in_array($entity_type, ['eventinstance', 'eventseries'], TRUE) && !$handler->moduleExists('recurring_events')) {
      continue;
    }
    if ($entity_type === 'paragraph' && !$handler->moduleExists('paragraphs')) {
      continue;
    }
    $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo($entity_type);
    if (!isset($bundle_info[$bundle])) {
      continue;
    }

    if (!$manager->isEnabled($entity_type, $bundle)) {
      try {
        $manager->setEnabled($entity_type, $bundle, TRUE);
        $messages[] = "Enabled content translation for {$entity_type}.{$bundle}.";
      }
      catch (\Throwable) {
        continue;
      }
    }

    $config_name = "{$entity_type}.{$bundle}";
    $language_settings = ContentLanguageSettings::load($config_name);
    if (!$language_settings instanceof ContentLanguageSettings) {
      $language_settings = ContentLanguageSettings::create([
        'target_entity_type_id' => $entity_type,
        'target_bundle' => $bundle,
      ]);
    }
    if ($language_settings->getDefaultLangcode() !== 'da') {
      $language_settings->setDefaultLangcode('da');
    }
    if (!$language_settings->isLanguageAlterable()) {
      $language_settings->setLanguageAlterable(TRUE);
      $messages[] = "Made {$config_name} language alterable.";
    }
    $language_settings->save();
  }

  return $messages;
}

/**
 * Re-applies Kulturnat site policy (login, mail, translation, favicon, modules).
 *
 * Safe to run after deploy, config import, or a DPL platform upgrade that
 * overwrote roles, mailsystem, or OpenID settings.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_reapply_eonext_437_site_policy(): array {
  $messages = _eonext_kultur_main_apply_kulturnat_translation_runtime();

  if (\Drupal::moduleHandler()->moduleExists('openid_connect')) {
    $openid = \Drupal::configFactory()->getEditable('openid_connect.settings');
    if ($openid->get('user_login_display') !== 'hidden') {
      $openid->set('user_login_display', 'hidden')->save();
      $messages[] = 'Hid OpenID Connect / library login on the user login form.';
    }
  }

  $messages = array_merge($messages, _eonext_kultur_main_configure_kulturnat_mail_transport());

  if (\Drupal::moduleHandler()->moduleExists('content_translation')) {
    $bundle = FooterSocialLoader::PARAGRAPH_BUNDLE;
    foreach ([
      'field_kultur_footer_title',
      'field_kultur_footer_text',
      'field_kultur_footer_cta',
      'field_kultur_footer_hashtag',
    ] as $field_name) {
      $field = FieldConfig::loadByName('paragraph', $bundle, $field_name);
      if ($field instanceof FieldConfig && !$field->isTranslatable()) {
        $field->setTranslatable(TRUE);
        $field->save();
        $messages[] = "Made {$field_name} translatable on footer social paragraph.";
      }
    }
  }

  foreach (['administrator', 'local_administrator'] as $role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    if ($role === NULL || !\Drupal::moduleHandler()->moduleExists('theme_permission')) {
      continue;
    }
    $permission = 'administer theme global settings';
    if (!$role->hasPermission($permission)) {
      $role->grantPermission($permission);
      $role->save();
      $messages[] = "Granted theme global settings to {$role_id}.";
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('eonext_kultur_events') && function_exists('eonext_kultur_events_ensure_text_body_paragraph_reference_allowed')) {
    eonext_kultur_events_ensure_text_body_paragraph_reference_allowed();
    $messages[] = 'Ensured text_body paragraphs can be referenced on event fields.';
  }

  $theme = 'eonext_kultur';
  if (\Drupal::service('theme_handler')->themeExists($theme)) {
    $config = \Drupal::configFactory()->getEditable("{$theme}.settings");
    $needs_favicon = (bool) $config->get('favicon.use_default')
      || !is_string($config->get('favicon.path'))
      || $config->get('favicon.path') === '';
    if ($needs_favicon) {
      $path = \Drupal::service('extension.list.theme')->getPath($theme);
      $config->set('features.favicon', TRUE);
      $config->set('favicon.use_default', FALSE);
      $config->set('favicon.path', $path . '/images/logo.png');
      $config->set('favicon.mimetype', 'image/png');
      $config->save();
      $messages[] = 'Set Kulturnat favicon in theme settings.';
    }
  }

  $messages = array_merge($messages, _eonext_kultur_main_uninstall_optional_library_modules());

  return $messages;
}

/**
 * Uninstalls DPL library modules not used on Kulturnat when safe to do so.
 *
 * @return string[]
 *   Status messages.
 */
function _eonext_kultur_main_uninstall_optional_library_modules(): array {
  $messages = [];
  // bnf_client must go before bnf (BnfImporter lives in bnf).
  $modules = ['bnf_client', 'bnf', 'dpl_biblio', 'dpl_go'];
  $installer = \Drupal::service('module_installer');
  $handler = \Drupal::moduleHandler();

  foreach ($modules as $module) {
    if (!$handler->moduleExists($module)) {
      continue;
    }
    try {
      $installer->uninstall([$module], FALSE);
      $messages[] = "Uninstalled {$module}.";
    }
    catch (\Throwable $exception) {
      $messages[] = "Could not uninstall {$module}: {$exception->getMessage()}";
    }
  }

  return $messages;
}

/**
 * Ensures Kalaallisut language exists (fixes content admin when kl translations exist).
 */
function eonext_kultur_main_update_9034(): string {
  return implode(' ', _eonext_kultur_main_ensure_kulturnat_languages())
    ?: 'Kalaallisut (kl) language was already enabled.';
}

/**
 * Ensures administrator/editor roles can translate content after config import.
 */
function eonext_kultur_main_update_9033(): string {
  $messages = _eonext_kultur_main_enable_kulturnat_content_translation_bundles();
  $messages = array_merge($messages, _eonext_kultur_main_grant_kulturnat_translation_permissions());

  return implode(' ', $messages) ?: 'Kulturnat content translation access was already configured.';
}

/**
 * Runtime translation + kl + config_ignore (not in config/sync — survives DPL cim).
 */
function eonext_kultur_main_update_9035(): string {
  $messages = _eonext_kultur_main_apply_kulturnat_translation_runtime();

  return implode(' ', $messages) ?: 'Kulturnat translation runtime policy was already applied.';
}

/**
 * Re-applies da/kl + submission mail transport (SparkPost) after deploy.
 */
function eonext_kultur_main_update_9036(): string {
  $messages = _eonext_kultur_main_ensure_kulturnat_languages();
  $messages = array_merge($messages, _eonext_kultur_main_configure_eonext_translation_switcher());
  $messages = array_merge($messages, _eonext_kultur_main_configure_kulturnat_mail_transport());

  if (\Drupal::moduleHandler()->moduleExists('eonext_kultur_event_submissions')) {
    \Drupal::moduleHandler()->loadInclude('eonext_kultur_event_submissions', 'install');
    if (function_exists('eonext_kultur_event_submissions_reapply_eonext_437_fixes')) {
      $messages[] = eonext_kultur_event_submissions_reapply_eonext_437_fixes();
    }
  }

  return implode(' ', $messages)
    ?: 'Kulturnat languages and submission mail transport were already configured.';
}

/**
 * URL prefixes and language-url negotiation for header language switcher.
 */
function eonext_kultur_main_update_9037(): string {
  $messages = array_merge(
    _eonext_kultur_main_configure_kulturnat_url_prefixes(),
    _eonext_kultur_main_configure_kulturnat_language_url_negotiation(),
  );

  return implode(' ', $messages)
    ?: 'Kulturnat URL language negotiation was already configured.';
}

