/**
 * Exposes the slider logo on the paragraph edit form.
 */
function _eonext_kultur_main_configure_slider_logo_form_display(): void {
  if (!FieldConfig::loadByName('paragraph', 'content_slider', 'field_kultur_slider_logo')) {
    return;
  }

  $form_display = EntityFormDisplay::load('paragraph.content_slider.default');
  if ($form_display instanceof EntityFormDisplay) {
    $form_display->setComponent('field_kultur_slider_logo', [
      'type' => 'image_image',
      'weight' => -4,
      'region' => 'content',
      'settings' => [
        'progress_indicator' => 'throbber',
        'preview_image_style' => 'small_preview',
      ],
      'third_party_settings' => [],
    ])->save();
  }

  // The slider template renders the logo itself.
  $view_display = EntityViewDisplay::load('paragraph.content_slider.default');
  if ($view_display instanceof EntityViewDisplay) {
    $view_display->removeComponent('field_kultur_slider_logo')->save();
  }
}

