<?php

/**
 * @file
 * Install functions for EO Next Kultur Main.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\eonext_kultur_main\ContentSliderSettings;
use Drupal\eonext_kultur_main\FooterSocialLoader;
use Drupal\eonext_kultur_main\NavGridSettings;
use Drupal\eonext_kultur_main\NavSpotSettings;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_install().
 */
function eonext_kultur_main_install(): void {
  _eonext_kultur_main_enable_paragraph_on_page();
  _eonext_kultur_main_configure_paragraph_form_displays();
}

/**
 * Enable the footer social paragraph on page nodes.
 */
function _eonext_kultur_main_enable_paragraph_on_page(): void {
  $field = FieldConfig::loadByName('node', 'page', 'field_paragraphs');
  if (!$field instanceof FieldConfig) {
    return;
  }

  $settings = $field->getSetting('handler_settings');
  $settings['target_bundles'][FooterSocialLoader::PARAGRAPH_BUNDLE] = FooterSocialLoader::PARAGRAPH_BUNDLE;
  $settings['target_bundles_drag_drop'][FooterSocialLoader::PARAGRAPH_BUNDLE] = [
    'weight' => 80,
    'enabled' => TRUE,
  ];
  $field->setSetting('handler_settings', $settings);
  $field->save();
}

/**
 * Wire Korsør display fields into paragraph edit forms and hide from default view.
 */
function _eonext_kultur_main_configure_paragraph_form_displays(): void {
  $content_slider_form = EntityFormDisplay::load('paragraph.content_slider.default');
  if ($content_slider_form instanceof EntityFormDisplay) {
    $content_slider_form
      ->setComponent(ContentSliderSettings::DISPLAY_MODE_FIELD, [
        'type' => 'options_select',
        'weight' => -10,
        'region' => 'content',
        'settings' => [],
      ])
      ->setComponent(ContentSliderSettings::ITEMS_PER_VIEW_FIELD, [
        'type' => 'number',
        'weight' => -9,
        'region' => 'content',
        'settings' => [
          'placeholder' => '',
        ],
      ])
      ->setComponent(ContentSliderSettings::FULL_WIDTH_FIELD, [
        'type' => 'boolean_checkbox',
        'weight' => -8,
        'region' => 'content',
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->save();
  }

  $content_slider_view = EntityViewDisplay::load('paragraph.content_slider.default');
  if ($content_slider_view instanceof EntityViewDisplay) {
    $content_slider_view
      ->removeComponent(ContentSliderSettings::DISPLAY_MODE_FIELD)
      ->removeComponent(ContentSliderSettings::ITEMS_PER_VIEW_FIELD)
      ->removeComponent(ContentSliderSettings::FULL_WIDTH_FIELD)
      ->save();
  }

  $nav_grid_form = EntityFormDisplay::load('paragraph.nav_grid_manual.default');
  if ($nav_grid_form instanceof EntityFormDisplay) {
    $nav_grid_form
      ->setComponent(NavGridSettings::DISPLAY_MODE_FIELD, [
        'type' => 'options_select',
        'weight' => -10,
        'region' => 'content',
        'settings' => [],
      ])
      ->save();
  }

  $nav_grid_view = EntityViewDisplay::load('paragraph.nav_grid_manual.default');
  if ($nav_grid_view instanceof EntityViewDisplay) {
    $nav_grid_view
      ->removeComponent(NavGridSettings::DISPLAY_MODE_FIELD)
      ->save();
  }

  $nav_spot_form = EntityFormDisplay::load('paragraph.nav_spots_manual.default');
  if ($nav_spot_form instanceof EntityFormDisplay) {
    $nav_spot_form
      ->setComponent(NavSpotSettings::DISPLAY_MODE_FIELD, [
        'type' => 'options_select',
        'weight' => -11,
        'region' => 'content',
        'settings' => [],
      ])
      ->setComponent(NavSpotSettings::FULL_WIDTH_FIELD, [
        'type' => 'boolean_checkbox',
        'weight' => -10,
        'region' => 'content',
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->save();
  }

  $nav_spot_view = EntityViewDisplay::load('paragraph.nav_spots_manual.default');
  if ($nav_spot_view instanceof EntityViewDisplay) {
    $nav_spot_view
      ->removeComponent(NavSpotSettings::DISPLAY_MODE_FIELD)
      ->removeComponent(NavSpotSettings::FULL_WIDTH_FIELD)
      ->save();
  }
}
