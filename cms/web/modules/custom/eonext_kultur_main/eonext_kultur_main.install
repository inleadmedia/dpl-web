/**
 * Removes content slider display mode, items-per-view, and full-width fields.
 */
function _eonext_kultur_main_remove_content_slider_display_fields(): string {
  $fields = [
    'field_kultur_slider_display_mode',
    'field_kultur_slider_per_view',
    'field_kultur_slider_full_width',
  ];
  $messages = [];

  $form_display = EntityFormDisplay::load('paragraph.content_slider.default');
  if ($form_display instanceof EntityFormDisplay) {
    foreach ($fields as $field_name) {
      $form_display->removeComponent($field_name);
    }
    $form_display->save();
    $messages[] = 'Removed content slider display fields from the paragraph edit form.';
  }

  $view_display = EntityViewDisplay::load('paragraph.content_slider.default');
  if ($view_display instanceof EntityViewDisplay) {
    foreach ($fields as $field_name) {
      $view_display->removeComponent($field_name);
    }
    $view_display->save();
  }

  foreach ($fields as $field_name) {
    $field = FieldConfig::loadByName('paragraph', 'content_slider', $field_name);
    if ($field instanceof FieldConfig) {
      $field->delete();
      $messages[] = "Deleted {$field_name} field config.";
    }

    $storage = FieldStorageConfig::loadByName('paragraph', $field_name);
    if ($storage instanceof FieldStorageConfig) {
      $storage->delete();
      $messages[] = "Deleted {$field_name} field storage.";
    }
  }

  return implode(' ', $messages);
}

