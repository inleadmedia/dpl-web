<?php

/**
 * @file
 * Install functions for EO Next Kultur Main.
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\eonext_kultur_main\BannerSettings;
use Drupal\eonext_kultur_main\FooterSocialLoader;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\language\Entity\ConfigurableLanguage;
use Drupal\language\Entity\ContentLanguageSettings;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_install().
 */
function eonext_kultur_main_install(): void {
  _eonext_kultur_main_enable_paragraph_on_page();
  _eonext_kultur_main_configure_paragraph_form_displays();
}

/**
 * Enable the footer social paragraph on page nodes.
 */
function _eonext_kultur_main_enable_paragraph_on_page(): void {
  $field = FieldConfig::loadByName('node', 'page', 'field_paragraphs');
  if (!$field instanceof FieldConfig) {
    return;
  }

  $settings = $field->getSetting('handler_settings');
  $settings['target_bundles'][FooterSocialLoader::PARAGRAPH_BUNDLE] = FooterSocialLoader::PARAGRAPH_BUNDLE;
  $settings['target_bundles_drag_drop'][FooterSocialLoader::PARAGRAPH_BUNDLE] = [
    'weight' => 80,
    'enabled' => TRUE,
  ];
  $field->setSetting('handler_settings', $settings);
  $field->save();
}

/**
 * Wire Korsør display fields into paragraph edit forms and hide from default view.
 */
function _eonext_kultur_main_configure_paragraph_form_displays(): void {
  _eonext_kultur_main_configure_banner_form_display();
  _eonext_kultur_main_configure_nav_spots_form_display();
  _eonext_kultur_main_configure_nav_grid_form_display();
}

/**
 * Returns the HTML5 color widget config for paragraph background color fields.
 *
 * @return array<string, mixed>
 *   Field widget component settings.
 */
function _eonext_kultur_main_background_color_widget(int $weight): array {
  return [
    'type' => 'color_field_widget_html5',
    'weight' => $weight,
    'region' => 'content',
    'settings' => [
      'default_colors' => '',
    ],
  ];
}

/**
 * Wire banner background color into the paragraph edit form.
 */
function _eonext_kultur_main_configure_banner_form_display(): void {
  if (!FieldConfig::loadByName('paragraph', 'banner', BannerSettings::BACKGROUND_COLOR_FIELD)) {
    return;
  }

  $banner_form = EntityFormDisplay::load('paragraph.banner.default');
  if ($banner_form instanceof EntityFormDisplay) {
    $banner_form
      ->setComponent(BannerSettings::BACKGROUND_COLOR_FIELD, _eonext_kultur_main_background_color_widget(4))
      ->save();
  }

  $banner_view = EntityViewDisplay::load('paragraph.banner.default');
  if ($banner_view instanceof EntityViewDisplay) {
    $banner_view
      ->removeComponent(BannerSettings::BACKGROUND_COLOR_FIELD)
      ->save();
  }

}

/**
 * Wire nav spot paragraph fields into the paragraph edit form.
 */
function _eonext_kultur_main_configure_nav_spots_form_display(): void {
  $form_display = EntityFormDisplay::load('paragraph.nav_spots_manual.default');
  if (!$form_display instanceof EntityFormDisplay) {
    return;
  }

  if (FieldConfig::loadByName('paragraph', 'nav_spots_manual', 'field_nav_spot_button_label')) {
    $form_display->setComponent('field_nav_spot_button_label', [
      'type' => 'string_textfield',
      'weight' => 1,
      'region' => 'content',
      'settings' => [
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
  }

  if (FieldConfig::loadByName('paragraph', 'nav_spots_manual', 'field_nav_spot_image_alignment')) {
    $form_display->setComponent('field_nav_spot_image_alignment', [
      'type' => 'options_select',
      'weight' => 2,
      'region' => 'content',
      'settings' => [],
    ]);
  }

  if (FieldConfig::loadByName('paragraph', 'nav_spots_manual', 'field_nav_spot_background_color')) {
    $form_display
      ->setComponent('field_nav_spot_background_color', _eonext_kultur_main_background_color_widget(3));
  }

  $form_display->save();
}

/**
 * Wire nav grid overlay color into the paragraph edit form.
 */
function _eonext_kultur_main_configure_nav_grid_form_display(): void {
  if (!FieldConfig::loadByName('paragraph', 'nav_grid_manual', 'field_nav_grid_overlay_color')) {
    return;
  }

  $form_display = EntityFormDisplay::load('paragraph.nav_grid_manual.default');
  if (!$form_display instanceof EntityFormDisplay) {
    return;
  }

  $form_display
    ->setComponent('field_nav_grid_overlay_color', _eonext_kultur_main_background_color_widget(3))
    ->save();

  $view_display = EntityViewDisplay::load('paragraph.nav_grid_manual.default');
  if ($view_display instanceof EntityViewDisplay) {
    $view_display
      ->removeComponent('field_nav_grid_overlay_color')
      ->save();
  }
}

/**
 * Remove deprecated nav spot display mode and full-width paragraph fields.
 */
function eonext_kultur_main_update_9014(): string {
  return _eonext_kultur_main_remove_nav_spot_display_fields();
}

/**
 * Removes nav spot display mode and full-width fields from existing sites.
 */
function _eonext_kultur_main_remove_nav_spot_display_fields(): string {
  $fields = [
    'field_kultur_nspot_display_mode',
    'field_kultur_nspot_full_width',
  ];
  $messages = [];

  $form_display = EntityFormDisplay::load('paragraph.nav_spots_manual.default');
  if ($form_display instanceof EntityFormDisplay) {
    foreach ($fields as $field_name) {
      $form_display->removeComponent($field_name);
    }
    $form_display->save();
    $messages[] = 'Removed nav spot display fields from the paragraph edit form.';
  }

  $view_display = EntityViewDisplay::load('paragraph.nav_spots_manual.default');
  if ($view_display instanceof EntityViewDisplay) {
    foreach ($fields as $field_name) {
      $view_display->removeComponent($field_name);
    }
    $view_display->save();
  }

  foreach ($fields as $field_name) {
    $field = FieldConfig::loadByName('paragraph', 'nav_spots_manual', $field_name);
    if ($field instanceof FieldConfig) {
      $field->delete();
      $messages[] = "Deleted {$field_name} field config.";
    }

    $storage = FieldStorageConfig::loadByName('paragraph', $field_name);
    if ($storage instanceof FieldStorageConfig) {
      $storage->delete();
      $messages[] = "Deleted {$field_name} field storage.";
    }
  }

  return implode(' ', $messages);
}

/**
 * Add banner background color field for image-less banners (EONEXT-320).
 */
function eonext_kultur_main_update_9015(): string {
  _eonext_kultur_main_ensure_banner_background_color_field();
  _eonext_kultur_main_configure_banner_form_display();

  return 'Banner background color field is available on banner paragraphs.';
}

/**
 * Creates the banner background color field from module install config.
 */
function _eonext_kultur_main_ensure_banner_background_color_field(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_main');
  $storage = new FileStorage($module_path . '/config/install');

  foreach ([
    'field.storage.paragraph.field_kultur_banner_bg_color',
    'field.field.paragraph.banner.field_kultur_banner_bg_color',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
      }
      continue;
    }

    if (!FieldConfig::load($data['id'])) {
      FieldConfig::create($data)->save();
    }
  }
}

/**
 * Remove deprecated nav grid display mode field and legacy box view modes.
 */
function eonext_kultur_main_update_9016(): string {
  return _eonext_kultur_main_remove_nav_grid_display_mode_field();
}

/**
 * Remove deprecated content slider display settings (EONEXT-319).
 */
function eonext_kultur_main_update_9017(): string {
  return _eonext_kultur_main_remove_content_slider_display_fields();
}

/**
 * Restore homepage content slider carousel view mode (EONEXT-319).
 */
function eonext_kultur_main_update_9018(): string {
  return _eonext_kultur_main_restore_content_slider_carousel();
}

/**
 * Restores carousel view mode and display selector for content slider paragraphs.
 */
function _eonext_kultur_main_restore_content_slider_carousel(): string {
  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_main');
  $storage = new FileStorage($module_path . '/config/install');
  $messages = [];

  foreach ([
    'core.entity_view_mode.paragraph.carousel',
    'field.storage.paragraph.field_kultur_slider_view_mode',
    'field.field.paragraph.content_slider.field_kultur_slider_view_mode',
    'core.entity_view_display.paragraph.content_slider.carousel',
  ] as $config_name) {
    $data = $storage->read($config_name);
    if (!$data) {
      continue;
    }

    if (str_starts_with($config_name, 'core.entity_view_mode.')) {
      if (!\Drupal::entityTypeManager()->getStorage('entity_view_mode')->load($data['id'])) {
        \Drupal::entityTypeManager()->getStorage('entity_view_mode')->create($data)->save();
        $messages[] = 'Created paragraph carousel view mode.';
      }
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      if (!FieldStorageConfig::load($data['id'])) {
        FieldStorageConfig::create($data)->save();
        $messages[] = 'Created content slider display field storage.';
      }
      continue;
    }

    if (str_starts_with($config_name, 'field.field.')) {
      if (!FieldConfig::load($data['id'])) {
        FieldConfig::create($data)->save();
        $messages[] = 'Created content slider display field.';
      }
      continue;
    }

    if (!\Drupal::entityTypeManager()->getStorage('entity_view_display')->load($data['id'])) {
      \Drupal::entityTypeManager()->getStorage('entity_view_display')->create($data)->save();
      $messages[] = 'Created content slider carousel display.';
    }
  }

  $form_display = EntityFormDisplay::load('paragraph.content_slider.default');
  if ($form_display instanceof EntityFormDisplay
    && FieldConfig::loadByName('paragraph', 'content_slider', 'field_kultur_slider_view_mode')
    && !$form_display->getComponent('field_kultur_slider_view_mode')) {
    $form_display->setComponent('field_kultur_slider_view_mode', [
      'type' => 'options_select',
      'weight' => -5,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ]);
    $form_display->save();
    $messages[] = 'Added display selector to the content slider edit form.';
  }

  $backfilled = _eonext_kultur_main_backfill_content_slider_view_mode();
  if ($backfilled > 0) {
    $messages[] = "Set default display on {$backfilled} existing content slider paragraph(s).";
  }

  return implode(' ', $messages) ?: 'Content slider carousel is already configured.';
}

/**
 * Backfill empty display values on existing content slider paragraphs.
 */
function _eonext_kultur_main_backfill_content_slider_view_mode(): int {
  if (!FieldConfig::loadByName('paragraph', 'content_slider', 'field_kultur_slider_view_mode')) {
    return 0;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'content_slider')
    ->execute();

  $updated = 0;
  foreach ($storage->loadMultiple($ids) as $paragraph) {
    if (!$paragraph instanceof ParagraphInterface) {
      continue;
    }
    if (!$paragraph->hasField('field_kultur_slider_view_mode')
      || !$paragraph->get('field_kultur_slider_view_mode')->isEmpty()) {
      continue;
    }

    $paragraph->set('field_kultur_slider_view_mode', 'default');
    $paragraph->save();
    $updated++;
  }

  return $updated;
}

/**
 * Backfill display field on content sliders created before the carousel restore.
 */
function eonext_kultur_main_update_9019(): string {
  $updated = _eonext_kultur_main_backfill_content_slider_view_mode();
  return $updated > 0
    ? "Set default display on {$updated} existing content slider paragraph(s)."
    : 'All content slider paragraphs already have a display value.';
}

/**
 * Allow empty display values on legacy content slider paragraphs.
 */
function eonext_kultur_main_update_9020(): string {
  $field = FieldConfig::loadByName('paragraph', 'content_slider', 'field_kultur_slider_view_mode');
  if (!$field instanceof FieldConfig) {
    return 'Content slider display field is not installed.';
  }

  if (!$field->isRequired()) {
    return 'Content slider display field is already optional.';
  }

  $field->setRequired(FALSE);
  $field->save();

  return 'Content slider display field no longer requires a value; empty means Default.';
}

