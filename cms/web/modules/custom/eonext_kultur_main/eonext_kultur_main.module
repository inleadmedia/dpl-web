<?php

/**
 * @file
 * EO Next Kultur Main module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\eonext_kultur_main\FooterSocialLoader;
use Drupal\field\Entity\FieldConfig;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_theme().
 */
function eonext_kultur_main_theme(): array {
  return [
    'eonext_kultur_footer_social' => [
      'variables' => [
        'title' => NULL,
        'text' => NULL,
        'cta' => NULL,
        'hashtag' => NULL,
        'facebook' => NULL,
        'instagram' => NULL,
      ],
      'template' => 'eonext-kultur-footer-social',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page.
 */
function eonext_kultur_main_preprocess_page(array &$variables): void {
  $loader = \Drupal::service('eonext_kultur_main.footer_social_loader');
  $variables['footer_social'] = $loader->buildRenderArray();

  $socialUrls = $loader->getSocialUrls();
  if (!isset($variables['footer_settings']) || !is_array($variables['footer_settings'])) {
    $variables['footer_settings'] = \Drupal::state()->get('dpl_footer_values') ?? [];
  }

  if ($socialUrls['facebook']) {
    $variables['footer_settings']['facebook'] = $socialUrls['facebook'];
  }
  if ($socialUrls['instagram']) {
    $variables['footer_settings']['instagram'] = $socialUrls['instagram'];
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function eonext_kultur_main_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if ($entity->getEntityTypeId() === 'paragraph' && $entity->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
    $build['#access'] = FALSE;
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.
 */
function eonext_kultur_main_preprocess_field(array &$variables): void {
  if (($variables['field_name'] ?? '') !== 'field_paragraphs') {
    return;
  }

  foreach ($variables['items'] as $delta => $item) {
    $paragraph = _eonext_kultur_main_item_paragraph($item);
    if ($paragraph instanceof ParagraphInterface && $paragraph->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
      unset($variables['items'][$delta]);
    }
  }
}

/**
 * Resolve the paragraph entity from a field item render array.
 */
function _eonext_kultur_main_item_paragraph(array $item): ?ParagraphInterface {
  $content = $item['content'] ?? [];
  $candidates = [
    $content['#paragraph'] ?? NULL,
    $content['#entity'] ?? NULL,
    $content[0]['#paragraph'] ?? NULL,
    $content[0]['#entity'] ?? NULL,
  ];

  foreach ($candidates as $candidate) {
    if ($candidate instanceof ParagraphInterface) {
      return $candidate;
    }
  }

  return NULL;
}

/**
 * Implements hook_entity_insert().
 */
function eonext_kultur_main_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof ParagraphInterface && $entity->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['config:system.site']);
  }
}

/**
 * Implements hook_entity_update().
 */
function eonext_kultur_main_entity_update(EntityInterface $entity): void {
  if ($entity instanceof ParagraphInterface && $entity->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['config:system.site']);
  }
}
