<?php

/**
 * @file
 * EO Next Kultur Main module hooks.
 */

declare(strict_types=1);

use Drupal\dpl_search\DplSearchSettings;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\eonext_kultur_main\ContentSliderSettings;
use Drupal\eonext_kultur_main\FooterSocialLoader;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\recurring_events\Entity\EventInstance;
use Drupal\recurring_events\Entity\EventSeries;

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * Use the editorial search header form instead of the React material header.
 */
function eonext_kultur_main_preprocess_page(array &$variables): void {
  $loader = \Drupal::service('eonext_kultur_main.footer_social_loader');
  $socialUrls = $loader->getSocialUrls();
  if (!isset($variables['footer_settings']) || !is_array($variables['footer_settings'])) {
    $variables['footer_settings'] = \Drupal::state()->get('dpl_footer_values') ?? [];
  }

  if ($socialUrls['facebook']) {
    $variables['footer_settings']['facebook'] = $socialUrls['facebook'];
  }
  if ($socialUrls['instagram']) {
    $variables['footer_settings']['instagram'] = $socialUrls['instagram'];
  }

  $editorial_route = 'view.' . DplSearchSettings::EDITORIAL_VIEW_ID . '.page';
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($route_name !== $editorial_route && isset($variables['search'])) {
    $variables['search']['header'] = [
      '#theme' => 'dpl_search_header',
      '#form_route' => $editorial_route,
      '#default_input' => \Drupal::request()->query->get(DplSearchSettings::EDITORIAL_QUERY_KEY, ''),
    ];
  }

  $header = $variables['search']['header'] ?? NULL;
  if (isset($variables['search']) && is_array($header) && ($header['#theme'] ?? '') === 'dpl_search_header') {
    _eonext_kultur_main_attach_editorial_search_overlay($variables);
  }
}

/**
 * Attach editorial autosuggest assets for the native search header.
 *
 * @param mixed[] $element
 *   A render array (typically the page variables array).
 */
function _eonext_kultur_main_attach_editorial_search_overlay(array &$element): void {
  if (!\Drupal::moduleHandler()->moduleExists('eonext_editorial_search')) {
    return;
  }

  $enabled = (bool) (\Drupal::config('eonext_editorial_search.settings')
    ->get('enable_editorial_search') ?? TRUE);
  if (!$enabled) {
    return;
  }

  $element['#attached']['library'][] = 'eonext_editorial_search/react-integration';
  $element['#attached']['drupalSettings']['eonextEditorialSearch'] = [
    'enabled' => TRUE,
    'relatedPageSize' => 20,
    'autosuggestLimit' => 7,
    'searchResultLimit' => 5,
    'searchResultFilters' => [
      'content_type:article',
      'content_type:page',
      'content_type:default',
    ],
    'materialRelatedFilters' => [
      'content_type:article',
    ],
    'dateLocale' => 'da-DK',
    'icons' => [
      'base' => eonext_editorial_search_get_base_icon_path(),
    ],
    'translations' => [
      'Artikel' => (string) t('Artikel', [], ['context' => 'eonext_editorial_search']),
      'Event' => (string) t('Event', [], ['context' => 'eonext_editorial_search']),
      'E-Resource' => (string) t('E-Resource', [], ['context' => 'eonext_editorial_search']),
      'relatedContentText' => (string) t('Related content', [], ['context' => 'DPL related content']),
    ],
  ];
  $element['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'span',
      '#attributes' => [
        'data-eonext-editorial-overlay' => 'true',
        'hidden' => 'hidden',
        'aria-hidden' => 'true',
      ],
    ],
    'eonext_kultur_main_editorial_overlay_flag',
  ];
  $element['#cache']['tags'][] = 'config:eonext_editorial_search.settings';
}

/**
 * Implements hook_theme().
 */
function eonext_kultur_main_theme(): array {
  return [
    'eonext_kultur_footer_social' => [
      'variables' => [
        'title' => NULL,
        'text' => NULL,
        'cta' => NULL,
        'hashtag' => NULL,
        'facebook' => NULL,
        'instagram' => NULL,
      ],
      'template' => 'eonext-kultur-footer-social',
    ],
    'content_slider_hero' => [
      'variables' => [
        'items' => [],
        'events_overview_url' => NULL,
        'items_per_view' => 2,
      ],
      'template' => 'content-slider-hero',
    ],
    'hero_slide' => [
      'variables' => [
        'title' => NULL,
        'tagline' => NULL,
        'date_display' => NULL,
        'url' => NULL,
        'image' => NULL,
      ],
      'template' => 'hero-slide',
    ],
    'content_slider_articles' => [
      'variables' => [
        'label' => NULL,
        'logo_url' => NULL,
        'items' => [],
        'articles_overview_url' => NULL,
        'full_width' => TRUE,
        'items_per_view' => 2,
      ],
      'template' => 'content-slider-articles',
    ],
    'article_slide' => [
      'variables' => [
        'title' => NULL,
        'teaser_text' => NULL,
        'date_display' => NULL,
        'url' => NULL,
        'image' => NULL,
      ],
      'template' => 'article-slide',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function eonext_kultur_main_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (str_starts_with($form_id, 'paragraph_content_slider_')) {
    if (isset($form[ContentSliderSettings::ITEMS_PER_VIEW_FIELD]['widget'])) {
      $form[ContentSliderSettings::ITEMS_PER_VIEW_FIELD]['#states'] = [
        'visible' => [
          ':input[name="field_kultur_slider_display_mode"]' => [
            ['value' => ContentSliderSettings::DISPLAY_HERO],
            'or',
            ['value' => ContentSliderSettings::DISPLAY_ARTICLES],
          ],
        ],
      ];
    }

    if (isset($form[ContentSliderSettings::FULL_WIDTH_FIELD]['widget'])) {
      $form[ContentSliderSettings::FULL_WIDTH_FIELD]['#states'] = [
        'visible' => [
          ':input[name="field_kultur_slider_display_mode"]' => [
            ['value' => ContentSliderSettings::DISPLAY_HERO],
            'or',
            ['value' => ContentSliderSettings::DISPLAY_ARTICLES],
          ],
        ],
      ];
    }
    return;
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function eonext_kultur_main_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if ($entity->getEntityTypeId() === 'paragraph' && $entity->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
    $build['#access'] = FALSE;
  }

  if ($entity instanceof ParagraphInterface
    && $entity->bundle() === 'content_slider'
    && $display->getMode() === 'hero'
    && isset($build['field_content_references'])) {
    $build['field_content_references']['#paragraph_view_mode'] = 'hero';
  }

  if ($entity instanceof ParagraphInterface
    && $entity->bundle() === 'content_slider'
    && ContentSliderSettings::isArticlesMode($entity)
    && isset($build['field_content_references'])) {
    $build['field_content_references'] = _eonext_kultur_main_build_articles_slider($entity);
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.
 */
function eonext_kultur_main_preprocess_field(array &$variables): void {
  $element = $variables['element'];
  $paragraph = $element['#object'] ?? NULL;

  if ($paragraph instanceof ParagraphInterface
    && ($variables['field_name'] ?? '') === 'field_content_references'
    && $paragraph->bundle() === 'nav_grid_manual') {
    $variables['theme_hook_suggestions'][] = 'field__paragraph__field_content_references__nav_grid_manual';
    $variables['show_subtitles'] = TRUE;
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $paragraph->getCacheTags()
    );
  }
  elseif ($paragraph instanceof ParagraphInterface
    && ($variables['field_name'] ?? '') === 'field_content_references'
    && ContentSliderSettings::isHeroMode($paragraph)) {
    $variables['items'] = [];

    foreach ($paragraph->get('field_content_references') as $delta => $item) {
      $referenced = $item->entity;
      if (!$referenced instanceof EntityInterface) {
        continue;
      }

      $entity_type = $referenced->getEntityTypeId();
      $referenced_view_mode = 'hero_slide';
      if (!in_array($entity_type, ['node', 'eventseries', 'eventinstance'], TRUE)) {
        $referenced_view_mode = 'default';
      }

      $variables['items'][$delta]['content'] = \Drupal::entityTypeManager()
        ->getViewBuilder($entity_type)
        ->view($referenced, $referenced_view_mode);
    }

    $variables['theme_hook_suggestions'][] = 'field__paragraph__field_content_references__content_slider__hero';
    $variables['events_overview_url'] = Url::fromUserInput('/arrangementer')->toString();
    $variables['use_hero_slider'] = TRUE;
    $variables['items_per_view'] = ContentSliderSettings::getItemsPerView($paragraph);
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $paragraph->getCacheTags()
    );
  }
  elseif ($paragraph instanceof ParagraphInterface
    && $paragraph->bundle() === 'content_slider'
    && ($element['#paragraph_view_mode'] ?? '') === 'hero') {
    $variables['theme_hook_suggestions'][] = 'field__paragraph__field_content_references__content_slider__hero';
    $variables['events_overview_url'] = Url::fromUserInput('/arrangementer')->toString();
  }

  if (($variables['field_name'] ?? '') !== 'field_paragraphs') {
    return;
  }

  foreach ($variables['items'] as $delta => $item) {
    $itemParagraph = _eonext_kultur_main_item_paragraph($item);
    if ($itemParagraph instanceof ParagraphInterface && $itemParagraph->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
      unset($variables['items'][$delta]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventinstance templates.
 */
function eonext_kultur_main_preprocess_eventinstance(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'hero_slide') {
    return;
  }

  $entity = $variables['eventinstance'] ?? NULL;
  if ($entity instanceof EventInstance) {
    _eonext_kultur_main_apply_hero_slide($variables, $entity);
  }
}

/**
 * Implements hook_preprocess_HOOK() for eventseries templates.
 */
function eonext_kultur_main_preprocess_eventseries(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'hero_slide') {
    return;
  }

  $entity = $variables['eventseries'] ?? NULL;
  if ($entity instanceof EventSeries) {
    _eonext_kultur_main_apply_hero_slide($variables, $entity);
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function eonext_kultur_main_preprocess_node(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'hero_slide') {
    return;
  }

  $entity = $variables['node'] ?? NULL;
  if ($entity instanceof NodeInterface) {
    _eonext_kultur_main_apply_hero_slide($variables, $entity);
  }
}

/**
 * Apply hero slide variables to an entity template.
 *
 * @param mixed[] $variables
 *   Template variables.
 */
function _eonext_kultur_main_apply_hero_slide(array &$variables, EntityInterface $entity): void {
  $slide = \Drupal::service('eonext_kultur_main.hero_slide_builder')->build($entity);
  if ($slide === NULL) {
    return;
  }

  $variables['hero_slide'] = $slide;
  $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], $entity->getCacheTags());
}

/**
 * Build the articles slider render array for a content slider paragraph.
 *
 * @return array<string, mixed>
 *   Render array for the articles slider theme.
 */
function _eonext_kultur_main_build_articles_slider(ParagraphInterface $paragraph): array {
  $items = [];
  $builder = \Drupal::service('eonext_kultur_main.article_slide_builder');

  foreach ($paragraph->get('field_content_references') as $delta => $item) {
    $referenced = $item->entity;
    if (!$referenced instanceof EntityInterface) {
      continue;
    }

    $slide = $builder->build($referenced);
    if ($slide === NULL) {
      continue;
    }

    $items[$delta]['content'] = [
      '#theme' => 'article_slide',
      '#title' => $slide['title'],
      '#teaser_text' => $slide['teaser_text'],
      '#date_display' => $slide['date_display'],
      '#url' => $slide['url'],
      '#image' => $slide['image'],
      '#cache' => [
        'tags' => $referenced->getCacheTags(),
        'contexts' => ['languages:language_interface'],
      ],
    ];
  }

  $label = 'Artikler';
  if ($paragraph->hasField('field_title') && !$paragraph->get('field_title')->isEmpty()) {
    $label = (string) $paragraph->get('field_title')->value;
  }

  $themePath = \Drupal::service('extension.list.theme')->getPath('eonext_kultur');
  $logoUrl = $themePath ? '/' . $themePath . '/assets/images/logo.png' : NULL;

  return [
    '#theme' => 'content_slider_articles',
    '#label' => $label,
    '#logo_url' => $logoUrl,
    '#items' => $items,
    '#articles_overview_url' => Url::fromUserInput('/artikler')->toString(),
    '#full_width' => ContentSliderSettings::isFullWidth($paragraph),
    '#items_per_view' => ContentSliderSettings::getItemsPerView($paragraph),
    '#cache' => [
      'tags' => $paragraph->getCacheTags(),
      'contexts' => ['languages:language_interface'],
    ],
  ];
}

/**
 * Resolve the paragraph entity from a field item render array.
 */
function _eonext_kultur_main_item_paragraph(array $item): ?ParagraphInterface {
  $content = $item['content'] ?? [];
  $candidates = [
    $content['#paragraph'] ?? NULL,
    $content['#entity'] ?? NULL,
    $content[0]['#paragraph'] ?? NULL,
    $content[0]['#entity'] ?? NULL,
  ];

  foreach ($candidates as $candidate) {
    if ($candidate instanceof ParagraphInterface) {
      return $candidate;
    }
  }

  return NULL;
}

/**
 * Implements hook_entity_insert().
 */
function eonext_kultur_main_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof ParagraphInterface && $entity->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['config:system.site']);
  }
}

/**
 * Implements hook_entity_update().
 */
function eonext_kultur_main_entity_update(EntityInterface $entity): void {
  if ($entity instanceof ParagraphInterface && $entity->bundle() === FooterSocialLoader::PARAGRAPH_BUNDLE) {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['config:system.site']);
  }
}

