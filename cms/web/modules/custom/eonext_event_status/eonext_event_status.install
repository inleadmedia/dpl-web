<?php

/**
 * @file
 * Install and update hooks for EO Next Event Status.
 */

declare(strict_types=1);

use Drupal\Core\Config\Entity\ConfigEntityInterface;
use Drupal\Core\Config\FileStorage;

/**
 * The DPL-owned displays this module used to be arranged into by hand.
 */
const EONEXT_EVENT_STATUS_DPL_DISPLAYS = [
  'core.entity_form_display.eventseries.default.default',
  'core.entity_form_display.eventinstance.default.default',
];

/**
 * The fields this module adds to DPL-owned event bundles.
 */
const EONEXT_EVENT_STATUS_FIELDS = [
  'field_ribbon_text',
  'field_ribbon_color',
  'field_ribbon_instances_apply',
];

/**
 * Config objects this module owns and must create on enable.
 *
 * Copied in config/install for Drupal's automatic import on first install, and
 * in config/sync for the webmaster overlay on platform deploy.
 */
const EONEXT_EVENT_STATUS_OWNED_CONFIG = [
  'field.storage.eventinstance.field_ribbon_color',
  'field.storage.eventinstance.field_ribbon_text',
  'field.storage.eventseries.field_ribbon_color',
  'field.storage.eventseries.field_ribbon_instances_apply',
  'field.storage.eventseries.field_ribbon_text',
  'field.field.eventinstance.default.field_ribbon_color',
  'field.field.eventinstance.default.field_ribbon_text',
  'field.field.eventseries.default.field_ribbon_color',
  'field.field.eventseries.default.field_ribbon_instances_apply',
  'field.field.eventseries.default.field_ribbon_text',
];

/**
 * Installs this module's owned configuration after enable or update.
 *
 * Writes ribbon field storages and instances into active storage. DPL platform
 * releases apply the full overlay through OverlayConfigEventSubscriber during
 * deploy configuration import — we do not run a site-wide import here.
 *
 * @see \Drupal\eonext_event_status\EventSubscriber\OverlayConfigEventSubscriber
 */
function eonext_event_status_update_config(): void {
  _eonext_event_status_install_owned_config();
}

/**
 * Writes this module's overlay objects into active configuration.
 */
function _eonext_event_status_install_owned_config(): void {
  $source = _eonext_event_status_overlay_storage();

  foreach (EONEXT_EVENT_STATUS_OWNED_CONFIG as $name) {
    $data = $source->read($name);
    if (!is_array($data)) {
      continue;
    }
    _eonext_event_status_ensure_config_entity($name, $data);
  }

  \Drupal::service('plugin.cache_clearer')->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Returns owned config object names that are not in active storage.
 *
 * @return string[]
 *   Missing configuration object names.
 */
function _eonext_event_status_missing_owned_config(): array {
  $missing = [];

  foreach (EONEXT_EVENT_STATUS_OWNED_CONFIG as $name) {
    $entity_type_id = \Drupal::service('config.manager')->getEntityTypeIdByName($name);
    if ($entity_type_id) {
      $storage = \Drupal::entityTypeManager()->getStorage($entity_type_id);
      $id = substr($name, strlen($storage->getEntityType()->getConfigPrefix()) + 1);
      if ($storage->load($id) instanceof ConfigEntityInterface) {
        continue;
      }
    }
    elseif (!\Drupal::configFactory()->get($name)->isNew()) {
      continue;
    }

    $missing[] = $name;
  }

  return $missing;
}

/**
 * Implements hook_install().
 */
function eonext_event_status_install(): void {
  _eonext_event_status_install_owned_config();
}

/**
 * Creates a config entity from overlay YAML when it is not already present.
 *
 * @param array<string, mixed> $data
 *   The configuration record.
 */
function _eonext_event_status_ensure_config_entity(string $name, array $data): void {
  $entity_type_id = \Drupal::service('config.manager')->getEntityTypeIdByName($name);
  if (!$entity_type_id) {
    $config = \Drupal::configFactory()->getEditable($name);
    if ($config->isNew()) {
      $config->setData($data)->save(TRUE);
    }
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage($entity_type_id);
  $id = substr($name, strlen($storage->getEntityType()->getConfigPrefix()) + 1);
  if ($storage->load($id) instanceof ConfigEntityInterface) {
    return;
  }

  try {
    $storage->createFromStorageRecord($data)->save();
  }
  catch (\Exception $e) {
    \Drupal::logger('eonext_event_status')->error(
      'Could not install @name: @message',
      ['@name' => $name, '@message' => $e->getMessage()],
    );
  }
}

/**
 * File storage for this module's webmaster overlay.
 */
function _eonext_event_status_overlay_storage(): FileStorage {
  $path = \Drupal::service('extension.path.resolver')
    ->getPath('module', 'eonext_event_status') . '/config/sync';
  return new FileStorage($path);
}

// Owned configuration is applied from hook_modules_installed() rather than
// hook_install(), so that installing several modules at once only runs once,
// after all of them are in place.
// @see eonext_event_status_modules_installed()

/**
 * Releases the DPL event displays this module used to occupy.
 *
 * The ribbon fields are now placed by hook_entity_form_display_alter() at
 * render time, so the stored DPL displays no longer need to mention them. Any
 * site where an administrator arranged the fields by hand has those displays
 * pinned in config_ignore_auto, which both blocks DPL's own updates to them
 * and previously made config import fail. Release them again.
 */
function eonext_event_status_update_10001(): string {
  $messages = [];

  $display_storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  foreach (EONEXT_EVENT_STATUS_DPL_DISPLAYS as $config_name) {
    $display_id = substr($config_name, strlen('core.entity_form_display.'));
    $display = $display_storage->load($display_id);
    if (!$display) {
      continue;
    }

    $removed = FALSE;
    foreach (EONEXT_EVENT_STATUS_FIELDS as $field_name) {
      if ($display->getComponent($field_name)) {
        $display->removeComponent($field_name);
        $removed = TRUE;
      }
    }

    if ($removed) {
      $display->save();
      $messages[] = "Removed ribbon fields from $display_id.";
    }
  }

  $messages[] = _eonext_event_status_unpin_config(EONEXT_EVENT_STATUS_DPL_DISPLAYS);

  return implode(' ', array_filter($messages));
}

/**
 * Removes config objects from the config_ignore_auto ignore list.
 *
 * @param string[] $config_names
 *   Names of the config objects to stop ignoring.
 */
function _eonext_event_status_unpin_config(array $config_names): string {
  $settings = \Drupal::configFactory()->getEditable('config_ignore_auto.settings');
  $ignored = $settings->get('ignored_config_entities') ?: [];

  $remaining = array_values(array_filter(
    $ignored,
    fn (string $item): bool => !in_array($item, $config_names, TRUE),
  ));

  $removed = count($ignored) - count($remaining);
  if ($removed === 0) {
    return '';
  }

  $settings->set('ignored_config_entities', $remaining)->save();

  return "Released $removed config object(s) back to DPL CMS.";
}
