<?php

/**
 * @file
 * EO NEXT Quick loan module.
 */

use Drupal\eonext_quickloan\QuickLoanSettings;

/**
 * Implements hook_preprocess_HOOK().
 */
function eonext_quickloan_preprocess_dpl_react_app(array &$variables): void {
  if (($variables['name'] ?? '') !== 'material') {
    return;
  }

  $config = \Drupal::config(QuickLoanSettings::CONFIG_ID);
  $variables['attributes'][QuickLoanSettings::MATERIAL_DATA_ATTRIBUTE] = $config->get('enabled') ? 'true' : 'false';
  $variables['#cache']['tags'][] = 'config:' . QuickLoanSettings::CONFIG_ID;
}
