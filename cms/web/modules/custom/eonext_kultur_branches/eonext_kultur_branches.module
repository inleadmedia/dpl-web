<?php

/**
 * @file
 * Foreninger branches listing hooks.
 */

declare(strict_types=1);

use Drupal\Core\Menu\MenuLinkInterface;
use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function eonext_kultur_branches_theme($existing, $type, $theme, $path): array {
  $templates_path = $path . '/templates';

  return [
    'views_view__foreninger__page' => [
      'base hook' => 'views_view',
      'path' => $templates_path,
      'template' => 'views-view--foreninger--page',
    ],
    'views_view__foreninger__page_1' => [
      'base hook' => 'views_view',
      'path' => $templates_path,
      'template' => 'views-view--foreninger--page',
    ],
    'views_view_unformatted__foreninger__page' => [
      'base hook' => 'views_view_unformatted',
      'path' => $templates_path,
      'template' => 'views-view-unformatted--foreninger--page',
    ],
    'views_view_unformatted__foreninger__page_1' => [
      'base hook' => 'views_view_unformatted',
      'path' => $templates_path,
      'template' => 'views-view-unformatted--foreninger--page',
    ],
  ];
}

/**
 * Implements hook_theme_registry_alter().
 */
function eonext_kultur_branches_theme_registry_alter(array &$theme_registry): void {
  $templates_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_branches') . '/templates';

  if (isset($theme_registry['views_view__foreninger__page'])) {
    $theme_registry['views_view__foreninger__page']['path'] = $templates_path;
    $theme_registry['views_view__foreninger__page']['template'] = 'views-view--foreninger--page';
    $theme_registry['views_view__foreninger__page']['type'] = 'module';
  }

  if (isset($theme_registry['views_view__foreninger__page_1'])) {
    $theme_registry['views_view__foreninger__page_1']['path'] = $templates_path;
    $theme_registry['views_view__foreninger__page_1']['template'] = 'views-view--foreninger--page';
    $theme_registry['views_view__foreninger__page_1']['type'] = 'module';
  }

  if (isset($theme_registry['views_view_unformatted__foreninger__page_1'])) {
    $theme_registry['views_view_unformatted__foreninger__page_1']['path'] = $templates_path;
    $theme_registry['views_view_unformatted__foreninger__page_1']['template'] = 'views-view-unformatted--foreninger--page';
    $theme_registry['views_view_unformatted__foreninger__page_1']['type'] = 'module';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 */
function eonext_kultur_branches_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  if (($variables['view']->id() ?? '') !== \Drupal\eonext_kultur_branches\ForeningerConstants::VIEW_ID) {
    return;
  }

  $suggestions[] = 'views_view__foreninger__page';
  $display = $variables['view']->current_display ?? '';
  if ($display !== '') {
    $suggestions[] = 'views_view__foreninger__' . $display;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_unformatted.
 */
function eonext_kultur_branches_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables): void {
  if (($variables['view']->id() ?? '') !== \Drupal\eonext_kultur_branches\ForeningerConstants::VIEW_ID) {
    return;
  }

  $suggestions[] = 'views_view_unformatted__foreninger__page';
  $display = $variables['view']->current_display ?? '';
  if ($display !== '') {
    $suggestions[] = 'views_view_unformatted__foreninger__' . $display;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node.
 */
function eonext_kultur_branches_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  if (!eonext_kultur_branches_is_listing_page()) {
    return;
  }

  $node = $variables['elements']['#node'] ?? $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'branch') {
    return;
  }

  $view_mode = $variables['elements']['#view_mode'] ?? $variables['view_mode'] ?? '';
  if ($view_mode === 'list_teaser') {
    $suggestions[] = 'node__branch__list_teaser__foreninger';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function eonext_kultur_branches_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!($view instanceof ViewExecutable)) {
    return;
  }

  if ($view->id() !== \Drupal\eonext_kultur_branches\ForeningerConstants::VIEW_ID) {
    return;
  }

  $variables['#attached']['library'][] = 'eonext_kultur_branches/foreninger-listing';

  if (!eonext_kultur_branches_is_listing_page()) {
    return;
  }

  $default_heading = $view->getTitle() ?: (string) t('Foreninger', [], ['context' => 'eonext_kultur_branches']);
  $hero = \Drupal::service('eonext_kultur_branches.listing_hero_builder')->build($default_heading);
  if ($hero !== NULL) {
    $variables['foreninger_listing_hero'] = $hero;
    $variables['#attached']['library'][] = 'eonext_kultur_locale/lokale';
    $variables['#cache']['tags'][] = 'config:eonext_kultur_branches.settings';
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.
 */
function eonext_kultur_branches_preprocess_node(array &$variables): void {
  if (eonext_kultur_branches_is_branch_detail_page($variables)) {
    eonext_kultur_branches_preprocess_branch_detail($variables);
    return;
  }

  if (!eonext_kultur_branches_is_listing_page()) {
    return;
  }

  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'branch') {
    return;
  }

  if (($variables['view_mode'] ?? '') !== 'list_teaser') {
    return;
  }

  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();
  $variables['baseIconPath'] = '/' . $theme_path . '/assets/dpl-design-system/icons';

  $loader = \Drupal::service('eonext_kultur_branches.upcoming_events');
  $payload = $loader->buildSummaryForBranch((int) $node->id());
  $variables['foreninger_event_items'] = $payload['items'];
  $variables['foreninger_show_empty_events'] = $payload['items'] === [];

  if (!$node->get('field_address_gsearch')->isEmpty()) {
    $variables['foreninger_address'] = (string) ($node->get('field_address_gsearch')->first()->value ?? '');
  }
  elseif (!$node->get('field_address')->isEmpty()) {
    $variables['foreninger_address'] = (string) $node->get('field_address')->first()->getString();
  }
  else {
    $variables['foreninger_address'] = '';
  }

  foreach ($payload['cache_tags'] as $tag) {
    $variables['#cache']['tags'][] = $tag;
  }

  $variables['#cache']['tags'][] = 'config:eonext_kultur_branches.settings';
  $variables['#cache']['contexts'][] = 'user.permissions';
}

/**
 * Adds upcoming events to branch full pages.
 */
function eonext_kultur_branches_preprocess_branch_detail(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'branch') {
    return;
  }

  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();
  $variables['baseIconPath'] = '/' . $theme_path . '/assets/dpl-design-system/icons';

  $loader = \Drupal::service('eonext_kultur_branches.upcoming_events');
  $payload = $loader->buildEventCardsForBranch((int) $node->id());
  $variables['branch_upcoming_events'] = $payload['events'];
  $variables['branch_events_calendar_url'] = $payload['calendar_url']->toString();
  $variables['branch_has_upcoming_events'] = $payload['events'] !== [];

  $variables['#attached']['library'][] = 'eonext_kultur_events/events-listing';
  $variables['#attached']['library'][] = 'eonext_kultur_branches/foreninger-listing';

  foreach ($payload['cache_tags'] as $tag) {
    $variables['#cache']['tags'][] = $tag;
  }
  $variables['#cache']['tags'][] = 'eventinstance_list';
  $variables['#cache']['contexts'][] = 'user.permissions';
}

/**
 * Implements hook_preprocess_HOOK() for eventinstance.
 */
function eonext_kultur_branches_preprocess_eventinstance(array &$variables): void {
  if (!eonext_kultur_branches_is_branch_detail_page()) {
    return;
  }

  $view_mode = $variables['view_mode'] ?? '';
  if ($view_mode !== \Drupal\eonext_kultur_events\EventsConstants::CARD_VIEW_MODE) {
    return;
  }

  $eventinstance = $variables['eventinstance'] ?? NULL;
  if (!$eventinstance instanceof \Drupal\recurring_events\Entity\EventInstance) {
    return;
  }

  if (!empty($variables['hero_slide'])) {
    return;
  }

  $slide = \Drupal::service('eonext_kultur_main.hero_slide_builder')->build($eventinstance);
  if ($slide !== NULL) {
    $variables['hero_slide'] = $slide;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for eventinstance.
 */
function eonext_kultur_branches_theme_suggestions_eventinstance_alter(array &$suggestions, array $variables): void {
  if (!eonext_kultur_branches_is_branch_detail_page()) {
    return;
  }

  $view_mode = $variables['elements']['#view_mode'] ?? $variables['view_mode'] ?? '';
  if ($view_mode === \Drupal\eonext_kultur_events\EventsConstants::CARD_VIEW_MODE) {
    $suggestions[] = 'eventinstance__card__eonext_kultur_grid';
  }
}

/**
 * Implements hook_views_pre_view().
 */
function eonext_kultur_branches_views_pre_view(ViewExecutable $view, $display_id, array &$args): void {
  if ($view->id() !== \Drupal\eonext_kultur_branches\ForeningerConstants::VIEW_ID) {
    return;
  }

  /** @var \Drupal\eonext_kultur_branches\ForeningerListingRegistry $registry */
  $registry = \Drupal::service('eonext_kultur_branches.listing_registry');
  $enabled_nids = $registry->getEnabledNids();

  if ($enabled_nids !== []) {
    $view->removeHandler($display_id, 'filter', 'field_promoted_on_lists_value');
    $view->setHandler($display_id, 'filter', 'nid', [
      'id' => 'nid',
      'table' => 'node_field_data',
      'field' => 'nid',
      'relationship' => 'none',
      'group_type' => 'group',
      'admin_label' => '',
      'entity_type' => 'node',
      'entity_field' => 'nid',
      'plugin_id' => 'numeric',
      'operator' => 'in',
      'value' => [
        'min' => '',
        'max' => '',
        'value' => implode('+', $enabled_nids),
      ],
      'group' => 1,
      'exposed' => FALSE,
      'expose' => [
        'operator_id' => '',
        'label' => '',
        'description' => '',
        'use_operator' => FALSE,
        'operator' => '',
        'operator_limit_selection' => FALSE,
        'operator_list' => [],
        'identifier' => '',
        'required' => FALSE,
        'remember' => FALSE,
        'multiple' => FALSE,
      ],
      'is_grouped' => FALSE,
      'group_info' => [
        'label' => '',
        'description' => '',
        'identifier' => '',
        'optional' => TRUE,
        'widget' => 'select',
        'multiple' => FALSE,
        'remember' => FALSE,
        'default_group' => 'All',
        'default_group_multiple' => [],
        'group_items' => [],
      ],
    ]);
    return;
  }

  $excluded = \Drupal::config('eonext_kultur_branches.settings')->get('excluded_branch_ids') ?? [];
  if (!is_array($excluded) || $excluded === []) {
    return;
  }

  $excluded = array_values(array_filter(array_map('intval', $excluded)));
  if ($excluded === []) {
    return;
  }

  $view->setHandler($display_id, 'filter', 'nid', [
    'id' => 'nid',
    'table' => 'node_field_data',
    'field' => 'nid',
    'relationship' => 'none',
    'group_type' => 'group',
    'admin_label' => '',
    'entity_type' => 'node',
    'entity_field' => 'nid',
    'plugin_id' => 'numeric',
    'operator' => 'not in',
    'value' => [
      'min' => '',
      'max' => '',
      'value' => implode('+', $excluded),
    ],
    'group' => 1,
    'exposed' => FALSE,
    'expose' => [
      'operator_id' => '',
      'label' => '',
      'description' => '',
      'use_operator' => FALSE,
      'operator' => '',
      'operator_limit_selection' => FALSE,
      'operator_list' => [],
      'identifier' => '',
      'required' => FALSE,
      'remember' => FALSE,
      'multiple' => FALSE,
    ],
    'is_grouped' => FALSE,
    'group_info' => [
      'label' => '',
      'description' => '',
      'identifier' => '',
      'optional' => TRUE,
      'widget' => 'select',
      'multiple' => FALSE,
      'remember' => FALSE,
      'default_group' => 'All',
      'default_group_multiple' => [],
      'group_items' => [],
    ],
  ]);
}

/**
 * Implements hook_views_post_execute().
 */
function eonext_kultur_branches_views_post_execute(ViewExecutable $view): void {
  if ($view->id() !== \Drupal\eonext_kultur_branches\ForeningerConstants::VIEW_ID) {
    return;
  }

  /** @var \Drupal\eonext_kultur_branches\ForeningerListingRegistry $registry */
  $registry = \Drupal::service('eonext_kultur_branches.listing_registry');
  $enabled_nids = $registry->getEnabledNids();
  if ($enabled_nids === [] || $view->result === []) {
    return;
  }

  $order = array_flip($enabled_nids);
  usort($view->result, static function ($a, $b) use ($order): int {
    $nid_a = (int) ($a->_entity->id() ?? 0);
    $nid_b = (int) ($b->_entity->id() ?? 0);
    return ($order[$nid_a] ?? PHP_INT_MAX) <=> ($order[$nid_b] ?? PHP_INT_MAX);
  });
}

/**
 * Implements hook_kultur_site_pages_alter().
 */
function eonext_kultur_branches_kultur_site_pages_alter(array &$pages): void {
  $config = \Drupal::config('eonext_kultur_branches.settings');
  $title = trim((string) $config->get('teaser_title'));
  if ($title === '') {
    $title = (string) t('Foreninger (/foreninger)', [], ['context' => 'eonext_kultur_branches']);
  }

  $pages[] = [
    'label' => $title,
    'description' => trim((string) $config->get('teaser_text')) ?: (string) t('Branches overview page', [], ['context' => 'eonext_kultur_branches']),
    'path' => '/foreninger',
    'keywords' => ['forening', 'foreninger', 'branch', 'filial', 'organisation', 'organization'],
  ];
}

/**
 * Returns TRUE on the public foreninger listing page.
 */
function eonext_kultur_branches_is_listing_page(): bool {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'view.foreninger.page_1') {
    return TRUE;
  }

  $path = trim(\Drupal::service('path.current')->getPath(), '/');
  return $path === 'foreninger';
}

/**
 * Returns TRUE on a published branch full page.
 *
 * @param array<string, mixed>|null $variables
 *   Optional node preprocess variables.
 */
function eonext_kultur_branches_is_branch_detail_page(?array $variables = NULL): bool {
  if ($variables !== NULL) {
    $view_mode = $variables['view_mode'] ?? '';
    $node = $variables['node'] ?? NULL;
    if ($view_mode !== 'full' || !$node instanceof NodeInterface || $node->bundle() !== 'branch') {
      return FALSE;
    }
  }

  $route = \Drupal::routeMatch()->getRouteName();
  if ($route !== 'entity.node.canonical') {
    return FALSE;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  return $node instanceof NodeInterface
    && $node->bundle() === 'branch'
    && $node->isPublished();
}

/**
 * Ensures the main menu Foreninger link exists.
 */
function eonext_kultur_branches_ensure_main_menu_link(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  foreach ($storage->loadByProperties(['menu_name' => 'main']) as $link) {
    if (!$link instanceof MenuLinkInterface) {
      continue;
    }
    if ((string) $link->getTitle() === 'Foreninger') {
      return;
    }
    if (str_starts_with($link->getUrlObject()->toString(), '/foreninger')) {
      return;
    }
  }

  $link = MenuLinkContent::create([
    'title' => 'Foreninger',
    'link' => ['uri' => 'internal:/foreninger'],
    'menu_name' => 'main',
    'weight' => 45,
    'langcode' => 'da',
  ]);
  $link->save();
}
