<?php

/**
 * @file
 * Module hooks for Kulturnat event submissions.
 */

use CommerceGuys\Addressing\AddressFormat\AddressField;
use CommerceGuys\Addressing\AddressFormat\FieldOverride;
use CommerceGuys\Addressing\AddressFormat\FieldOverrides;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Datetime\Element\Datetime;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\eonext_kultur_event_submissions\Entity\KulturEventSubmission;
use Drupal\eonext_kultur_event_submissions\SubmissionConstants;

/**
 * Implements hook_theme().
 */
function eonext_kultur_event_submissions_theme($existing, $type, $theme, $path): array {
  return [
    'form__eonext_kultur_event_submission_public' => [
      'render element' => 'element',
      'template' => 'form--eonext-kultur-event-submission-public',
      'path' => $path . '/templates',
    ],
    'kultur_event_submission' => [
      'variables' => [
        'organisation_name' => NULL,
        'title_da' => NULL,
        'event_categories' => [],
        'status' => NULL,
        'status_label' => NULL,
        'city_label' => NULL,
        'address' => NULL,
        'event_start' => NULL,
        'event_end' => NULL,
        'contact_name' => NULL,
        'contact_email' => NULL,
        'contact_phone' => NULL,
        'description_gl' => NULL,
        'description_da' => NULL,
        'image' => NULL,
        'eventseries' => NULL,
        'submitted' => NULL,
        'updated' => NULL,
        'actions' => [],
      ],
      'template' => 'kultur-event-submission',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form.
 */
function eonext_kultur_event_submissions_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  if (\Drupal::routeMatch()->getRouteName() === 'eonext_kultur_event_submissions.public_form') {
    $suggestions[] = 'form__eonext_kultur_event_submission_public';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form_element.
 */
function eonext_kultur_event_submissions_theme_suggestions_form_element_alter(array &$suggestions, array $variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'eonext_kultur_event_submissions.public_form') {
    return;
  }

  $suggestions[] = 'form_element__webform';
  if (($variables['element']['#type'] ?? '') === 'radio') {
    $suggestions[] = 'form_element__webform_radio';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for fieldset.
 */
function eonext_kultur_event_submissions_theme_suggestions_fieldset_alter(array &$suggestions, array $variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'eonext_kultur_event_submissions.public_form') {
    return;
  }

  $suggestions[] = 'fieldset__webform';
}

/**
 * Implements hook_preprocess_HOOK() for the public submission form.
 */
function eonext_kultur_event_submissions_preprocess_form__eonext_kultur_event_submission_public(array &$variables): void {
  $variables['attributes']['method'] = 'post';
  $variables['attributes']['enctype'] = 'multipart/form-data';
  $variables['attributes']['action'] = Url::fromRoute('eonext_kultur_event_submissions.public_form')->toString();
}

/**
 * Implements hook_preprocess_html().
 */
function eonext_kultur_event_submissions_preprocess_html(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'eonext_kultur_event_submissions.public_form') {
    return;
  }

  $variables['attributes']['class'][] = 'ek-submission-form-page';
}

/**
 * Implements hook_preprocess_page().
 */
function eonext_kultur_event_submissions_preprocess_page(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'eonext_kultur_event_submissions.public_form') {
    return;
  }

  $variables['#attached']['library'][] = 'eonext_kultur_event_submissions/submission-form';
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function eonext_kultur_event_submissions_menu_local_tasks_alter(array &$data, string $route_name): void {
  if ($route_name !== 'entity.kultur_event_submission.canonical') {
    return;
  }

  $submission = \Drupal::routeMatch()->getParameter('kultur_event_submission');
  if (!$submission instanceof EntityInterface || $submission->getEntityTypeId() !== 'kultur_event_submission') {
    return;
  }

  if (!$submission instanceof KulturEventSubmission || $submission->get('status')->value !== SubmissionConstants::STATUS_PENDING) {
    unset($data['tabs'][1]['entity.kultur_event_submission.approve_form']);
    unset($data['tabs'][1]['entity.kultur_event_submission.reject_form']);
  }
}

/**
 * Implements hook_entity_view_mode_alter().
 */
function eonext_kultur_event_submissions_entity_view_mode_alter(string &$view_mode, EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'kultur_event_submission' && $view_mode === 'default') {
    $view_mode = 'full';
  }
}

/**
 * Applies Webform-compatible wrappers so novel form templates are used.
 */
function eonext_kultur_event_submissions_apply_webform_styling(array &$element): void {
  static $skip_keys = [
    'form_build_id' => TRUE,
    'form_token' => TRUE,
    'form_id' => TRUE,
    'actions' => TRUE,
    'confirmation' => TRUE,
    'status_messages' => TRUE,
  ];

  foreach (Element::children($element) as $key) {
    if (isset($skip_keys[$key])) {
      continue;
    }

    if (isset($element[$key]['#type'])) {
      $element[$key]['#webform_element'] = TRUE;
    }

    if (is_array($element[$key])) {
      eonext_kultur_event_submissions_apply_webform_styling($element[$key]);
    }
  }
}

/**
 * Implements hook_honeypot_form_protections_alter().
 */
function eonext_kultur_event_submissions_honeypot_form_protections_alter(array &$options, array &$form): void {
  $form_id = $form['#form_id'] ?? '';
  if (in_array($form_id, eonext_kultur_event_submissions_honeypot_unprotected_form_ids(), TRUE)) {
    $options = [];
  }
}

/**
 * Form IDs that must not use Honeypot (admin moderation, not public spam targets).
 *
 * @return string[]
 *   Honeypot-unprotected form IDs.
 */
function eonext_kultur_event_submissions_honeypot_unprotected_form_ids(): array {
  return [
    'kultur_event_submission_approve_form',
    'kultur_event_submission_reject_form',
    'kultur_event_submission_delete_form',
  ];
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
function eonext_kultur_event_submissions_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'eonext_kultur_event_submissions.public_form') {
    return;
  }

  $field_name = $context['items']->getFieldDefinition()->getName() ?? '';
  if (in_array($field_name, ['description_gl', 'description_da'], TRUE)) {
    $element['#after_build'][] = 'eonext_kultur_event_submissions_text_format_hide_help_after_build';
    return;
  }

  if (in_array($field_name, ['event_start', 'event_end'], TRUE) && isset($element['value'])) {
    // One datetime-local control: Safari often drops separate date/time fields.
    $element['value']['#date_date_element'] = 'datetime-local';
    $element['value']['#date_time_element'] = 'none';
    $element['value']['#date_increment'] = 60;
    $element['value']['#value_callback'] = 'eonext_kultur_event_submissions_public_datetime_value_callback';
    $element['value']['#after_build'][] = 'eonext_kultur_event_submissions_public_datetime_local_after_build';
    $element['value']['#after_build'][] = 'eonext_kultur_event_submissions_public_datetime_label_after_build';
    $element['value']['#ek_datetime_title'] = $context['items']->getFieldDefinition()->getLabel();
    if (isset($element['#theme_wrappers'])) {
      $element['#theme_wrappers'] = array_values(array_filter(
        $element['#theme_wrappers'],
        static fn ($wrapper) => $wrapper !== 'fieldset',
      ));
    }
    return;
  }

  if ($field_name !== 'address' || !isset($element['address'])) {
    return;
  }

  $element['address']['#available_countries'] = ['GL'];
  $element['address']['#after_build'][] = 'eonext_kultur_event_submissions_public_address_labels_after_build';
  $element['address']['#after_build'][] = 'eonext_kultur_event_submissions_public_address_states_after_build';
  $element['address']['#field_overrides'] = [
    AddressField::GIVEN_NAME => FieldOverride::HIDDEN,
    AddressField::ADDITIONAL_NAME => FieldOverride::HIDDEN,
    AddressField::FAMILY_NAME => FieldOverride::HIDDEN,
    AddressField::ADDRESS_LINE2 => FieldOverride::OPTIONAL,
    AddressField::ADDRESS_LINE3 => FieldOverride::HIDDEN,
    AddressField::SORTING_CODE => FieldOverride::HIDDEN,
    AddressField::ADMINISTRATIVE_AREA => FieldOverride::HIDDEN,
  ];
}

/**
 * Reads the selected city machine name from form state or user input.
 */
function eonext_kultur_event_submissions_form_city(FormStateInterface $form_state): ?string {
  $city = $form_state->getValue('city');
  if (is_array($city)) {
    if (isset($city[0]['value']) && is_string($city[0]['value'])) {
      return $city[0]['value'];
    }
    if (isset($city['value']) && is_string($city['value'])) {
      return $city['value'];
    }
  }
  if (is_string($city) && $city !== '') {
    return $city;
  }

  $user_input = $form_state->getUserInput();
  if (isset($user_input['city']) && is_string($user_input['city']) && $user_input['city'] !== '') {
    return $user_input['city'];
  }

  return NULL;
}

/**
 * Removes hidden address sub-properties before Address module validation.
 *
 * Browsers may autofill given_name etc. even when #access is FALSE; those
 * properties must be absent, otherwise validation fails with "must be null".
 */
function eonext_kultur_event_submissions_sanitize_address_form_state(FormStateInterface $form_state): void {
  $address = $form_state->getValue('address');
  if (!is_array($address) || !isset($address[0]['address']) || !is_array($address[0]['address'])) {
    return;
  }

  $hidden = [
    'given_name',
    'additional_name',
    'family_name',
    'address_line3',
    'sorting_code',
    'administrative_area',
    'dependent_locality',
  ];
  foreach ($hidden as $key) {
    unset($address[0]['address'][$key]);
  }
  if (trim((string) ($address[0]['address']['country_code'] ?? '')) === '') {
    $address[0]['address']['country_code'] = 'GL';
  }
  $form_state->setValue('address', $address);

  $user_input = $form_state->getUserInput();
  if (isset($user_input['address'][0]['address']) && is_array($user_input['address'][0]['address'])) {
    foreach ($hidden as $key) {
      unset($user_input['address'][0]['address'][$key]);
    }
    if (trim((string) ($user_input['address'][0]['address']['country_code'] ?? '')) === '') {
      $user_input['address'][0]['address']['country_code'] = 'GL';
    }
    $form_state->setUserInput($user_input);
  }
}

/**
 * Applies Nuuk defaults to the address field value in form state.
 */
function eonext_kultur_event_submissions_normalize_address_form_state(FormStateInterface $form_state): void {
  if (eonext_kultur_event_submissions_form_city($form_state) !== SubmissionConstants::CITY_NUUK) {
    return;
  }

  $user_input = $form_state->getUserInput();
  $address = $form_state->getValue('address');
  if ((!is_array($address) || !isset($address[0]['address']))
    && isset($user_input['address'][0]['address']) && is_array($user_input['address'][0]['address'])) {
    $address = $user_input['address'];
  }
  if (!is_array($address) || !isset($address[0]['address']) || !is_array($address[0]['address'])) {
    return;
  }

  $address[0]['address']['country_code'] = $address[0]['address']['country_code'] ?: 'GL';
  $address[0]['address']['locality'] = 'Nuuk';
  if (trim((string) ($address[0]['address']['postal_code'] ?? '')) === '') {
    $address[0]['address']['postal_code'] = '3900';
  }
  $address[0]['address']['address_line2'] = '';

  $form_state->setValue('address', $address);

  if (isset($user_input['address'][0]['address']) && is_array($user_input['address'][0]['address'])) {
    $user_input['address'][0]['address']['country_code'] = $address[0]['address']['country_code'];
    $user_input['address'][0]['address']['locality'] = 'Nuuk';
    $user_input['address'][0]['address']['postal_code'] = $address[0]['address']['postal_code'];
    $user_input['address'][0]['address']['address_line2'] = '';
    $form_state->setUserInput($user_input);
  }
}

/**
 * Element validate: normalize Nuuk address before Address module validation.
 */
function eonext_kultur_event_submissions_public_address_element_validate(array &$element, FormStateInterface $form_state, array &$complete_form): void {
  $user_input = $form_state->getUserInput();
  if (isset($user_input['address']) && is_array($user_input['address'])) {
    $form_state->setValue('address', $user_input['address']);
  }

  eonext_kultur_event_submissions_sanitize_address_form_state($form_state);
  eonext_kultur_event_submissions_normalize_address_form_state($form_state);

  if (eonext_kultur_event_submissions_form_city($form_state) !== SubmissionConstants::CITY_NUUK) {
    return;
  }

  $address = $form_state->getValue('address');
  if (!is_array($address) || !isset($address[0]['address']) || !is_array($address[0]['address'])) {
    return;
  }

  foreach ($address[0]['address'] as $key => $value) {
    if (!isset($element[$key])) {
      continue;
    }
    $element[$key]['#value'] = $value;
    if (isset($element[$key]['#default_value'])) {
      $element[$key]['#default_value'] = $value;
    }
  }
}

/**
 * Implements hook_entity_presave().
 */
function eonext_kultur_event_submissions_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof KulturEventSubmission || $entity->get('address')->isEmpty()) {
    return;
  }

  $values = $entity->get('address')->first()->getValue();
  $values['country_code'] = $values['country_code'] ?: 'GL';

  if ($entity->get('city')->value === SubmissionConstants::CITY_NUUK) {
    $values['locality'] = 'Nuuk';
    if (trim((string) ($values['postal_code'] ?? '')) === '') {
      $values['postal_code'] = '3900';
    }
  }

  $entity->set('address', [$values]);
}

/**
 * Implements hook_mail().
 */
function eonext_kultur_event_submissions_mail($key, &$message, $params): void {
  $message['subject'] = $params['subject'] ?? '';
  $message['body'][] = $params['body'] ?? '';

  $site_mail = (string) (\Drupal::config('system.site')->get('mail') ?? '');
  $site_name = (string) (\Drupal::config('system.site')->get('name') ?? '');
  if ($site_mail !== '') {
    $message['headers']['Reply-To'] = $site_mail;
    $message['headers']['From'] = $site_name !== ''
      ? sprintf('%s <%s>', $site_name, $site_mail)
      : $site_mail;
  }
}

/**
 * After-build callback: translated labels on public address subfields.
 */
function eonext_kultur_event_submissions_public_address_states_after_build(array $element, FormStateInterface $form_state): array {
  $other_city_selector = [
    ':input[name="city"]' => ['value' => SubmissionConstants::CITY_OTHER],
  ];
  $is_nuuk = eonext_kultur_event_submissions_form_city($form_state) === SubmissionConstants::CITY_NUUK;

  foreach (['postal_code', 'locality', 'address_line2'] as $field_name) {
    if (!isset($element[$field_name])) {
      continue;
    }
    if ($field_name === 'address_line2') {
      $element[$field_name]['#states'] = [
        'visible' => $other_city_selector,
      ];
      $element[$field_name]['#required'] = FALSE;
      if ($is_nuuk) {
        $element[$field_name]['#access'] = FALSE;
      }
      continue;
    }
    $element[$field_name]['#states'] = [
      'required' => $other_city_selector,
      'visible' => $other_city_selector,
    ];
    if ($is_nuuk) {
      $element[$field_name]['#required'] = FALSE;
      $element[$field_name]['#access'] = FALSE;
    }
  }

  if ($is_nuuk) {
    eonext_kultur_event_submissions_normalize_address_form_state($form_state);
    $element['#field_overrides'][AddressField::POSTAL_CODE] = FieldOverride::OPTIONAL;
    $element['#field_overrides'][AddressField::LOCALITY] = FieldOverride::OPTIONAL;
    $element['#parsed_field_overrides'] = new FieldOverrides($element['#field_overrides']);
  }

  return $element;
}

/**
 * After-build callback: translated labels on public address subfields.
 */
function eonext_kultur_event_submissions_public_address_labels_after_build(array $element, FormStateInterface $form_state): array {
  $translation_options = ['context' => 'eonext_kultur_event_submissions'];
  $labels = [
    'organization' => t('Organization / company', [], $translation_options),
    'address_line1' => t('Address', [], $translation_options),
    'address_line2' => t('Residence', [], $translation_options),
    'postal_code' => t('Postal code', [], $translation_options),
    'locality' => t('City', [], $translation_options),
  ];
  foreach ($labels as $key => $title) {
    if (isset($element[$key])) {
      $element[$key]['#title'] = $title;
    }
  }

  if (isset($element['country_code'])) {
    $element['country_code']['#access'] = FALSE;
  }

  return $element;
}

/**
 * After-build callback: use field label instead of core "Date" on datetime-local.
 */
function eonext_kultur_event_submissions_public_datetime_label_after_build(array $element, FormStateInterface $form_state): array {
  if (($element['#date_date_element'] ?? '') !== 'datetime-local' || !isset($element['date'])) {
    return $element;
  }
  if (isset($element['#ek_datetime_title'])) {
    $element['date']['#title'] = $element['#ek_datetime_title'];
    $element['date']['#title_display'] = 'before';
  }

  return $element;
}

/**
 * Value callback for public event date/time fields (Safari-friendly parsing).
 */
function eonext_kultur_event_submissions_public_datetime_value_callback(array &$element, $input, FormStateInterface $form_state) {
  if ($input !== FALSE && is_array($input) && ($element['#date_date_element'] ?? '') === 'datetime-local') {
    $raw = trim((string) ($input['date'] ?? ''));
    if ($raw === '') {
      return [
        'date' => '',
        'time' => '',
        'object' => NULL,
      ];
    }

    $timezone = $element['#date_timezone'] ?? date_default_timezone_get();
    foreach (['Y-m-d\TH:i', 'Y-m-d\TH:i:s'] as $format) {
      $date = DrupalDateTime::createFromFormat($format, $raw, $timezone);
      if ($date instanceof DrupalDateTime && !$date->hasErrors()) {
        return [
          'date' => $raw,
          'time' => '',
          'object' => $date,
        ];
      }
    }

    return [
      'date' => $raw,
      'time' => '',
      'object' => NULL,
    ];
  }

  return Datetime::valueCallback($element, $input, $form_state);
}

/**
 * Formats default values for HTML5 datetime-local inputs.
 */
function eonext_kultur_event_submissions_public_datetime_local_after_build(array $element, FormStateInterface $form_state): array {
  if (($element['#date_date_element'] ?? '') !== 'datetime-local' || !isset($element['date'])) {
    return $element;
  }

  $date = $element['#value']['object'] ?? NULL;
  if ($date instanceof DrupalDateTime && !$date->hasErrors()) {
    $formatted = $date->format('Y-m-d\TH:i');
    $element['date']['#value'] = $formatted;
    $element['date']['#default_value'] = $formatted;
  }

  return $element;
}

/**
 * After-build callback: hide core "About text formats" on public description fields.
 */
function eonext_kultur_event_submissions_text_format_hide_help_after_build(array $element, FormStateInterface $form_state): array {
  if (isset($element['format']['help'])) {
    $element['format']['help']['#access'] = FALSE;
  }
  return $element;
}

/**
 * After-build callback for the public image widget.
 *
 * Disables AJAX upload so files are saved when the form is submitted. This
 * avoids anonymous upload tokens being lost between AJAX upload and submit.
 */
function eonext_kultur_event_submissions_image_widget_after_build(array $element, FormStateInterface $form_state): array {
  if (isset($element['upload_button'])) {
    $element['upload_button']['#access'] = FALSE;
    unset($element['upload_button']['#ajax']);
  }

  if (isset($element['alt'])) {
    $element['alt']['#access'] = FALSE;
    $element['alt']['#required'] = FALSE;
  }

  return $element;
}

/**
 * After-build callback for the public submission form.
 */
function eonext_kultur_event_submissions_public_form_after_build(array $form, FormStateInterface $form_state): array {
  if (!$form_state->get('submission_success')) {
    eonext_kultur_event_submissions_apply_webform_styling($form);
  }

  return $form;
}
