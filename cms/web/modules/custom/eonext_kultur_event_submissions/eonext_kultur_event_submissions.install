<?php

/**
 * @file
 * Install, update and uninstall functions for eonext_kultur_event_submissions.
 */

use Drupal\eonext_kultur_event_submissions\Plugin\LanguageNegotiation\LanguageNegotiationPublicForm;
use Drupal\language\Entity\ConfigurableLanguage;
use Drupal\user\Entity\Role;

/**
 * Grants module permissions to relevant roles.
 */
function _eonext_kultur_event_submissions_grant_permissions(): void {
  $adminPermission = 'administer kultur event submissions';
  $submitPermission = 'submit kultur event';

  foreach (['administrator', 'editor', 'local_administrator'] as $role_id) {
    $role = Role::load($role_id);
    if ($role === NULL) {
      continue;
    }

    if (!$role->hasPermission($adminPermission)) {
      $role->grantPermission($adminPermission);
    }
    if (!$role->hasPermission($submitPermission)) {
      $role->grantPermission($submitPermission);
    }
    $role->save();
  }

  $anonymous = Role::load(Role::ANONYMOUS_ID);
  if ($anonymous !== NULL && !$anonymous->hasPermission($submitPermission)) {
    $anonymous->grantPermission($submitPermission);
    $anonymous->save();
  }

  $authenticated = Role::load(Role::AUTHENTICATED_ID);
  if ($authenticated !== NULL && !$authenticated->hasPermission($submitPermission)) {
    $authenticated->grantPermission($submitPermission);
    $authenticated->save();
  }
}

/**
 * Ensures Greenlandic is available and event series translation is enabled.
 */
function _eonext_kultur_event_submissions_ensure_languages(): void {
  if (ConfigurableLanguage::load('kl') === NULL) {
    ConfigurableLanguage::createFromLangcode('kl')->save();
  }

  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return;
  }

  $manager = \Drupal::service('content_translation.manager');
  if (!$manager->isEnabled('eventseries', 'default')) {
    $manager->setEnabled('eventseries', 'default', TRUE);
  }
}

/**
 * Implements hook_install().
 */
function eonext_kultur_event_submissions_install(): void {
  _eonext_kultur_event_submissions_grant_permissions();
  _eonext_kultur_event_submissions_ensure_languages();
}

/**
 * Grant submit permissions that may be missing after manual module enable.
 */
function eonext_kultur_event_submissions_update_9001(): void {
  _eonext_kultur_event_submissions_grant_permissions();
}

/**
 * Installs entity storage if the module was enabled without hook_install().
 */
function eonext_kultur_event_submissions_update_9002(): void {
  $entity_type_id = 'kultur_event_submission';
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);

  if ($update_manager->getEntityType($entity_type_id) === NULL) {
    $update_manager->installEntityType($entity_type);
  }
}

/**
 * Ensures Greenlandic is configured and repairs orphaned event series fields.
 */
function eonext_kultur_event_submissions_update_9003(): void {
  _eonext_kultur_event_submissions_ensure_languages();
  _eonext_kultur_event_submissions_repair_eventseries_field_langcodes();
}

/**
 * Enables Field UI management for Kulturnat event submissions.
 */
function eonext_kultur_event_submissions_update_9004(): void {
  _eonext_kultur_event_submissions_install_field_ui_displays();

  \Drupal::entityTypeManager()->clearCachedDefinitions();
}

/**
 * Installs missing public/full form and view modes for Field UI.
 */
function eonext_kultur_event_submissions_update_9005(): void {
  _eonext_kultur_event_submissions_install_field_ui_displays();
  \Drupal::entityTypeManager()->clearCachedDefinitions();
}

/**
 * Enables English language negotiation on the public submission form.
 */
function eonext_kultur_event_submissions_update_9007(): void {
  _eonext_kultur_event_submissions_enable_public_form_language_negotiation();
}

/**
 * Fixes missing preview image style on submission image widgets.
 */
function eonext_kultur_event_submissions_update_9008(): void {
  $config_names = [
    'core.entity_form_display.kultur_event_submission.kultur_event_submission.public',
    'core.entity_form_display.kultur_event_submission.kultur_event_submission.default',
  ];

  foreach ($config_names as $config_name) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    $content = $config->get('content');
    if (!is_array($content) || !isset($content['image']['settings']['preview_image_style'])) {
      continue;
    }

    if ($content['image']['settings']['preview_image_style'] === 'thumbnail') {
      $content['image']['settings']['preview_image_style'] = 'small_preview';
      $config->set('content', $content)->save(TRUE);
    }
  }

  _eonext_kultur_event_submissions_update_image_field_settings();
}

/**
 * Updates image field settings for optional alt/title on public uploads.
 */
function eonext_kultur_event_submissions_update_9009(): void {
  _eonext_kultur_event_submissions_update_image_field_settings();
}

/**
 * Hides unused address subfields from submission validation.
 */
function eonext_kultur_event_submissions_update_9010(): void {
  _eonext_kultur_event_submissions_update_address_field_settings();
}

/**
 * Syncs address field storage settings with the module definition.
 */
function _eonext_kultur_event_submissions_update_address_field_settings(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('kultur_event_submission.address');
  if ($storage === NULL) {
    return;
  }

  $storage->set('settings', [
    'field_overrides' => [
      'givenName' => ['override' => 'hidden'],
      'additionalName' => ['override' => 'hidden'],
      'familyName' => ['override' => 'hidden'],
      'organization' => ['override' => 'hidden'],
      'addressLine2' => ['override' => 'hidden'],
      'addressLine3' => ['override' => 'hidden'],
      'sortingCode' => ['override' => 'hidden'],
      'dependentLocality' => ['override' => 'hidden'],
      'administrativeArea' => ['override' => 'hidden'],
    ],
  ])->save();
}

/**
 * Syncs image field storage settings with the module definition.
 */
function _eonext_kultur_event_submissions_update_image_field_settings(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('kultur_event_submission.image');
  if ($storage === NULL) {
    return;
  }

  $settings = $storage->getSettings();
  $settings['alt_field'] = 0;
  $settings['alt_field_required'] = 0;
  $settings['title_field'] = 0;
  $settings['title_field_required'] = 0;
  $storage->set('settings', $settings)->save();
}

/**
 * Fixes invalid address widget wrapper_type in form displays.
 */
function eonext_kultur_event_submissions_update_9006(): void {
  $config_names = [
    'core.entity_form_display.kultur_event_submission.kultur_event_submission.public',
    'core.entity_form_display.kultur_event_submission.kultur_event_submission.default',
  ];

  foreach ($config_names as $config_name) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    $content = $config->get('content');
    if (!is_array($content) || !isset($content['address']['settings']['wrapper_type'])) {
      continue;
    }

    if ($content['address']['settings']['wrapper_type'] === 'div') {
      $content['address']['settings']['wrapper_type'] = 'container';
      $config->set('content', $content)->save(TRUE);
    }
  }
}

/**
 * Enables the public-form language negotiation method.
 */
function _eonext_kultur_event_submissions_enable_public_form_language_negotiation(): void {
  $method_id = LanguageNegotiationPublicForm::METHOD_ID;
  $config = \Drupal::configFactory()->getEditable('language.types');

  foreach (['language_interface', 'language_content'] as $type) {
    $enabled = $config->get("negotiation.$type.enabled") ?? [];
    if (isset($enabled[$method_id])) {
      continue;
    }

    $enabled[$method_id] = -20;
    uasort($enabled, static fn ($a, $b): int => $a <=> $b);
    $config->set("negotiation.$type.enabled", $enabled);

    $weights = $config->get("negotiation.$type.method_weights") ?? [];
    $weights[$method_id] = -20;
    $config->set("negotiation.$type.method_weights", $weights);
  }

  $config->save(TRUE);
}

/**
 * Installs default form and view display configuration for Field UI.
 */
function _eonext_kultur_event_submissions_install_field_ui_displays(): void {
  $config_names = [
    'core.entity_form_mode.kultur_event_submission.public',
    'core.entity_view_mode.kultur_event_submission.full',
    'core.entity_form_display.kultur_event_submission.kultur_event_submission.public',
    'core.entity_form_display.kultur_event_submission.kultur_event_submission.default',
    'core.entity_view_display.kultur_event_submission.kultur_event_submission.full',
  ];

  $module_path = \Drupal::service('extension.list.module')->getPath('eonext_kultur_event_submissions');
  $source_storage = new \Drupal\Core\Config\FileStorage($module_path . '/config/install');
  $config_factory = \Drupal::configFactory();

  foreach ($config_names as $config_name) {
    if (!$config_factory->get($config_name)->isNew()) {
      continue;
    }

    $data = $source_storage->read($config_name);
    if ($data !== FALSE) {
      $config_factory->getEditable($config_name)->setData($data)->save(TRUE);
    }
  }
}

/**
 * Moves field values to the entity default langcode when they were stored as en.
 *
 * This happens when event series were created with langcode kl before kl existed.
 *
 * @return int
 *   The number of field rows updated.
 */
function _eonext_kultur_event_submissions_repair_eventseries_field_langcodes(): int {
  $connection = \Drupal::database();
  $schema = $connection->schema();
  $updated = 0;

  $series_ids = $connection->select('eventseries_field_data', 'es')
    ->fields('es', ['id'])
    ->condition('default_langcode', 1)
    ->condition('langcode', 'kl')
    ->execute()
    ->fetchCol();

  if ($series_ids === []) {
    return 0;
  }

  $field_tables = [
    'eventseries__custom_date',
    'eventseries__field_teaser_image',
    'eventseries__field_event_image',
    'eventseries__field_event_paragraphs',
    'eventseries__field_teaser_text',
    'eventseries__field_event_partners',
    'eventseries__field_event_address',
    'eventseries__field_event_state',
    'eventseries__field_description',
    'eventseries__field_event_place',
  ];

  foreach ($field_tables as $table) {
    if (!$schema->tableExists($table) || !$schema->fieldExists($table, 'langcode')) {
      continue;
    }

    $updated += (int) $connection->update($table)
      ->fields(['langcode' => 'kl'])
      ->condition('entity_id', $series_ids, 'IN')
      ->condition('langcode', 'en')
      ->execute();
  }

  if ($updated > 0) {
    \Drupal::entityTypeManager()->getStorage('eventseries')->resetCache($series_ids);
  }

  return $updated;
}
