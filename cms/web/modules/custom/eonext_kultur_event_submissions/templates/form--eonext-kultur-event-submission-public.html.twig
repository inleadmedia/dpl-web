{#
/**
 * @file
 * Kulturnat public event submission form.
 */
#}
<form{{ attributes.addClass('ek-submission-form', 'dpl-form').setAttribute('method', 'post').setAttribute('enctype', 'multipart/form-data') }}>
  {{ include('@eonext_kultur/components/ek-page-title-band.html.twig', {
    title: 'Register event'|t({}, {'context': 'eonext_kultur_event_submissions'}),
    intro: 'Fill in the details below to submit your event for Kulturnat. All fields marked with * are required.'|t({}, {'context': 'eonext_kultur_event_submissions'}),
  }, with_context = false) }}

  <div class="ek-submission-form__inner">
    {{ element.form_build_id }}
    {{ element.form_token }}
    {{ element.form_id }}

    {% if element.confirmation %}
      {{ element.confirmation }}
    {% endif %}

    {% if element.status_messages %}
      <div class="ek-submission-form__messages">
        {{ element.status_messages }}
      </div>
    {% endif %}

    {% set excluded_keys = ['form_build_id', 'form_token', 'form_id', 'confirmation', 'status_messages', 'actions'] %}
    {% for key, child in element|without(excluded_keys) %}
      {% if key|first != '#' %}
        {{ child }}
      {% endif %}
    {% endfor %}

    {% if element.actions %}
      <div class="ek-submission-form__actions">
        {{ element.actions }}
      </div>
    {% endif %}
  </div>
</form>
