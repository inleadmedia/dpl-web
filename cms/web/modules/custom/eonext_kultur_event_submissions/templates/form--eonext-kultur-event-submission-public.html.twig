{#
/**
 * @file
 * Kulturnat public event submission form.
 */
#}
<form{{ attributes.addClass('ek-submission-form', 'dpl-form').setAttribute('method', 'post').setAttribute('enctype', 'multipart/form-data') }}>
  <div class="ek-submission-form__hero">
    <div class="ek-submission-form__hero-inner">
      <h1 class="ek-submission-form__title">{{ 'Tilmeld arrangement'|t({}, {'context': 'eonext_kultur_event_submissions'}) }}</h1>
      <p class="ek-submission-form__intro">{{ 'Fill in the details below to submit your event for Kulturnat. All fields marked with * are required.'|t({}, {'context': 'eonext_kultur_event_submissions'}) }}</p>
    </div>
  </div>

  <div class="ek-submission-form__inner">
    {{ element.form_build_id }}
    {{ element.form_token }}
    {{ element.form_id }}

    {% if element.confirmation %}
      {{ element.confirmation }}
    {% endif %}

    {% if element.status_messages %}
      <div class="ek-submission-form__messages">
        {{ element.status_messages }}
      </div>
    {% endif %}

    {{ element.section_city }}
    {{ element.section_organisation }}
    {{ element.section_location }}
    {{ element.section_schedule }}
    {{ element.section_contact }}
    {{ element.section_image }}
    {{ element.section_descriptions }}

    {% if element.actions %}
      {{ element.actions }}
    {% endif %}
  </div>
</form>
