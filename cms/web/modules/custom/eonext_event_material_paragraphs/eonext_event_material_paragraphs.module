<?php

/**
 * @file
 * EO Next Event and Material Paragraphs module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\drupal_typed\DrupalTyped;
use Drupal\eonext_event_material_paragraphs\Hook\FormHooks;
use Drupal\eonext_event_material_paragraphs\Hook\PreprocessHooks;

/**
 * Implements hook_theme_registry_alter().
 *
 * Declares the "show_all_link" variable on the dpl_related_content theme so the
 * filtered event list can expose the Explore link without editing the theme.
 */
function eonext_event_material_paragraphs_theme_registry_alter(array &$theme_registry): void {
  if (isset($theme_registry['dpl_related_content'])) {
    $theme_registry['dpl_related_content']['variables']['show_all_link'] = NULL;
  }
}

/*
 * The following LegacyHooks can be removed when upgrading to Drupal 11.2,
 * together with the hook class service definitions.
 */

/**
 * Implements hook_form_paragraph_form_alter().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_form_paragraph_form_alter(array &$form, FormStateInterface $form_state): void {
  DrupalTyped::service(FormHooks::class)->paragraphFormAlter($form, $form_state);
}

/**
 * Implements hook_field_widget_single_element_paragraphs_form_alter().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_field_widget_single_element_paragraphs_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  DrupalTyped::service(FormHooks::class)->paragraphsWidgetAlter($element, $form_state, $context);
}

/**
 * Implements hook_preprocess_paragraph__material_grid_automatic().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_preprocess_paragraph__material_grid_automatic(array &$variables): void {
  DrupalTyped::service(PreprocessHooks::class)->materialGridAutomatic($variables);
}

/**
 * Implements hook_preprocess_paragraph__material_grid_manual().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_preprocess_paragraph__material_grid_manual(array &$variables): void {
  DrupalTyped::service(PreprocessHooks::class)->materialGridManual($variables);
}

/**
 * Implements hook_preprocess_paragraph__filtered_event_list().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_preprocess_paragraph__filtered_event_list(array &$variables): void {
  DrupalTyped::service(PreprocessHooks::class)->filteredEventList($variables);
}

/**
 * Implements hook_preprocess_paragraph__manual_event_list().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_preprocess_paragraph__manual_event_list(array &$variables): void {
  DrupalTyped::service(PreprocessHooks::class)->manualEventList($variables);
}

/**
 * Implements hook_preprocess_dpl_related_content().
 */
#[LegacyHook]
function eonext_event_material_paragraphs_preprocess_dpl_related_content(array &$variables): void {
  DrupalTyped::service(PreprocessHooks::class)->dplRelatedContent($variables);
}
